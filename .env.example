# Copy to .env for local runs (never commit .env). GitHub Actions uses repository secrets instead.
# ==============================================================================
# Model Providers & Writers
# ==============================================================================
# Choose the active provider to write stories and run the control room:
# Options: 'gemini', 'claude', 'codex' (ChatGPT subscription), 'openai' (separate API billing), 'qwen', 'openrouter'
# When one provider is active, all other configured credentials remain safely idle.
KHAZENDAR_PROVIDER=gemini

# Optional: Override the model for the active provider.
# Defaults:
#   gemini:     gemini-3.8-flash (or gemini-2.5-pro, gemini-2.5-flash)
#   claude:     claude-opus-5-5 (Claude Opus 5.5)
#   openai:     gpt-6.1-sol
#   qwen:       qwen-max (or qwen-plus, qwen-vl-max)
#   openrouter: google/gemini-3.8-flash (or any OpenRouter model)
# KHAZENDAR_MODEL=gemini-3.8-flash

# 1. Google Gemini (Active Provider)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Anthropic Claude (Idle / Standby)
# Uses Claude Code CLI OAuth token (`claude setup-token`) or direct Anthropic API key.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# 3. OpenAI / ChatGPT
# Get a key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# KHAZENDAR_OPENAI_MODEL=gpt-6.1-sol

# ChatGPT subscription instead of API billing (cloud connections are configured in Control Room):
# Sign in with ChatGPT using `codex login`; no key or token is copied into .env.
# KHAZENDAR_PROVIDER=codex
# KHAZENDAR_CODEX_MODEL=gpt-6.1-sol
# KHAZENDAR_CODEX_HOME=   # set by Control Room when choosing an isolated account
# Cloud sign-in is managed by Control Room; never paste its credentials into this file or commit them.

# 4. Alibaba Qwen (DashScope)
# Get a key from https://dashscope.console.aliyun.com/
# DASHSCOPE_API_KEY=

# 5. OpenRouter
# Get a key from https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# ==============================================================================
# Photo Libraries (Optional)
# ==============================================================================
# In addition to Wikimedia Commons and Openverse (which need no key),
# free keys can be obtained from:
#   https://www.pexels.com/api/
#   https://unsplash.com/developers
#   https://pixabay.com/api/docs/
# PEXELS_API_KEY=
# UNSPLASH_ACCESS_KEY=
# PIXABAY_API_KEY=
