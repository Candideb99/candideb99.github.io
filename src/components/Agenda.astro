---
/**
 * الأجندة: the coming decisions and releases as a compact ruled list, the day in the furniture
 * face beside the event in Naskh. The front's module shows the next few and links to the
 * calendar page, where the times and institutions are printed in full.
 */
import { upcoming, relativeDay, localTime, calendar } from "@lib/calendar";
import { timeAgo } from "@lib/format";

interface Props {
  limit?: number;
}
const { limit = 5 } = Astro.props;
const events = upcoming(limit);
---

{events.length > 0 && (
  <section class="module agenda" aria-labelledby="agenda-head">
    <h2 id="agenda-head" class="module__head"><a href="/calendar/">الأجندة الاقتصادية</a></h2>
    <ul class="agenda__list">
      {events.map((e) => {
        const at = localTime(e);
        return (
          <li class="agenda__item" title={`${e.org}${at ? ` · ${at} بتوقيت الرياض` : ""}${e.note ? ` · ${e.note}` : ""}`}>
            <span class="agenda__day ui">{relativeDay(e.date)}</span>
            <a class="agenda__title" href="/calendar/">{e.short ?? e.title}</a>
          </li>
        );
      })}
    </ul>
    <p class="agenda__foot ui"><a href="/calendar/">الأجندة كاملة</a>{calendar.updatedAt && <span> · من جداول المؤسسات نفسها، حُدّثت <time datetime={calendar.updatedAt} data-relative>{timeAgo(calendar.updatedAt)}</time></span>}</p>
  </section>
)}

<style>
  .agenda__list { display: grid; }
  .agenda__item { display: grid; grid-template-columns: 6.2rem minmax(0, 1fr); column-gap: 0.6rem; align-items: baseline; padding-block: 0.42rem; border-top: 1px solid var(--rule); }
  .agenda__item:first-child { border-top: 0; padding-top: 0; }
  .agenda__day { font-size: 0.76rem; font-weight: 700; color: var(--green); line-height: 1.5; }
  .agenda__title { font-family: var(--font-body); font-weight: 700; font-size: 0.95rem; line-height: 1.5; text-decoration: none; color: var(--ink); }
  .agenda__title:hover { color: var(--green); }
  .agenda__foot { margin-top: 0.5rem; font-size: 0.78rem; line-height: 1.55; color: var(--ink-3); }
  .agenda__foot a { font-weight: 700; color: var(--ink-2); text-decoration: none; }
  .agenda__foot a:hover { color: var(--green); text-decoration: underline; }
  .agenda__foot time { color: inherit; }
</style>
