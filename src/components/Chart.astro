---
/**
 * Arabic data chart from source-grounded figures, in one of three forms (restyled 2026-10-20, the owner: "fix the
 * charts style"):
 *
 * - categories compared (a bar chart whose categories are not periods): HORIZONTAL BARS in HTML, each category's name
 *   whole above its bar and the value at the bar's end, the way the FT and The Economist compare categories. 52 of the
 *   paper's 58 bar charts were such comparisons drawn as columns: their names wrapped under 200px-wide solid blocks
 *   and crowded each other in the front's 280px column («أبوظبي الوطنية للفنادق» into «بنك الفجيرة الوطني»);
 * - periods (years, quarters, months) as columns, capped at about 36px wide so they never become blocks, the value on
 *   each cap and no scale or grid when every column is labelled;
 * - lines for series over time, with their scale.
 *
 * One axis, thin marks, a legend for two or more series, the unit under the title, native tooltips on every mark and a
 * table view of the same data. The series colours (`--chart-1..3`) pass the dataviz validator in both themes.
 */
import { isolateNumbers } from "@lib/bidi";

interface Series {
  name: string;
  values: number[];
}
interface ChartSpec {
  type: "bar" | "line";
  title?: string | null;
  unit?: string;
  source?: string;
  categories: string[];
  series: Series[];
}
interface Props {
  chart: ChartSpec;
  id?: string;
  /** A front-page module: smaller canvas, no data table, the title linking to the story. */
  compact?: boolean;
  /** A compact chart in the front's side column, drawn about 280px wide: its text is drawn larger. */
  narrow?: boolean;
  href?: string;
}
const { chart, id = "chart", compact: compactProp = false, narrow = false, href } = Astro.props;
const compact = compactProp || narrow;

const n = chart.categories.length;
const all = chart.series.flatMap((s) => s.values);
const unit = chart.unit ?? "";
const colors = ["var(--chart-1)", "var(--chart-2)", "var(--chart-3)"];

function fmt(v: number): string {
  const abs = Math.abs(v);
  const decimals = abs >= 100 ? 0 : abs >= 10 ? 1 : 2;
  // A true minus, as the rest of the site prints a fall («−0.1%» in «الأرقام» beside the chart), never a hyphen.
  return v.toLocaleString("en-US", { maximumFractionDigits: decimals }).replace(/^-/, "−");
}
const label = (v: number) => `${fmt(v)}${unit === "%" ? "%" : unit ? ` ${unit}` : ""}`;
/** A value printed on its mark: the number, with the sign of a percentage; any other unit is under the title. */
const markValue = (v: number) => `${fmt(v)}${unit === "%" ? "%" : ""}`;

// A period is a year, a quarter, a half or a month: those run as columns, in time order; everything else is a
// comparison of categories and runs as horizontal bars.
const PERIOD = /\d{4}|الربع|النصف|يناير|فبراير|مارس|أبريل|مايو|يونيو|يوليو|أغسطس|سبتمبر|أكتوبر|نوفمبر|ديسمبر|الأسبوع|الشهر/;
const horizontal = chart.type === "bar" && !chart.categories.every((c) => PERIOD.test(c));

// ----- Horizontal bars: positions in % of the plotting width, from the line's start (the right) -----
const lo = Math.min(0, ...all);
const hi = Math.max(0, ...all);
const range = hi - lo || 1;
const pos = (v: number) => ((v - lo) / range) * 100;
const zero = pos(0);
const hasNegative = lo < 0;

// ----- Columns and lines (SVG) -----
/** The chart's numbers are drawn in the drawing's own units, so they shrink with the drawing; each kind is sized to
 *  come out near the site's small furniture size, about 12.5px, where it is shown (2026-09-27): a full chart (720 units
 *  in a 640px column) at 14.5 units, 24 on a phone (a 358px column); a compact one (400 units) at 14; the side
 *  column's (about 280px) at 19. The categories are set as text under the drawing (the list after the svg). */
const TEXT = narrow ? 19 : compact ? 14 : 24;
const W = compact ? 400 : 720;
const showValueLabels = n <= 8 && chart.series.length === 1;
// Columns with a value on every cap need no scale: the scale and its grid are left out, the baseline stays.
const bareColumns = chart.type === "bar" && showValueLabels;
const below = chart.type === "bar" && showValueLabels && all.some((v) => v < 0) ? Math.round(TEXT * 1.3) : 0;
const H = (compact ? 190 : 300) + below;
const PAD = bareColumns
  ? { top: 28, right: 12, bottom: 8, left: 12 }
  : narrow ? { top: 22, right: 16, bottom: 8, left: 66 } : compact ? { top: 22, right: 16, bottom: 8, left: 56 } : { top: 28, right: 24, bottom: 10, left: 76 };
PAD.bottom += below;
const plotW = W - PAD.left - PAD.right;
const slot = plotW / n;
const x = (i: number) => PAD.left + slot * i;
const plotH = H - PAD.top - PAD.bottom;

// Bars stand on zero; a line follows its own range: Brent between 97 and 108 dollars on a scale from zero was drawn
// as a flat line (2026-09-27).
const bars = chart.type === "bar";
const rawMin = bars ? Math.min(0, ...all) : Math.min(...all);
const rawMax = bars ? Math.max(0, ...all) : Math.max(...all);
const span = rawMax - rawMin || Math.abs(rawMax) * 0.1 || 1;
const niceStep = (() => {
  const rough = span / 4;
  const mag = 10 ** Math.floor(Math.log10(rough));
  const norm = rough / mag;
  const step = norm <= 1 ? 1 : norm <= 2 ? 2 : norm <= 2.5 ? 2.5 : norm <= 5 ? 5 : 10;
  return step * mag;
})();
const yMin = Math.floor(rawMin / niceStep) * niceStep;
const yMax = Math.ceil(rawMax / niceStep) * niceStep || niceStep;
const ticks: number[] = [];
for (let v = yMin; v <= yMax + 1e-9; v += niceStep) ticks.push(Number(v.toFixed(6)));
const y = (v: number) => PAD.top + plotH - ((v - yMin) / (yMax - yMin)) * plotH;
const zeroY = y(0);

// A column is at most about 36px wide (40 units of the 720 a story's chart is drawn in; 46 of the side column's 400),
// with the slot's rest left as air: at 72% of the slot three columns stood 200px wide each.
const CAP = chart.series.length === 1 ? (narrow ? 46 : compact ? 40 : 40) : narrow ? 30 : 26;
const barGap = 2;
const barW = Math.max(6, Math.min(CAP, (slot * 0.62 - barGap * (chart.series.length - 1)) / chart.series.length));
const groupW = barW * chart.series.length + barGap * (chart.series.length - 1);
const lineEndLabel = chart.series.length <= 3;
const points = (s: Series) => s.values.map((v, i) => [x(i) + slot / 2, y(v)] as const);
---

<figure id={id} class={`chart${compact ? " chart--compact" : ""}${narrow ? " chart--narrow" : ""}${horizontal ? " chart--hbars" : ""}`} role="group" aria-labelledby={`${id}-title`}>
  <figcaption class="chart__head">
    {chart.title && (
      <h3 id={`${id}-title`} class="chart__title">
        {href ? <a href={href} set:html={isolateNumbers(chart.title)} /> : <Fragment set:html={isolateNumbers(chart.title)} />}
      </h3>
    )}
    {unit && <p class="chart__unit ui">الوحدة: <bdi>{unit}</bdi></p>}
  </figcaption>

  {chart.series.length > 1 && (
    <ul class="chart__legend ui" aria-label="سلاسل البيانات">
      {chart.series.map((s, si) => (
        <li><span class="chart__swatch" style={`background:${colors[si]}`} aria-hidden="true"></span>{s.name}</li>
      ))}
    </ul>
  )}

  {horizontal ? (
    <div class:list={["hbars", { "hbars--negative": hasNegative, "hbars--multi": chart.series.length > 1 }]} role="img" aria-label={chart.title ?? "رسم بياني"}>
      {chart.categories.map((c, i) => (
        <div class="hbars__row">
          <p class="hbars__label" set:html={isolateNumbers(c)} />
          <div class="hbars__plot" style={hasNegative ? `--zero:${zero.toFixed(2)}%` : undefined}>
            {chart.series.map((s, si) => {
              const v = s.values[i];
              const start = Math.min(pos(v), zero);
              const width = Math.abs(pos(v) - zero);
              return (
                <div class="hbars__slot" title={`${c} — ${s.name}: ${label(v)}`}>
                  {v !== 0 && <span class={`hbars__bar ${v < 0 ? "is-neg" : "is-pos"}`} style={`inset-inline-start:${start.toFixed(2)}%;width:${Math.max(width, 0.6).toFixed(2)}%;background:${colors[si]}`}></span>}
                  <span class="hbars__value" style={v < 0 ? `inset-inline-end:${(100 - start).toFixed(2)}%` : `inset-inline-start:${(start + width).toFixed(2)}%`}><bdi dir="ltr">{markValue(v)}</bdi></span>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  ) : (
    <>
      <svg class="chart__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={chart.title ?? "رسم بياني"} direction="ltr">
        <g class="chart__grid">
          {ticks.map((t) =>
            bareColumns ? (
              t === 0 && <line x1={PAD.left} x2={W - PAD.right} y1={y(t)} y2={y(t)} class="chart__baseline" />
            ) : (
              <g>
                <line x1={PAD.left} x2={W - PAD.right} y1={y(t)} y2={y(t)} class={t === 0 || (!bars && t === ticks[0]) ? "chart__baseline" : "chart__gridline"} />
                <text x={PAD.left - 10} y={y(t)} dy="0.35em" text-anchor="end" class="chart__tick">{fmt(t)}</text>
              </g>
            ),
          )}
        </g>

        {chart.type === "bar" &&
          chart.series.map((s, si) =>
            s.values.map((v, i) => {
              const gx = x(i) + (slot - groupW) / 2 + si * (barW + barGap);
              const top = Math.min(y(v), zeroY);
              const h = Math.max(1, Math.abs(y(v) - zeroY));
              return (
                <g class="chart__mark">
                  <title>{`${chart.categories[i]} — ${s.name}: ${label(v)}`}</title>
                  <rect x={gx} y={top} width={barW} height={h} fill={colors[si]} class={v < 0 ? "is-below" : undefined} />
                  {showValueLabels && (
                    <text x={gx + barW / 2} y={v >= 0 ? top - 7 : top + h + Math.round(TEXT * 1.05)} text-anchor="middle" class="chart__value">{markValue(v)}</text>
                  )}
                </g>
              );
            }),
          )}

        {chart.type === "line" &&
          chart.series.map((s, si) => {
            const pts = points(s);
            const d = pts.map(([px, py], i) => `${i === 0 ? "M" : "L"}${px.toFixed(1)} ${py.toFixed(1)}`).join(" ");
            const last = pts[pts.length - 1];
            return (
              <g class="chart__series">
                <path d={d} fill="none" stroke={colors[si]} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" pathLength="1" class="chart__line" />
                {pts.map(([px, py], i) => (
                  <g class="chart__mark">
                    <title>{`${chart.categories[i]} — ${s.name}: ${label(s.values[i])}`}</title>
                    <circle cx={px} cy={py} r="4.5" fill={colors[si]} stroke="var(--paper)" stroke-width="2" />
                  </g>
                ))}
                {lineEndLabel && (
                  <text x={last[0] + 8} y={last[1]} dy="0.35em" class="chart__value chart__value--end">{markValue(s.values[s.values.length - 1])}</text>
                )}
              </g>
            );
          })}
      </svg>
      {/* The categories as text under the plot, each under its own column or point: whole, wrapped to as many lines as
          they need at the site's small size. The drawing is announced by its title; the table below carries the data. */}
      <ol class="chart__cats" style={`--n:${n};--pl:${((PAD.left / W) * 100).toFixed(3)}%;--pr:${((PAD.right / W) * 100).toFixed(3)}%`} aria-hidden="true">
        {chart.categories.map((c) => <li>{c}</li>)}
      </ol>
    </>
  )}

  {!compact && <details class="chart__data">
    <summary class="ui">عرض البيانات كجدول</summary>
    <table>
      <thead>
        <tr>
          <th scope="col">البند</th>
          {chart.series.map((s) => <th scope="col">{s.name}</th>)}
        </tr>
      </thead>
      <tbody>
        {chart.categories.map((c, i) => (
          <tr>
            <th scope="row">{c}</th>
            {chart.series.map((s) => <td><bdi dir="ltr">{label(s.values[i])}</bdi></td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </details>}

  <p class="chart__source ui">
    {chart.source ? `المصدر: ${chart.source}. ` : ""}الرسم من إعداد خازندار اعتماداً على أرقام المصدر.
  </p>
</figure>

<style>
  .chart { margin: 1.5rem 0 1.75rem; max-width: var(--measure); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--rule); padding: 0.8rem 0 0.9rem; }
  /* The unit reads as the title's subtitle, under it: at the far end of the title's line it floated away from it. */
  .chart__head { display: block; }
  .chart__title { font-family: var(--font-title); font-weight: 700; font-size: var(--t-head); line-height: 1.4; }
  .chart__unit { margin-top: 0.15rem; font-size: var(--fs-sm); color: var(--ink-3); }
  .chart__legend { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; margin-top: 0.6rem; font-size: var(--fs-sm); font-weight: 500; color: var(--ink-2); }
  .chart__legend li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .chart__swatch { width: 0.75rem; height: 0.75rem; display: inline-block; }
  .chart__svg { width: 100%; height: auto; margin-top: 0.6rem; font-family: var(--font-ui); }
  .chart__gridline { stroke: var(--rule); stroke-width: 1; }
  .chart__baseline { stroke: var(--ink-3); stroke-width: 1; }
  /* Sizes in the drawing's units (see TEXT in the script above), each landing near 12.5px on screen. */
  .chart__tick, .chart__value { fill: var(--ink-2); font-size: 14.5px; font-variant-numeric: tabular-nums; }
  .chart__value { fill: var(--ink); font-weight: 700; }
  /* The categories under the drawing, as text at the site's small size, each under its own column or point: the grid
     starts and ends where the drawing's plot does (the drawing runs left to right, so does the grid; each label
     finds its own direction). Drawn inside the svg they were wrapped for the phone's larger size and cut with «…»
     wherever they ran long (the owner, 2026-09-27: "graphs cut text under the columns"). */
  .chart__cats { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); margin: 0.3rem var(--pr) 0 var(--pl); padding: 0; list-style: none; direction: ltr; }
  /* A word is never split: a long one («الإسلامية» in a phone's 50px column) runs a little into the gutters beside it
     rather than break between its joined letters. */
  .chart__cats li { padding-inline: 0.1rem; font-family: var(--font-ui); font-size: var(--fs-xs); line-height: 1.35; color: var(--ink); text-align: center; direction: rtl; unicode-bidi: plaintext; }
  .chart__mark:hover rect, .chart__mark:hover circle { filter: brightness(0.85); }

  /* Horizontal bars: the name whole above its bar, the bar from its start (or from zero when values fall below it),
     the value at its end in ink; no grid and no scale, every bar being labelled. Room is kept beside the plot for the
     values that end there. */
  .hbars { display: grid; gap: 0.7rem; margin-top: 0.85rem; }
  .hbars__label { font-family: var(--font-ui); font-size: var(--fs-sm); font-weight: 500; line-height: 1.4; color: var(--ink); }
  .hbars__plot { position: relative; display: grid; gap: 2px; margin-top: 0.3rem; margin-inline-end: 4.2rem; }
  .hbars--negative .hbars__plot { margin-inline-start: 4.2rem; }
  /* Zero, where bars fall on both sides of it: a hairline through the row's bars. */
  .hbars--negative .hbars__plot::before { content: ""; position: absolute; inset-block: -3px; inset-inline-start: var(--zero); border-inline-start: 1px solid var(--ink-3); }
  .hbars__slot { position: relative; height: 0.9rem; }
  .hbars--multi .hbars__slot { height: 0.7rem; }
  .hbars__bar { position: absolute; inset-block: 0; }
  .hbars__value { position: absolute; inset-block: 0; display: flex; align-items: center; padding-inline: 0.4rem; font-family: var(--font-ui); font-size: var(--fs-sm); font-weight: 700; line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .hbars--multi .hbars__value { font-size: var(--fs-xs); }
  .hbars__slot:hover .hbars__bar { filter: brightness(0.85); }

  .chart__data { margin-top: 0.75rem; font-size: var(--fs-data); }
  .chart__data summary { cursor: pointer; color: var(--green); font-weight: 700; }
  .chart__data table { width: 100%; border-collapse: collapse; margin-top: 0.5rem; font-family: var(--font-ui); }
  .chart__data th, .chart__data td { padding: 0.35rem 0.5rem; border-bottom: 1px solid var(--rule); text-align: start; }
  .chart__data thead th { font-weight: 700; color: var(--ink-2); border-bottom-color: var(--ink); }
  .chart__source { margin-top: 0.6rem; font-size: var(--fs-xs); color: var(--ink-3); }

  .chart--compact { margin: 0; max-width: none; border-top: 0; border-bottom: 0; padding: 0; }
  .chart--compact .chart__title { font-size: var(--t-list); line-height: 1.45; }
  .chart--compact .chart__unit { margin-top: 0.1rem; }
  .chart--compact .chart__title a { text-decoration: none; }
  .chart--compact .chart__title a:hover { color: var(--green); }
  .chart--compact .chart__svg { margin-top: 0.4rem; }
  .chart--compact .hbars { gap: 0.55rem; margin-top: 0.6rem; }
  .chart--compact .hbars__plot { margin-inline-end: 3.6rem; }
  .chart--compact.chart--hbars .hbars--negative .hbars__plot { margin-inline-start: 3.6rem; }
  .chart--compact .chart__tick, .chart--compact .chart__value { font-size: 14px; }
  .chart--narrow .chart__tick, .chart--narrow .chart__value { font-size: 19px; }
  .chart--compact .chart__source { margin-top: 0.4rem; }
  @media (max-width: 719px) {
    .chart__tick, .chart__value { font-size: 24px; }
    /* On a phone the side column's chart runs the column's full width. */
    .chart--narrow .chart__tick, .chart--narrow .chart__value { font-size: 14px; }
  }
</style>
