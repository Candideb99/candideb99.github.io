---
/**
 * Arabic data chart rendered as static SVG from source-grounded figures.
 * One axis, thin marks, legend for two or more series, selective direct labels,
 * native tooltips on every mark, and a table view of the same data.
 */
import { isolateNumbers } from "@lib/bidi";

interface Series {
  name: string;
  values: number[];
}
interface ChartSpec {
  type: "bar" | "line";
  title?: string | null;
  unit?: string;
  source?: string;
  categories: string[];
  series: Series[];
}
interface Props {
  chart: ChartSpec;
  id?: string;
  /** A front-page module: smaller canvas, no data table, the title linking to the story. */
  compact?: boolean;
  /** A compact chart in the front's side column, drawn about 280px wide: its text is drawn larger. */
  narrow?: boolean;
  href?: string;
}
const { chart, id = "chart", compact: compactProp = false, narrow = false, href } = Astro.props;
const compact = compactProp || narrow;

/** The chart's numbers (the scale and the values over the bars) are drawn in the drawing's own units, so they shrink
 *  with the drawing; each kind is sized to come out near the site's small furniture size, about 12.5px, where it is
 *  shown (2026-09-27: at 12 units a story's chart printed them at 10.7px on a laptop and 10.4px on a phone, and the
 *  side column's at 9.4px): a full chart (720 units in a 640px column) at 14.5 units, 24 on a phone (a 358px
 *  column); a compact one (400 units, about 390px wide in the front's band) at 14; the side column's (about 280px)
 *  at 19. The categories are not drawn at all: they are set as text under the drawing (the list after the svg). */
const TEXT = narrow ? 19 : compact ? 14 : 24;
const W = compact ? 400 : 720;
const n = chart.categories.length;
const all = chart.series.flatMap((s) => s.values);
const showValueLabels = n <= 8 && chart.series.length === 1;
// The drawing keeps no room for the categories, so it is shorter by what their lines took and the chart stands about
// as tall as before; a value printed under a bar that hangs below zero keeps its own room.
const below = chart.type === "bar" && showValueLabels && all.some((v) => v < 0) ? Math.round(TEXT * 1.3) : 0;
const H = (compact ? 190 : 300) + below;
const PAD = narrow ? { top: 22, right: 16, bottom: 8, left: 66 } : compact ? { top: 22, right: 16, bottom: 8, left: 56 } : { top: 28, right: 24, bottom: 10, left: 76 };
PAD.bottom += below;
const plotW = W - PAD.left - PAD.right;
const slot = plotW / n;
const x = (i: number) => PAD.left + slot * i;
const plotH = H - PAD.top - PAD.bottom;

// Bars stand on zero; a line follows its own range: Brent between 97 and 108 dollars on a scale from zero was drawn
// as a flat line (2026-09-27).
const bars = chart.type === "bar";
const rawMin = bars ? Math.min(0, ...all) : Math.min(...all);
const rawMax = bars ? Math.max(0, ...all) : Math.max(...all);
const span = rawMax - rawMin || Math.abs(rawMax) * 0.1 || 1;
const niceStep = (() => {
  const rough = span / 4;
  const mag = 10 ** Math.floor(Math.log10(rough));
  const norm = rough / mag;
  const step = norm <= 1 ? 1 : norm <= 2 ? 2 : norm <= 2.5 ? 2.5 : norm <= 5 ? 5 : 10;
  return step * mag;
})();
const yMin = Math.floor(rawMin / niceStep) * niceStep;
const yMax = Math.ceil(rawMax / niceStep) * niceStep || niceStep;
const ticks: number[] = [];
for (let v = yMin; v <= yMax + 1e-9; v += niceStep) ticks.push(Number(v.toFixed(6)));
const y = (v: number) => PAD.top + plotH - ((v - yMin) / (yMax - yMin)) * plotH;
const zeroY = y(0);

function fmt(v: number): string {
  const abs = Math.abs(v);
  const decimals = abs >= 100 ? 0 : abs >= 10 ? 1 : 2;
  return v.toLocaleString("en-US", { maximumFractionDigits: decimals });
}
const unit = chart.unit ?? "";
const label = (v: number) => `${fmt(v)}${unit === "%" ? "%" : unit ? ` ${unit}` : ""}`;

const groupW = slot * 0.72;
const barGap = 2;
const barW = Math.max(6, (groupW - barGap * (chart.series.length - 1)) / chart.series.length);
const lineEndLabel = chart.series.length <= 3;
const colors = ["var(--chart-1)", "var(--chart-2)", "var(--chart-3)"];

const points = (s: Series) => s.values.map((v, i) => [x(i) + slot / 2, y(v)] as const);

---

<figure class={`chart${compact ? " chart--compact" : ""}${narrow ? " chart--narrow" : ""}`} role="group" aria-labelledby={`${id}-title`}>
  <figcaption class="chart__head">
    {chart.title && (
      <h3 id={`${id}-title`} class="chart__title">
        {href ? <a href={href} set:html={isolateNumbers(chart.title)} /> : <Fragment set:html={isolateNumbers(chart.title)} />}
      </h3>
    )}
    {unit && <p class="chart__unit ui">الوحدة: <bdi>{unit}</bdi></p>}
  </figcaption>

  {chart.series.length > 1 && (
    <ul class="chart__legend ui" aria-label="سلاسل البيانات">
      {chart.series.map((s, si) => (
        <li><span class="chart__swatch" style={`background:${colors[si]}`} aria-hidden="true"></span>{s.name}</li>
      ))}
    </ul>
  )}

  <svg class="chart__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={chart.title ?? "رسم بياني"} direction="ltr">
    <g class="chart__grid">
      {ticks.map((t) => (
        <g>
          <line x1={PAD.left} x2={W - PAD.right} y1={y(t)} y2={y(t)} class={t === 0 || (!bars && t === ticks[0]) ? "chart__baseline" : "chart__gridline"} />
          <text x={PAD.left - 10} y={y(t)} dy="0.35em" text-anchor="end" class="chart__tick">{fmt(t)}</text>
        </g>
      ))}
    </g>

    {chart.type === "bar" &&
      chart.series.map((s, si) =>
        s.values.map((v, i) => {
          const gx = x(i) + (slot - groupW) / 2 + si * (barW + barGap);
          const top = Math.min(y(v), zeroY);
          const h = Math.max(1, Math.abs(y(v) - zeroY));
          return (
            <g class="chart__mark">
              <title>{`${chart.categories[i]} — ${s.name}: ${label(v)}`}</title>
              <rect x={gx} y={top} width={barW} height={h} fill={colors[si]} class={v < 0 ? "is-below" : undefined} />
              {showValueLabels && (
                <text x={gx + barW / 2} y={v >= 0 ? top - 6 : top + h + Math.round(TEXT * 1.05)} text-anchor="middle" class="chart__value">{fmt(v)}</text>
              )}
            </g>
          );
        }),
      )}

    {chart.type === "line" &&
      chart.series.map((s, si) => {
        const pts = points(s);
        const d = pts.map(([px, py], i) => `${i === 0 ? "M" : "L"}${px.toFixed(1)} ${py.toFixed(1)}`).join(" ");
        const last = pts[pts.length - 1];
        return (
          <g class="chart__series">
            <path d={d} fill="none" stroke={colors[si]} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" pathLength="1" class="chart__line" />
            {pts.map(([px, py], i) => (
              <g class="chart__mark">
                <title>{`${chart.categories[i]} — ${s.name}: ${label(s.values[i])}`}</title>
                <circle cx={px} cy={py} r="4.5" fill={colors[si]} stroke="var(--paper)" stroke-width="2" />
              </g>
            ))}
            {lineEndLabel && (
              <text x={last[0] + 8} y={last[1]} dy="0.35em" class="chart__value chart__value--end">{fmt(s.values[s.values.length - 1])}</text>
            )}
          </g>
        );
      })}
  </svg>
  {/* The categories as text under the plot, each under its own bar or point: whole, wrapped to as many lines as they
      need at the site's small size. The drawing is announced by its title; the table below carries the data. */}
  <ol class="chart__cats" style={`--n:${n};--pl:${((PAD.left / W) * 100).toFixed(3)}%;--pr:${((PAD.right / W) * 100).toFixed(3)}%`} aria-hidden="true">
    {chart.categories.map((c) => <li>{c}</li>)}
  </ol>

  {!compact && <details class="chart__data">
    <summary class="ui">عرض البيانات كجدول</summary>
    <table>
      <thead>
        <tr>
          <th scope="col">البند</th>
          {chart.series.map((s) => <th scope="col">{s.name}</th>)}
        </tr>
      </thead>
      <tbody>
        {chart.categories.map((c, i) => (
          <tr>
            <th scope="row">{c}</th>
            {chart.series.map((s) => <td><bdi dir="ltr">{label(s.values[i])}</bdi></td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </details>}

  <p class="chart__source ui">
    {chart.source ? `المصدر: ${chart.source}. ` : ""}الرسم من إعداد خازندار اعتماداً على أرقام المصدر.
  </p>
</figure>

<style>
  .chart { margin: 1.5rem 0 1.75rem; max-width: var(--measure); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--rule); padding: 0.8rem 0 0.9rem; }
  .chart__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.25rem 1rem; }
  .chart__title { font-family: var(--font-title); font-weight: 700; font-size: var(--t-head); line-height: 1.4; }
  .chart__unit { font-size: var(--fs-sm); color: var(--ink-3); }
  .chart__legend { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; margin-top: 0.5rem; font-size: var(--fs-sm); font-weight: 500; color: var(--ink-2); }
  .chart__legend li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .chart__swatch { width: 0.8rem; height: 0.8rem; display: inline-block; }
  .chart__svg { width: 100%; height: auto; margin-top: 0.6rem; font-family: var(--font-ui); }
  .chart__gridline { stroke: var(--rule); stroke-width: 1; }
  .chart__baseline { stroke: var(--ink-3); stroke-width: 1; }
  /* Sizes in the drawing's units (see TEXT in the script above), each landing near 12.5px on screen. */
  .chart__tick, .chart__value { fill: var(--ink-2); font-size: 14.5px; font-variant-numeric: tabular-nums; }
  .chart__value { fill: var(--ink); font-weight: 700; }
  /* The categories under the drawing, as text at the site's small size, each under its own bar or point: the grid
     starts and ends where the drawing's plot does (the drawing runs left to right, so does the grid; each label
     finds its own direction). Drawn inside the svg they were wrapped for the phone's larger size and cut with «…»
     wherever they ran long (the owner, 2026-09-27: "graphs cut text under the columns"). */
  .chart__cats { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); margin: 0.3rem var(--pr) 0 var(--pl); padding: 0; list-style: none; direction: ltr; }
  /* A word is never split: a long one («الإسلامية» in a phone's 50px column) runs a little into the gutters beside it
     rather than break between its joined letters. */
  .chart__cats li { padding-inline: 0.1rem; font-family: var(--font-ui); font-size: var(--fs-xs); line-height: 1.35; color: var(--ink); text-align: center; direction: rtl; unicode-bidi: plaintext; }
  .chart__mark:hover rect, .chart__mark:hover circle { filter: brightness(0.85); }
  .chart__data { margin-top: 0.6rem; font-size: var(--fs-data); }
  .chart__data summary { cursor: pointer; color: var(--green); font-weight: 700; }
  .chart__data table { width: 100%; border-collapse: collapse; margin-top: 0.5rem; font-family: var(--font-ui); }
  .chart__data th, .chart__data td { padding: 0.35rem 0.5rem; border-bottom: 1px solid var(--rule); text-align: start; }
  .chart__data thead th { font-weight: 700; color: var(--ink-2); border-bottom-color: var(--ink); }
  .chart__source { margin-top: 0.6rem; font-size: var(--fs-xs); color: var(--ink-3); }

  .chart--compact { margin: 0; max-width: none; border-top: 0; border-bottom: 0; padding: 0; }
  /* Side by side in the band, each compact chart keeps two lines for its title and puts the unit under it, so the
     drawings start on one line. */
  .chart--compact .chart__head { display: block; }
  .chart--compact .chart__title { font-size: var(--t-list); line-height: 1.45; min-height: 2.9em; }
  .chart--compact .chart__unit { margin-top: 0.1rem; }
  .chart--compact .chart__title a { text-decoration: none; }
  .chart--compact .chart__title a:hover { color: var(--green); }
  .chart--compact .chart__svg { margin-top: 0.4rem; }
  .chart--compact .chart__tick, .chart--compact .chart__value { font-size: 14px; }
  .chart--narrow .chart__tick, .chart--narrow .chart__value { font-size: 19px; }
  .chart--compact .chart__source { margin-top: 0.4rem; }
  @media (max-width: 719px) {
    .chart__tick, .chart__value { font-size: 24px; }
    /* On a phone the side column's chart runs the column's full width, as the band's does. */
    .chart--narrow .chart__tick, .chart--narrow .chart__value { font-size: 14px; }
  }
</style>
