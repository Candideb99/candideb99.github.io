---
/**
 * The cover: the day's lead story, still, with the next four beside it as a list.
 *
 * This replaced a rotating cover on 2026-09-11 after a survey of sixteen major news sites: fifteen
 * present a still lead (every economics title does), and the usability research on homepage
 * carousels is one-sided (about 1% of visitors click one, 84% of those clicks on the first slide;
 * NN/g, Baymard). The four other stories lose nothing: as a list they are all visible, scannable and
 * clickable at once, the way العربية, سكاي نيوز, FT and BBC set their lead package.
 */
import type { Article } from "@lib/articles";
import { articleHref, topicOf } from "@lib/articles";
import { kindLabel, sectionHref } from "@lib/sections";
import { excerpt, timeAgo } from "@lib/format";
import { isolateNumbers } from "@lib/bidi";
import Photo from "./Photo.astro";

interface Props {
  stories: Article[];
  /** Ids of the stories allowed to show their picture here (the first appearance of each picture). */
  photoIds: Set<string>;
}
const { stories, photoIds } = Astro.props;
const [lead, ...beside] = stories;
const d = lead.data;
const summary = excerpt(d.subtitle || d.lede, 200);
const href = articleHref(lead);
const withPhoto = Boolean(d.image) && photoIds.has(lead.id);
const topic = topicOf(lead);
---

<section class="wrap cover" aria-label="أبرز أخبار العدد">
  <article class={`cover__lead${withPhoto ? "" : " cover__lead--text"}`} data-section={d.section}>
    <div class="cover__body">
      {topic && <span class="kicker"><a href={`/tags/${encodeURIComponent(topic)}/`}>{topic}</a></span>}
      <h2 class="cover__title"><a href={href} set:html={isolateNumbers(d.title)} /></h2>
      {summary && <p class="cover__dek" set:html={isolateNumbers(summary)} />}
      <p class="meta cover__meta">
        <a href={sectionHref(d.section)}>{kindLabel(d.kind, d.section)}</a>
        <time datetime={d.publishedAt} data-relative>{timeAgo(d.publishedAt)}</time>
      </p>
    </div>
    {withPhoto && (
      <a class="cover__photo" href={href} tabindex="-1" aria-hidden="true">
        <Photo image={d.image} ratio="3/2" eager sizes="(min-width: 1320px) 560px, (min-width: 1024px) 45vw, 100vw" />
      </a>
    )}
  </article>

  {beside.length > 0 && (
    <div class="cover__beside">
      {beside.map((a) => {
        const t = topicOf(a);
        const photo = Boolean(a.data.image) && photoIds.has(a.id);
        return (
          <article class="cover__item" data-section={a.data.section}>
            {photo && (
              <a class="cover__thumb" href={articleHref(a)} tabindex="-1" aria-hidden="true">
                <Photo image={a.data.image} ratio="1/1" sizes="88px" />
              </a>
            )}
            <div class="cover__item-body">
              {t && <span class="kicker"><a href={`/tags/${encodeURIComponent(t)}/`}>{t}</a></span>}
              <h3 class="cover__item-title"><a href={articleHref(a)} set:html={isolateNumbers(a.data.title)} /></h3>
              <p class="meta"><time datetime={a.data.publishedAt} data-relative>{timeAgo(a.data.publishedAt)}</time></p>
            </div>
          </article>
        );
      })}
    </div>
  )}
</section>

<style>
  .cover { display: grid; grid-template-columns: minmax(0, 9fr) minmax(0, 3fr); column-gap: 0; padding-top: clamp(1.1rem, 2.5vw, 1.75rem); padding-bottom: clamp(1.25rem, 2.5vw, 1.75rem); border-bottom: 3px solid var(--ink); align-items: start; }

  /* The lead: headline first in the reading direction, the photograph beside it. */
  .cover__lead { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 0 clamp(1.25rem, 3vw, 2.5rem); align-items: center; padding-inline-end: var(--col-gap); }
  .cover__lead--text { grid-template-columns: 1fr; }
  .cover__lead--text .cover__body { max-width: 56rem; padding-block: 1.5rem; }
  .cover__body { order: 1; }
  .cover__photo { order: 2; display: block; text-decoration: none; }
  .cover__title { font-family: var(--font-title); font-weight: 700; font-size: clamp(1.85rem, 1.2rem + 2.2vw, 2.9rem); line-height: 1.26; }
  .cover__title a { text-decoration: none; }
  .cover__title a:hover { color: var(--green); }
  .cover__dek { font-family: var(--font-body); font-size: clamp(1.05rem, 1rem + 0.25vw, 1.18rem); line-height: 1.7; color: var(--ink-2); margin-top: 0.55rem; max-width: 34em; }
  .cover__meta { margin-top: 0.6rem; }

  /* The four beside: a ruled list of thumbnails, all visible at once. */
  .cover__beside { display: grid; align-content: start; border-inline-start: 1px solid var(--rule); padding-inline-start: var(--col-gap); }
  .cover__item { display: flex; align-items: flex-start; gap: 0.75rem; padding-block: 0.7rem; border-top: 1px solid var(--rule); }
  .cover__item:first-child { border-top: 0; padding-top: 0; }
  .cover__thumb { flex: 0 0 5.5rem; width: 5.5rem; display: block; }
  .cover__item-body { min-width: 0; }
  .cover__item-title { font-family: var(--font-title); font-weight: 700; font-size: 1.02rem; line-height: 1.45; }
  .cover__item-title a { text-decoration: none; }
  .cover__item-title a:hover { color: var(--green); }
  .cover__item .meta { margin-top: 0.15rem; font-size: 0.78rem; }
  .cover__item .kicker { margin-bottom: 0.1rem; }

  @media (max-width: 1023px) {
    .cover { grid-template-columns: 1fr; row-gap: 1.25rem; }
    .cover__lead { padding-inline-end: 0; }
    .cover__beside { border-inline-start: 0; padding-inline-start: 0; border-top: 1px solid var(--ink); padding-top: 0.5rem; grid-template-columns: 1fr 1fr; column-gap: var(--col-gap); }
    .cover__item:nth-child(2) { border-top: 0; padding-top: 0; }
  }
  @media (max-width: 719px) {
    .cover__lead { grid-template-columns: 1fr; gap: 0.6rem 0; align-items: start; }
    .cover__photo { order: 1; }
    .cover__body { order: 2; }
    .cover__beside { grid-template-columns: 1fr; }
    .cover__item:nth-child(2) { border-top: 1px solid var(--rule); padding-top: 0.7rem; }
  }
</style>
