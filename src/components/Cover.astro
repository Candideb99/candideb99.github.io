---
/**
 * The cover: the day's five strongest stories on a rotating stage, with the same five listed beside
 * it, the current one highlighted.
 *
 * The owner chose rotation after seeing the carousel research, so it is built to that research's
 * fallback rules: an eight-second interval, a 400ms fade, small dots on the photograph, pause
 * under the pointer and keyboard focus, a minute's rest after any dot click, no rotation on phones or for readers who asked for reduced motion, and the list of
 * headlines beside the stage as the real indicator. Without JavaScript the first story stands
 * alone and the list is plain links. The script is embedded so a cached page cannot lose it.
 */
import type { Article } from "@lib/articles";
import { articleHref, topicOf } from "@lib/articles";
import { kindLabel, sectionHref } from "@lib/sections";
import { excerpt, timeAgo } from "@lib/format";
import { isolateNumbers } from "@lib/bidi";
import Photo from "./Photo.astro";

interface Props {
  stories: Article[];
  /** Ids of the stories allowed to show their picture here (the first appearance of each picture). */
  photoIds: Set<string>;
  /** Milliseconds a story stays on the stage. */
  interval?: number;
}
const { stories, photoIds, interval = 8000 } = Astro.props;
---

<section class="wrap cover" data-cover data-interval={interval} aria-roledescription="carousel" aria-label="أبرز أخبار العدد">
  <div class="cover__stage">
    {stories.map((a, i) => {
      const d = a.data;
      const summary = excerpt(d.subtitle || d.lede, 200);
      const href = articleHref(a);
      const withPhoto = Boolean(d.image) && photoIds.has(a.id);
      const topic = topicOf(a);
      return (
        <article class={`cover__slide${withPhoto ? "" : " cover__slide--text"}`} id={`cover-slide-${i}`} role="group" aria-roledescription="slide" aria-label={`${i + 1} من ${stories.length}`} data-index={i} hidden={i !== 0} data-section={d.section}>
          <div class="cover__body">
            {topic && <span class="kicker"><a href={`/tags/${encodeURIComponent(topic)}/`}>{topic}</a></span>}
            <h2 class="cover__title"><a href={href} set:html={isolateNumbers(d.title)} /></h2>
            {summary && <p class="cover__dek" set:html={isolateNumbers(summary)} />}
            <p class="meta cover__meta">
              <a href={sectionHref(d.section)}>{kindLabel(d.kind, d.section)}</a>
              <time datetime={d.publishedAt} data-relative>{timeAgo(d.publishedAt)}</time>
            </p>
          </div>
          {withPhoto && (
            <a class="cover__photo" href={href} tabindex="-1" aria-hidden="true">
              <Photo image={d.image} ratio="3/2" eager={i === 0} sizes="(min-width: 1320px) 560px, (min-width: 1024px) 45vw, 100vw" />
            </a>
          )}
        </article>
      );
    })}

    {stories.length > 1 && (
      <div class="cover__controls" hidden data-cover-controls>
        <div class="cover__dots" role="tablist" aria-label="اختر الخبر">
          {stories.map((a, i) => (
            <button type="button" class="cover__dot" role="tab" aria-selected={i === 0 ? "true" : "false"} aria-controls={`cover-slide-${i}`} aria-label={a.data.title} data-index={i}></button>
          ))}
        </div>
      </div>
    )}
  </div>

  {stories.length > 1 && (
    <div class="cover__beside">
      {stories.map((a, i) => {
        const t = topicOf(a);
        const photo = Boolean(a.data.image) && photoIds.has(a.id);
        return (
          <article class={`cover__item${i === 0 ? " is-current" : ""}`} data-index={i} data-section={a.data.section}>
            {photo && (
              <a class="cover__thumb" href={articleHref(a)} tabindex="-1" aria-hidden="true">
                <Photo image={a.data.image} ratio="1/1" sizes="88px" />
              </a>
            )}
            <div class="cover__item-body">
              {t && <span class="kicker"><a href={`/tags/${encodeURIComponent(t)}/`}>{t}</a></span>}
              <h3 class="cover__item-title"><a href={articleHref(a)} data-cover-link={i} set:html={isolateNumbers(a.data.title)} /></h3>
              <p class="meta"><time datetime={a.data.publishedAt} data-relative>{timeAgo(a.data.publishedAt)}</time></p>
            </div>
          </article>
        );
      })}
    </div>
  )}
</section>

<script is:inline>
  (function () {
    var roots = document.querySelectorAll("[data-cover]");
    for (var r = 0; r < roots.length; r++) init(roots[r]);

    function init(root) {
      var slides = root.querySelectorAll(".cover__slide");
      var dots = root.querySelectorAll(".cover__dot");
      var items = root.querySelectorAll(".cover__item");
      var controls = root.querySelector("[data-cover-controls]");
      if (slides.length < 2 || dots.length !== slides.length) return;
      var interval = Number(root.getAttribute("data-interval")) || 8000;
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var phone = window.matchMedia("(max-width: 719px)").matches;
      var current = 0;
      var timer = null;
      var auto = !reduce && !phone;
      root.classList.add("cover--js");
      if (controls) controls.hidden = false;

      function show(i) {
        i = (i + slides.length) % slides.length;
        for (var k = 0; k < slides.length; k++) {
          var on = k === i;
          slides[k].hidden = !on;
          dots[k].setAttribute("aria-selected", on ? "true" : "false");
          if (items[k]) items[k].classList.toggle("is-current", on);
        }
        current = i;
        warm((i + 1) % slides.length);
      }
      function warm(i) {
        var img = slides[i].querySelector("img");
        if (!img || img.getAttribute("data-warm")) return;
        img.setAttribute("data-warm", "1");
        var pre = new Image();
        if (img.sizes) pre.sizes = img.sizes;
        if (img.srcset) pre.srcset = img.srcset;
        pre.src = img.currentSrc || img.src;
      }
      function start() {
        if (!auto || timer) return;
        timer = setInterval(function () { show(current + 1); }, interval);
        root.classList.add("is-running");
      }
      function stop() {
        if (timer) { clearInterval(timer); timer = null; }
        root.classList.remove("is-running");
      }
      // A dot click hands control to the reader for a while; the rotation resumes after a minute away.
      var resumeAt = 0;
      function takeControl() {
        stop();
        resumeAt = Date.now() + 60000;
      }

      for (var t = 0; t < dots.length; t++) {
        dots[t].addEventListener("click", function () {
          takeControl();
          show(Number(this.getAttribute("data-index")));
        });
        dots[t].addEventListener("keydown", function (e) {
          var i = Number(this.getAttribute("data-index"));
          var next;
          if (e.key === "ArrowLeft") next = i + 1;
          else if (e.key === "ArrowRight") next = i - 1;
          else if (e.key === "Home") next = 0;
          else if (e.key === "End") next = slides.length - 1;
          else return;
          e.preventDefault();
          takeControl();
          show(next);
          dots[current].focus();
        });
      }
      // Hovering a headline in the list brings its story to the stage; clicking opens it.
      for (var m = 0; m < items.length; m++) {
        items[m].addEventListener("mouseenter", function () {
          var i = Number(this.getAttribute("data-index"));
          if (i !== current) show(i);
        });
      }
      function resume() { if (auto && Date.now() >= resumeAt && !root.matches(":hover")) start(); }
      root.addEventListener("mouseenter", stop);
      root.addEventListener("mouseleave", resume);
      root.addEventListener("focusin", stop);
      root.addEventListener("focusout", function (e) { if (!root.contains(e.relatedTarget)) resume(); });
      document.addEventListener("visibilitychange", function () { if (document.hidden) stop(); else resume(); });
      setInterval(resume, 5000);

      show(0);
      start();
    }
  })();
</script>

<style>
  .cover { display: grid; grid-template-columns: minmax(0, 9fr) minmax(0, 3fr); column-gap: 0; padding-top: clamp(1.1rem, 2.5vw, 1.75rem); padding-bottom: clamp(1.25rem, 2.5vw, 1.75rem); border-bottom: 3px solid var(--ink); align-items: start; }

  .cover__stage { position: relative; padding-inline-end: var(--col-gap); display: grid; align-content: center; min-height: 100%; }
  .cover__slide { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 0 clamp(1.25rem, 3vw, 2.5rem); align-items: center; grid-area: 1 / 1; }
  .cover__slide[hidden] { display: none; }
  .cover--js .cover__slide:not([hidden]) { animation: cover-in 0.4s var(--ease-out); }
  @keyframes cover-in { from { opacity: 0; } }
  .cover__slide--text { grid-template-columns: 1fr; }
  .cover__slide--text .cover__body { max-width: 56rem; padding-block: 1.5rem; }
  .cover__body { order: 1; }
  .cover__photo { order: 2; display: block; text-decoration: none; }
  .cover__title { font-family: var(--font-title); font-weight: 700; font-size: clamp(1.7rem, 1.1rem + 1.9vw, 2.5rem); line-height: 1.28; }
  .cover__title a { text-decoration: none; }
  .cover__title a:hover { color: var(--green); }
  .cover__dek { font-family: var(--font-body); font-size: clamp(1.05rem, 1rem + 0.25vw, 1.18rem); line-height: 1.7; color: var(--ink-2); margin-top: 0.55rem; max-width: 34em; }
  .cover__meta { margin-top: 0.6rem; }

  /* The dots sit on the photograph's bottom corner on a paper plate, with the pause control beside them. */
  .cover__controls { position: absolute; bottom: 0.6rem; inset-inline-end: calc(var(--col-gap) + 0.6rem); display: flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.5rem; background: var(--paper); border: 1px solid var(--rule); }
  .cover__dot { width: 0.6rem; height: 0.6rem; padding: 0; border: 1px solid var(--green); border-radius: 50%; background: transparent; cursor: pointer; }
  .cover__dot[aria-selected="true"] { background: var(--green); }
  .cover__dot:hover { background: var(--green-deep); }
  .cover__dots { display: flex; align-items: center; gap: 0.4rem; padding-inline: 0.15rem; }

  /* The five beside: a ruled list of thumbnails, the current story marked with the green bar. */
  .cover__beside { display: grid; align-content: start; border-inline-start: 1px solid var(--rule); padding-inline-start: var(--col-gap); }
  .cover__item { position: relative; display: flex; align-items: flex-start; gap: 0.65rem; padding-block: 0.55rem; border-top: 1px solid var(--rule); }
  .cover__item:first-child { border-top: 0; padding-top: 0; }
  .cover__item::before { content: ""; position: absolute; inset-inline-start: calc(-1 * var(--col-gap) - 1px); top: 0.55rem; bottom: 0.55rem; width: 3px; background: transparent; }
  .cover__item:first-child::before { top: 0; }
  .cover--js .cover__item.is-current::before { background: var(--green); }
  .cover--js .cover__item.is-current .cover__item-title { color: var(--green); }
  .cover__thumb { flex: 0 0 4.25rem; width: 4.25rem; display: block; }
  .cover__item-body { min-width: 0; }
  .cover__item-title { font-family: var(--font-title); font-weight: 700; font-size: 0.98rem; line-height: 1.42; }
  .cover__item-title a { text-decoration: none; }
  .cover__item-title a:hover { color: var(--green); }
  .cover__item .meta { margin-top: 0.1rem; font-size: 0.75rem; }
  .cover__item .kicker { margin-bottom: 0.05rem; font-size: 0.72rem; }

  @media (max-width: 1023px) {
    .cover { grid-template-columns: 1fr; row-gap: 1.25rem; }
    .cover__stage { padding-inline-end: 0; }
    .cover__controls { inset-inline-end: 0.6rem; }
    .cover__beside { border-inline-start: 0; padding-inline-start: 0; border-top: 1px solid var(--ink); padding-top: 0.5rem; grid-template-columns: 1fr 1fr; column-gap: var(--col-gap); }
    .cover__item::before { display: none; }
    .cover__item:nth-child(2) { border-top: 0; padding-top: 0; }
  }
  @media (max-width: 719px) {
    .cover__slide { grid-template-columns: 1fr; gap: 0.6rem 0; align-items: start; }
    .cover__photo { order: 1; }
    .cover__body { order: 2; }
    .cover__controls { display: none; }
    .cover__beside { grid-template-columns: 1fr; }
    .cover__item:nth-child(2) { border-top: 1px solid var(--rule); padding-top: 0.7rem; }
    .cover--js .cover__item.is-current .cover__item-title { color: inherit; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cover--js .cover__slide:not([hidden]) { animation: none; }
  }
</style>
