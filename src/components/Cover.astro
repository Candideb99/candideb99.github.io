---
/**
 * The cover: the day's five strongest stories on a rotating stage, and beside it the paper's own
 * voice (one reading of each kind: the latest analysis, explainer and paper reading, each with its
 * dek), the way a business daily runs its readings beside the lead. The market box that used to sit
 * under the readings now heads the numbers column under the cover (Front.astro): stacked here it made
 * the column 740px tall, and the photograph stretched to match it was cropped to a portrait strip.
 *
 * The owner chose rotation after seeing the carousel research, so it is built to that research's
 * fallback rules: a six-second interval, a 400ms fade (dropped under reduced motion; the stage still
 * turns, the owner's decision), pause under the pointer and while keyboard focus is inside, a minute's
 * rest after any click on a tab, no button, and no rotation on phones.
 *
 * The tabs are the five headlines, numbered, in a row under the stage (2026-09-27; until then five small dots inside
 * the photograph, which hid the four stories behind the lead: a reader saw one headline of the day's five). They are
 * printed as links, so the row is there before the script runs (nothing under the cover moves when it does) and
 * without JavaScript each still opens its story; the script makes them tabs. A click with a modifier key still opens
 * the story. On a phone, where the stage does not turn, the four stories behind the lead are listed under it
 * instead, with their pictures. The script is embedded so a cached page cannot lose it.
 */
import type { Article } from "@lib/articles";
import { articleHref, topicOf } from "@lib/articles";
import { tagHref } from "@lib/topics";
import { kindLabel, sectionHref } from "@lib/sections";
import { analysisLabel } from "@lib/analysis";
import { excerpt, timeAgo } from "@lib/format";
import { isolateNumbers } from "@lib/bidi";
import Photo from "./Photo.astro";
import StoryCard from "./StoryCard.astro";

interface Props {
  stories: Article[];
  /** The paper's readings for the column beside the stage: one of each kind, analysis first. */
  readings?: Article[];
  /** Ids of the stories allowed to show their picture here (the first appearance of each picture). */
  photoIds: Set<string>;
  /** Every article, for the analysis desk labels. */
  all?: Article[];
  /** Milliseconds a story stays on the stage. */
  interval?: number;
  /** Up to two headlines on each story's running topic, by story id, printed under its meta line. */
  related?: Map<string, Article[]>;
}
const { stories, readings = [], photoIds, interval = 6000, all = [], related = new Map<string, Article[]>() } = Astro.props;
---

<section class="wrap cover" data-cover data-interval={interval} aria-roledescription="carousel" aria-label="أبرز الأخبار">
  <div class="cover__stage">
    <div class="cover__slides">
    {stories.map((a, i) => {
      const d = a.data;
      const summary = excerpt(d.subtitle || d.lede, 160);
      const href = articleHref(a);
      const withPhoto = Boolean(d.image) && photoIds.has(a.id);
      const topic = topicOf(a);
      return (
        <article class={`cover__slide${withPhoto ? "" : " cover__slide--text"}`} id={`cover-slide-${i}`} role="tabpanel" aria-roledescription="slide" aria-label={`${i + 1} من ${stories.length}`} data-index={i} hidden={i !== 0} data-section={d.section}>
          <div class="cover__body">
            {topic && <span class="kicker"><a href={tagHref(topic)}>{topic}</a></span>}
            <h2 class="cover__title"><a href={href} set:html={isolateNumbers(d.title)} /></h2>
            {summary && <p class="cover__dek" set:html={isolateNumbers(summary)} />}
            <p class="meta cover__meta">
              <a href={sectionHref(d.section)}>{kindLabel(d.kind, d.section)}</a>
              <time datetime={d.publishedAt} data-relative>{timeAgo(d.publishedAt)}</time>
            </p>
            {(related.get(a.id) ?? []).length > 0 && (
              <div class="cover__related">
                <p class="cover__related-head ui">ذات صلة</p>
                <ul>
                  {(related.get(a.id) ?? []).map((r) => (
                    <li><a href={articleHref(r)} set:html={isolateNumbers(r.data.title)} /></li>
                  ))}
                </ul>
              </div>
            )}
          </div>
          {withPhoto && (
            <a class="cover__photo" href={href} tabindex="-1" aria-hidden="true">
              <Photo image={d.image} ratio="3/2" eager={i === 0} sizes="(min-width: 1320px) 680px, (min-width: 1200px) 50vw, (min-width: 720px) 62vw, 100vw" />
            </a>
          )}
        </article>
      );
    })}
    </div>

    {stories.length > 1 && (
      <div class="cover__tabs" data-cover-tabs style={`--tabs: ${stories.length}`}>
        {stories.map((a, i) => (
          <a class={`cover__tab${i === 0 ? " is-on" : ""}`} href={articleHref(a)} id={`cover-tab-${i}`} data-index={i}>
            <span class="cover__tab-title"><span class="cover__tab-num" aria-hidden="true">{i + 1}</span><span set:html={isolateNumbers(a.data.title)} /></span>
          </a>
        ))}
      </div>
    )}

    {stories.length > 1 && (
      <div class="cover__more" aria-label="أبرز الأخبار أيضاً" role="group">
        {stories.slice(1).map((a) => (
          <StoryCard article={a} variant="list" showSection showPhoto={photoIds.has(a.id)} />
        ))}
      </div>
    )}
  </div>

  {readings.length > 0 && (
    <aside class="cover__beside" aria-labelledby="readings-head">
      <h2 id="readings-head" class="module__head">قراءات خازندار</h2>
      <div class="cover__readings">
        {readings.map((a) => {
          const analysis = a.data.kind === "analysis" || a.data.kind === "weekly";
          // «في العمق» keeps the longer dek and its date like the analysis, without taking the lead's size.
          const dated = analysis || a.data.kind === "feature";
          const dek = excerpt(a.data.subtitle || a.data.lede, dated ? 100 : 70);
          return (
            <article class={`cover__reading${analysis ? " cover__reading--lead" : ""}`} data-section={a.data.section}>
              <span class="kicker">{analysisLabel(a, all) ?? kindLabel(a.data.kind, a.data.section)}</span>
              <h3 class="cover__reading-title"><a href={articleHref(a)} set:html={isolateNumbers(a.data.title)} /></h3>
              {dek && <p class="cover__reading-dek" set:html={isolateNumbers(dek)} />}
              {dated && <p class="meta"><time datetime={a.data.publishedAt} data-relative>{timeAgo(a.data.publishedAt)}</time></p>}
            </article>
          );
        })}
      </div>
    </aside>
  )}
</section>

<script is:inline>
  (function () {
    var roots = document.querySelectorAll("[data-cover]");
    for (var r = 0; r < roots.length; r++) init(roots[r]);

    function init(root) {
      var box = root.querySelector(".cover__slides");
      var slides = root.querySelectorAll(".cover__slide");
      var list = root.querySelector("[data-cover-tabs]");
      var tabs = root.querySelectorAll(".cover__tab");
      if (slides.length < 2 || tabs.length !== slides.length) return;
      var interval = Number(root.getAttribute("data-interval")) || 6000;
      var phone = window.matchMedia("(max-width: 719px)").matches;
      var current = 0;
      var timer = null;
      var auto = !phone;
      root.classList.add("cover--js");
      // The numbered headlines are printed as links; with the script they are the tabs of the stage.
      list.setAttribute("role", "tablist");
      list.setAttribute("aria-label", "اختر الخبر");
      for (var n = 0; n < tabs.length; n++) {
        tabs[n].setAttribute("role", "tab");
        tabs[n].setAttribute("aria-controls", "cover-slide-" + n);
      }

      function show(i) {
        i = (i + slides.length) % slides.length;
        for (var k = 0; k < slides.length; k++) {
          var on = k === i;
          slides[k].hidden = !on;
          tabs[k].classList.toggle("is-on", on);
          tabs[k].setAttribute("aria-selected", on ? "true" : "false");
          // One tab stop for the five headlines; the arrow keys move between them.
          tabs[k].setAttribute("tabindex", on ? "0" : "-1");
        }
        current = i;
        warm((i + 1) % slides.length);
      }
      // The next story's picture is fetched a turn ahead, never on a phone, where the stage does not turn.
      function warm(i) {
        if (phone) return;
        var img = slides[i].querySelector("img");
        if (!img || img.getAttribute("data-warm")) return;
        img.setAttribute("data-warm", "1");
        var pre = new Image();
        if (img.sizes) pre.sizes = img.sizes;
        if (img.srcset) pre.srcset = img.srcset;
        pre.src = img.currentSrc || img.src;
      }
      // The stories keep the height of the tallest, so neither the tabs nor anything under the cover moves
      // when it turns (the stage's own least height, the row's, is in the stylesheet: the photograph fills
      // the stage beside a tall readings column). Each hidden story is laid out for a moment (unseen, its
      // picture not fetched) to be measured.
      function fit() {
        if (phone || !box) return;
        box.style.minHeight = "";
        var tallest = 0;
        for (var k = 0; k < slides.length; k++) {
          var s = slides[k];
          var was = s.hidden;
          if (was) { s.style.visibility = "hidden"; s.hidden = false; }
          tallest = Math.max(tallest, s.getBoundingClientRect().height);
          if (was) { s.hidden = true; s.style.visibility = ""; }
        }
        if (tallest) box.style.minHeight = Math.ceil(tallest) + "px";
      }
      // The reader is on the cover: the pointer is over it, keyboard focus is inside it (focus left by a
      // mouse click on a tab does not count, so the minute's rest after a click still ends), or the tab
      // is not being looked at. Every turn checks it, so the cover never changes under the reader even
      // where a focus event never arrives.
      function reading() {
        if (document.hidden || root.matches(":hover")) return true;
        try { return Boolean(root.querySelector(":focus-visible")); } catch (e) { return root.contains(document.activeElement); }
      }
      function start() {
        if (!auto || timer) return;
        timer = setInterval(function () { if (!reading()) show(current + 1); }, interval);
        root.classList.add("is-running");
      }
      function stop() {
        if (timer) { clearInterval(timer); timer = null; }
        root.classList.remove("is-running");
      }
      // A click on a tab hands control to the reader for a while; the rotation resumes after a minute away.
      var resumeAt = 0;
      function takeControl() {
        stop();
        resumeAt = Date.now() + 60000;
      }

      for (var t = 0; t < tabs.length; t++) {
        tabs[t].addEventListener("click", function (e) {
          // With a modifier key the headline is the link it is printed as: the story opens in a new tab or window.
          if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
          e.preventDefault();
          takeControl();
          show(Number(this.getAttribute("data-index")));
        });
        tabs[t].addEventListener("keydown", function (e) {
          var i = Number(this.getAttribute("data-index"));
          var next;
          if (e.key === "ArrowLeft") next = i + 1;
          else if (e.key === "ArrowRight") next = i - 1;
          else if (e.key === "Home") next = 0;
          else if (e.key === "End") next = slides.length - 1;
          else if (e.key === " ") next = i;
          else return;
          e.preventDefault();
          takeControl();
          show(next);
          tabs[current].focus();
        });
      }
      // Never turn under the reader: not under the pointer, not while keyboard focus is inside the
      // cover, not in a tab nobody is looking at. (Until 2026-09-22 the five-second check below
      // restarted it with focus inside, and it turned in background tabs.)
      function resume() {
        if (!auto || Date.now() < resumeAt || reading()) return;
        start();
      }
      root.addEventListener("mouseenter", stop);
      root.addEventListener("mouseleave", resume);
      root.addEventListener("focusin", stop);
      root.addEventListener("focusout", function (e) { if (!root.contains(e.relatedTarget)) resume(); });
      document.addEventListener("visibilitychange", function () { if (document.hidden) stop(); else resume(); });
      setInterval(resume, 5000);

      show(0);
      fit();
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
      var resizing;
      window.addEventListener("resize", function () { clearTimeout(resizing); resizing = setTimeout(fit, 150); });
      start();
    }
  })();
</script>

<style>
  .cover { display: grid; grid-template-columns: minmax(0, 9fr) minmax(0, 3fr); column-gap: 0; padding-top: clamp(1.1rem, 2.5vw, 1.75rem); padding-bottom: clamp(1.25rem, 2.5vw, 1.75rem); border-bottom: 3px solid var(--ink); align-items: start; }

  /* The stage is at least the row's height (the readings beside it may be taller); the stories take what the tabs
     under them leave, so the photograph fills the stage. */
  .cover__stage { padding-inline-end: var(--col-gap); display: grid; grid-template-rows: 1fr auto; min-height: 100%; }
  .cover__slides { display: grid; }
  /* Headline and photograph share the stage 5 to 7: at 4 to 8 the 40px headline wrapped five lines deep in a 286px column. */
  .cover__slide { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 0 clamp(1.25rem, 3vw, 2.5rem); align-items: stretch; grid-area: 1 / 1; }
  /* The photograph fills the stage's height, so no paper is left bare beside a short headline, but it
     never turns portrait: between 3:2 and square, measured on its own width. Stretched to the old
     740px column it showed half of every picture (the airport slide was mostly ceiling). */
  .cover__photo { order: 2; display: block; text-decoration: none; container-type: inline-size; }
  .cover__photo :global(.photo) { aspect-ratio: auto !important; height: 100%; min-height: 66.667cqi; max-height: 100cqi; }
  /* The headline hangs from the photograph's top edge, as it does on the printed page; centred beside
     a tall picture it started 80px lower and its dek fell under a laptop's fold. */
  .cover__body { order: 1; align-self: start; }
  .cover__slide[hidden] { display: none; }
  .cover--js .cover__slide:not([hidden]) { animation: cover-in 0.4s var(--ease-out); }
  @keyframes cover-in { from { opacity: 0; } }
  .cover__slide--text { grid-template-columns: 1fr; }
  .cover__slide--text .cover__body { max-width: 56rem; padding-block: 1.5rem; }
  .cover__title { font-family: var(--font-title); font-weight: 700; font-size: var(--t-cover); line-height: 1.28; }
  .cover__title a { text-decoration: none; }
  .cover__title a:hover { color: var(--green); }
  .cover__dek { font-family: var(--font-body); font-size: var(--n-lead); line-height: 1.7; color: var(--ink-2); margin-top: 0.55rem; max-width: 34em; }
  .cover__meta { margin-top: 0.6rem; }
  /* ذات صلة: two headlines on the story's running topic under a hairline, filling the text column that
     otherwise stood short of the photograph beside it. */
  .cover__related { margin-top: 1rem; border-top: 1px solid var(--rule); padding-top: 0.55rem; max-width: 34em; }
  .cover__related-head { font-weight: 700; font-size: var(--fs-xs); color: var(--green); margin-bottom: 0.15rem; }
  .cover__related li { padding-block: 0.35rem; }
  .cover__related li + li { border-top: 1px solid var(--rule); }
  .cover__related a { font-family: var(--font-title); font-weight: 700; font-size: var(--t-list); line-height: 1.45; text-decoration: none; }
  .cover__related a:hover { color: var(--green); }

  /* The four stories behind the lead, listed under it on a phone, where the stage does not turn. */
  .cover__more { display: none; }

  /* The tabs: the five headlines numbered in ruled columns under the stage, as a daily's site runs the stories behind
     its lead. The one on the stage carries a green rule over it and its number in green; the others stay in the
     page's ink, a step quieter. The number opens the headline's first line, so the lines under it keep the column's
     whole width (in a column of its own it cut three of five headlines at three lines); four lines at most, the
     whole headline being on the stage once it is chosen. Nothing changes size between the states, so the row never
     moves as the stage turns. */
  .cover__tabs { display: grid; grid-template-columns: repeat(var(--tabs, 5), minmax(0, 1fr)); margin-top: 1.1rem; border-top: 1px solid var(--rule); }
  .cover__tab { position: relative; display: block; padding: 0.7rem 0.85rem 0.15rem; color: var(--ink-2); text-decoration: none; }
  .cover__tab:first-child { padding-inline-start: 0; }
  .cover__tab:last-child { padding-inline-end: 0; }
  .cover__tab + .cover__tab { border-inline-start: 1px solid var(--rule); }
  .cover__tab::before { content: ""; position: absolute; inset-inline: 0; top: -2px; height: 3px; background: transparent; }
  .cover__tab.is-on::before { background: var(--green); }
  .cover__tab-num { font-size: 1.4em; line-height: 1; margin-inline-end: 0.3rem; color: var(--ink-3); }
  .cover__tab.is-on .cover__tab-num { color: var(--green); }
  .cover__tab-title { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; line-clamp: 4; overflow: hidden; font-family: var(--font-title); font-weight: 700; font-size: var(--t-list); line-height: 1.45; }
  .cover__tab.is-on .cover__tab-title { color: var(--ink); }
  .cover__tab:hover .cover__tab-title { color: var(--green); }
  .cover__tab:focus-visible { outline-offset: -2px; }

  /* The paper's readings beside the stage: one of each kind, the analysis a step larger, each
     with its dek so the column reads as three different things, not a list. */
  .cover__beside { display: grid; align-content: start; border-inline-start: 1px solid var(--rule); padding-inline-start: var(--col-gap); }
  .cover__readings { display: grid; align-content: start; }
  .cover__reading { padding-block: 0.65rem; border-top: 1px solid var(--rule); }
  .cover__reading:first-child { border-top: 0; padding-top: 0; }
  .cover__reading-title { font-family: var(--font-title); font-weight: 700; font-size: var(--t-list); line-height: 1.45; }
  .cover__reading--lead .cover__reading-title { font-size: var(--t-head); line-height: 1.38; }
  .cover__reading-title a { text-decoration: none; }
  .cover__reading-title a:hover { color: var(--green); }
  .cover__reading-dek { font-family: var(--font-body); font-size: var(--n-text); line-height: 1.65; color: var(--ink-2); margin-top: 0.25rem; }
  .cover__reading .meta { margin-top: 0.15rem; font-size: var(--fs-xs); }
  .cover__reading .kicker { margin-bottom: 0.1rem; }

  /* Below 1200px the beside column would be too narrow to sit level with the stage, so the cover
     runs in one column and the readings become a ruled band of three under it. */
  @media (max-width: 1199px) {
    .cover { grid-template-columns: 1fr; row-gap: 1.25rem; }
    .cover__stage { padding-inline-end: 0; }
    .cover__tab { padding-inline: 0.6rem; }
    .cover__beside { border-inline-start: 0; padding-inline-start: 0; padding-top: 0.25rem; }
    .cover__readings { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 0; }
    .cover__reading { padding: 0 var(--col-gap); border-top: 0; }
    .cover__reading:first-child { padding-inline-start: 0; }
    .cover__reading:last-child { padding-inline-end: 0; }
    .cover__reading + .cover__reading { border-inline-start: 1px solid var(--rule); }
  }
  @media (max-width: 719px) {
    .cover__slide { grid-template-columns: 1fr; gap: 0.6rem 0; align-items: start; }
    .cover__photo { order: 1; container-type: normal; }
    .cover__body { order: 2; }
    .cover__tabs { display: none; }
    .cover__related { display: none; }
    .cover__photo :global(.photo) { aspect-ratio: 3 / 2 !important; height: auto; min-height: 0; max-height: none; }
    .cover__more { display: grid; margin-top: 1rem; border-top: 1px solid var(--ink); }
    .cover__more > :global(.card) { padding-block: 0.75rem; border-top: 1px solid var(--rule); }
    .cover__more > :global(.card:first-child) { border-top: 0; }
    .cover__readings { grid-template-columns: 1fr; }
    .cover__reading { padding: 0.65rem 0; }
    .cover__reading + .cover__reading { border-inline-start: 0; border-top: 1px solid var(--rule); }
    .cover__reading:first-child { padding-top: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cover--js .cover__slide:not([hidden]) { animation: none; }
  }
</style>
