---
import { isolateNumbers } from "@lib/bidi";

interface TableSpec {
  title?: string | null;
  source?: string;
  columns: string[];
  rows: string[][];
}
interface Props {
  table: TableSpec;
}
const { table } = Astro.props;
const numeric = (cell: string) => /^[+\-−]?\d[\d.,]*\s?[%٪]?$/.test(cell.trim());
// Short row heads (a date, a year, a ticker) stay on one line: on a phone «7 سبتمبر» broke into two (2026-09-24).
const shortHeads = table.rows.every((row) => String(row[0] ?? "").trim().length <= 14);
// A table compiled from Khazendar's own stories («في العمق»'s timeline) says so once, not "Khazendar, from its source".
const own = /^خازندار/.test(String(table.source ?? "").trim());
---

<figure class="dtable">
  {table.title && <figcaption class="dtable__title" set:html={isolateNumbers(table.title)} />}
  <div class="dtable__scroll">
    <table>
      <thead>
        <tr>
          {table.columns.map((c) => <th scope="col" set:html={isolateNumbers(c)} />)}
        </tr>
      </thead>
      <tbody>
        {table.rows.map((row) => (
          <tr>
            {row.map((cell, ci) =>
              ci === 0 ? <th scope="row" class={shortHeads ? "short" : undefined} set:html={isolateNumbers(cell)} /> : <td class={numeric(cell) ? "num" : ""} set:html={isolateNumbers(cell)} />,
            )}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="dtable__source ui">{own ? "المصدر: تقارير خازندار المنشورة." : `${table.source ? `المصدر: ${table.source}. ` : ""}الجدول من إعداد خازندار اعتماداً على أرقام المصدر.`}</p>
</figure>

<style>
  .dtable { margin: 1.5rem 0 1.75rem; max-width: var(--measure); }
  .dtable__title { font-family: var(--font-title); font-weight: 700; font-size: 1.18rem; line-height: 1.4; margin-bottom: 0.5rem; }
  .dtable__scroll { overflow-x: auto; border-top: 3px solid var(--ink); }
  table { width: 100%; border-collapse: collapse; font-family: var(--font-ui); font-size: 0.92rem; }
  th, td { padding: 0.5rem 0.6rem; border-bottom: 1px solid var(--rule); text-align: start; vertical-align: top; }
  thead th { font-weight: 700; color: var(--ink); border-bottom: 1px solid var(--ink); }
  tbody th { font-weight: 700; }
  tbody th.short { white-space: nowrap; }
  td.num { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .dtable__source { margin-top: 0.5rem; font-size: var(--fs-xs); color: var(--ink-3); }
</style>
