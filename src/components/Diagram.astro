---
/**
 * A lesson's textbook figure (pipeline/lib/lesson.mjs), drawn by the site from the writer's labels, never generated:
 *
 * - supply_demand: price on the vertical axis, quantity on the horizontal, as every textbook draws it; a supply curve
 *   (ع) and a demand curve (ط) with one mechanism: a curve shifting or both (1 before, 2 after, the prices and
 *   quantities read off the axes as س1، س2، ك1، ك2), a price floor or ceiling and the gap it opens, or a tax or a
 *   subsidy between what buyers pay and sellers keep, the trades it costs shaded;
 * - schedule: rows of prices and quantities plotted, the equilibrium computed by code, the table under the drawing;
 * - curve: one of the field's named curves (Laffer, Phillips, the production frontier, Lorenz, Kuznets, diminishing
 *   returns, the yield curve, the J-curve, prospect theory's value curve);
 * - flows: what flows into something (from the reader's right) and out of it, each bar as long as its value, and the net;
 * - chain: two to five steps of cause and effect, read right to left.
 *
 * The geometry of the first three is src/lib/figures.mjs, which the pipeline's self-test holds to the economics. The
 * owner, 2026-11-08: the section should read "like economics textbooks with graphs, mathematics and everything (but
 * simplified for everyone to understand)"; 2026-11-20, of the floors, wedges and curves it could not draw: "or you have
 * not really try to make it happen?".
 */
import { isolateNumbers } from "@lib/bidi";
import { VIEW, drawFigure } from "@lib/figures.mjs";

interface Props {
  diagram: any;
}
const { diagram } = Astro.props;

function fmt(v: number): string {
  return v.toLocaleString("en-US", { maximumFractionDigits: 2 }).replace(/^-/, "−");
}

// The graph templates: what figures.mjs returns, drawn as SVG below.
const drawn = drawFigure(diagram);
type Item = { k: string; [key: string]: any };
const items: Item[] = drawn?.items ?? [];
const pts = (points: [number, number][]) => points.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" ");
const sch = diagram.type === "schedule" ? diagram : null;

// Flows: each bar as long as its value against the largest.
const fl = diagram.type === "flows" ? diagram : null;
const maxFlow = fl ? Math.max(...fl.inflows.map((f: any) => f.value), ...fl.outflows.map((f: any) => f.value), 1) : 1;
const width = (v: number) => `${Math.max(6, (v / maxFlow) * 100).toFixed(1)}%`;
const withUnit = (v: number) => (fl?.unit ? `${fmt(v)} ${fl.unit}` : fmt(v));
---

<figure class="diagram" aria-labelledby="diagram-title">
  <p class="diagram__kicker ui">شكل توضيحي</p>
  {/* Every printed label goes through isolateNumbers(), as the values do: after Arabic letters a plain «2025-2026»
      reads as two Arabic-context numbers around a neutral dash and is drawn «2026-2025» (the fourth test lesson's label,
      2026-11-08). */}
  <h2 id="diagram-title" class="diagram__title" set:html={isolateNumbers(diagram.title)} />

  {drawn && (
    <>
      <svg class="fig" viewBox={`0 0 ${VIEW.width} ${VIEW.height}`} role="img" aria-label={drawn.summary}>
        <defs>
          <marker id="fig-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" fill="var(--ink-3)" />
          </marker>
          <marker id="fig-green" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" fill="var(--green)" />
          </marker>
        </defs>
        {items.map((it) =>
          it.k === "line" ? (
            <line
              x1={it.x1} y1={it.y1} x2={it.x2} y2={it.y2}
              class={it.cls}
              stroke={it.color}
              stroke-dasharray={it.dash ? "9 7" : undefined}
              marker-end={it.arrow ? `url(#${it.cls === "fig__axis" ? "fig-arrow" : "fig-green"})` : undefined}
              marker-start={it.both ? `url(#${it.cls === "fig__axis" ? "fig-arrow" : "fig-green"})` : undefined}
            />
          ) : it.k === "path" ? (
            <path d={it.d} class={it.cls} stroke={it.color} fill="none" stroke-dasharray={it.dash ? "9 7" : undefined} />
          ) : it.k === "poly" ? (
            <polygon points={pts(it.points)} class={it.cls} />
          ) : it.k === "dot" ? (
            <circle cx={it.x} cy={it.y} r={it.small ? 3.5 : 5.5} fill={it.color ?? "var(--ink)"} stroke="var(--paper)" stroke-width={it.small ? 1.5 : 2} />
          ) : (
            <text x={it.x} y={it.y} text-anchor={it.anchor} class={it.cls} fill={it.color} direction="ltr">{it.text}</text>
          ),
        )}
      </svg>
      <ul class="diagram__key ui">
        {drawn.key.map((k: any) => (
          <li>
            {k.color && <span class:list={["diagram__swatch", { "diagram__swatch--dashed": k.dashed }]} style={`--swatch: ${k.color}`} />}
            {k.control && <span class="diagram__swatch diagram__swatch--control" />}
            {k.wedge && <span class="diagram__swatch diagram__swatch--wedge" />}
            {k.lost && <span class="diagram__swatch diagram__swatch--lost" />}
            <span set:html={isolateNumbers(k.text)} />
          </li>
        ))}
      </ul>
      {sch && (
        <table class="diagram__table ui">
          <thead>
            <tr><th set:html={isolateNumbers(sch.priceUnit ? `${sch.price} (${sch.priceUnit})` : sch.price)} /><th>الكمية المطلوبة</th><th>الكمية المعروضة</th></tr>
          </thead>
          <tbody>
            {sch.rows.map((r: any) => (
              <tr><td set:html={isolateNumbers(fmt(r.price))} /><td set:html={isolateNumbers(fmt(r.demand))} /><td set:html={isolateNumbers(fmt(r.supply))} /></tr>
            ))}
          </tbody>
        </table>
      )}
      {sch?.hypothetical && <p class="diagram__note ui">أرقام تقريبية للتوضيح، لا أرقام فعلية.</p>}
    </>
  )}

  {fl && (
    <div class="flows">
      <div class="flows__side">
        <p class="flows__head ui">يدخل</p>
        {fl.inflows.map((f: any) => (
          <div class="flows__item">
            <span class="flows__label" set:html={isolateNumbers(f.label)} />
            <span class="flows__track"><span class="flows__bar flows__bar--in" style={`width:${width(f.value)}`} /></span>
            <span class="flows__value" set:html={isolateNumbers(withUnit(f.value))} />
          </div>
        ))}
      </div>
      <div class="flows__center" aria-label={`${fl.center}: الفرق ${fmt(fl.net)}`}>
        <span class="flows__name" set:html={isolateNumbers(fl.center)} />
        <span class="flows__net" set:html={isolateNumbers(`${fl.net > 0 ? "+" : ""}${withUnit(fl.net)}`)} />
        {/* «الفرق», never «الصافي»: the figure shows the flows the lesson names, not every flow, so its difference is not a
            balance's net (the first test lesson's critic set 0.7 against the year's overall surplus of 2.8, 2026-11-08). */}
        <span class="flows__net-label ui">الفرق</span>
      </div>
      <div class="flows__side">
        <p class="flows__head ui">يخرج</p>
        {fl.outflows.map((f: any) => (
          <div class="flows__item">
            <span class="flows__label" set:html={isolateNumbers(f.label)} />
            <span class="flows__track"><span class="flows__bar flows__bar--out" style={`width:${width(f.value)}`} /></span>
            <span class="flows__value" set:html={isolateNumbers(withUnit(f.value))} />
          </div>
        ))}
      </div>
    </div>
  )}

  {diagram.type === "chain" && (
    <ol class:list={["chain", { "chain--long": diagram.steps.length > 3 }]}>
      {diagram.steps.map((s: string, i: number) => (
        <li class="chain__step"><span class="chain__n ui">{i + 1}</span><span class="chain__text" set:html={isolateNumbers(s)} /></li>
      ))}
    </ol>
  )}

  {diagram.caption && <figcaption class="diagram__caption" set:html={isolateNumbers(diagram.caption)} />}
</figure>

<style>
  .diagram { margin: 1.5rem 0 1.75rem; max-width: var(--measure); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--rule); padding: 0.8rem 0 0.9rem; }
  .diagram__kicker { font-size: var(--fs-xs); font-weight: 700; color: var(--green); }
  .diagram__title { margin-top: 0.2rem; font-family: var(--font-title); font-weight: 700; font-size: var(--t-head); line-height: 1.4; }
  .diagram__caption { margin-top: 0.7rem; font-family: var(--font-body); font-size: var(--n-text); line-height: 1.7; color: var(--ink-2); }
  .diagram__key { display: flex; flex-wrap: wrap; gap: 0.3rem 1.2rem; margin: 0.4rem 0 0; padding: 0; list-style: none; font-size: var(--fs-sm); color: var(--ink-2); }
  .diagram__key li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .diagram__swatch { width: 0.75rem; height: 0.2rem; display: inline-block; background: var(--swatch, var(--ink)); }

  /* The graphs, in the drawing's units (as the charts' text: about 13px on screen at the article's width). */
  .fig { width: 100%; height: auto; margin-top: 0.6rem; font-family: var(--font-ui); overflow: visible; }
  .fig :global(.fig__axis) { stroke: var(--ink-3); stroke-width: 1.5; }
  .fig :global(.fig__axis-name) { fill: var(--ink-2); font-size: 16px; font-weight: 500; }
  .fig :global(.fig__guide) { stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 3 4; }
  .fig :global(.fig__guide--strong) { stroke-width: 1.4; stroke-dasharray: 6 5; }
  .fig :global(.fig__tick) { fill: var(--ink-2); font-size: 15px; font-weight: 500; }
  .fig :global(.fig__tick--soft) { fill: var(--ink-3); font-size: 13px; }
  .fig :global(.fig__tick--eq) { fill: var(--green); font-weight: 700; }
  .fig :global(.fig__curve) { font-size: 17px; font-weight: 700; }
  .fig :global(.fig__line) { stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .fig :global(.fig__shift) { stroke: var(--green); stroke-width: 2.5; }
  .fig :global(.fig__control) { stroke: var(--green); stroke-width: 2.5; }
  .fig :global(.fig__control-name) { fill: var(--green); font-size: 15px; font-weight: 700; }
  .fig :global(.fig__gap) { stroke: var(--green); stroke-width: 2; }
  .fig :global(.fig__gap-name) { fill: var(--green); font-size: 15px; font-weight: 700; }
  .fig :global(.fig__wedge) { stroke: var(--green); stroke-width: 6; stroke-linecap: butt; }
  .fig :global(.fig__lost) { fill: var(--green); fill-opacity: 0.16; stroke: none; }
  .fig :global(.fig__shade) { fill: var(--chart-1); fill-opacity: 0.12; stroke: none; }
  .fig :global(.fig__rise) { stroke: var(--green); stroke-width: 2.5; }
  .fig :global(.fig__mark) { fill: var(--ink); font-size: 14px; font-weight: 700; }
  @media (max-width: 719px) {
    .fig :global(.fig__axis-name) { font-size: 24px; }
    .fig :global(.fig__tick) { font-size: 21px; }
    .fig :global(.fig__tick--soft) { font-size: 19px; }
    .fig :global(.fig__curve) { font-size: 26px; }
    .fig :global(.fig__control-name), .fig :global(.fig__gap-name) { font-size: 21px; }
    .fig :global(.fig__mark) { font-size: 20px; }
  }
  .diagram__swatch--dashed { background: repeating-linear-gradient(to left, var(--swatch) 0 4px, transparent 4px 7px) !important; }
  .diagram__swatch--control { background: var(--green); height: 0.22rem; }
  .diagram__swatch--wedge { background: var(--green); width: 0.3rem; height: 0.9rem; }
  .diagram__swatch--lost { background: color-mix(in srgb, var(--green) 22%, transparent); width: 0.85rem; height: 0.7rem; }
  .diagram__table { width: 100%; margin-top: 0.7rem; border-collapse: collapse; font-size: var(--fs-sm); }
  .diagram__table th, .diagram__table td { padding: 0.3rem 0.5rem; border-bottom: 1px solid var(--rule); text-align: start; font-variant-numeric: tabular-nums lining-nums; }
  .diagram__table th { font-weight: 700; color: var(--ink-2); border-bottom-color: var(--ink-3); }
  .diagram__note { margin-top: 0.4rem; font-size: var(--fs-xs); color: var(--ink-3); }

  /* Flows: in from the reader's right, out to the left, the net in the middle. */
  .flows { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 1rem; margin-top: 0.9rem; }
  .flows__head { font-size: var(--fs-xs); font-weight: 700; color: var(--ink-3); }
  .flows__item { display: grid; gap: 0.2rem; margin-top: 0.55rem; }
  .flows__label { font-family: var(--font-ui); font-size: var(--fs-sm); line-height: 1.4; color: var(--ink); }
  .flows__track { display: block; height: 0.8rem; }
  .flows__bar { display: block; height: 100%; }
  .flows__bar--in { background: var(--chart-1); }
  .flows__bar--out { background: var(--chart-2); }
  .flows__value { font-family: var(--font-ui); font-size: var(--fs-sm); font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums lining-nums; }
  .flows__center { display: grid; justify-items: center; gap: 0.15rem; padding: 0.7rem 0.9rem; border: 1px solid var(--ink); text-align: center; min-width: 8rem; }
  .flows__name { font-family: var(--font-title); font-weight: 700; font-size: var(--t-list); line-height: 1.35; }
  .flows__net { font-family: var(--font-title); font-weight: 700; font-size: var(--t-feature); color: var(--green); font-variant-numeric: tabular-nums lining-nums; }
  .flows__net-label { font-size: var(--fs-xs); color: var(--ink-3); }
  @media (max-width: 599px) {
    .flows { grid-template-columns: 1fr; }
    .flows__center { justify-self: stretch; }
  }

  /* A chain of cause and effect, right to left, each step's number in the house green. */
  .chain { display: flex; flex-wrap: wrap; align-items: stretch; gap: 0.6rem 1.8rem; margin: 0.9rem 0 0; padding: 0; list-style: none; }
  .chain__step { position: relative; display: flex; align-items: center; gap: 0.5rem; flex: 1 1 8rem; padding: 0.55rem 0.7rem; border: 1px solid var(--rule); background: var(--paper-2); }
  .chain__step:not(:last-child)::after { content: "←"; position: absolute; inset-inline-end: -1.45rem; top: 50%; transform: translateY(-50%); font-family: var(--font-ui); font-size: var(--fs-sm); font-weight: 700; color: var(--green); }
  .chain__n { flex: none; font-weight: 700; color: var(--green); }
  .chain__text { font-family: var(--font-ui); font-size: var(--fs-sm); line-height: 1.45; color: var(--ink); }
  /* Four or five steps run top to bottom: in a row the fifth wrapped to a line of its own, its arrow lost (2026-11-08). */
  .chain--long { flex-direction: column; gap: 1.4rem; }
  .chain--long .chain__step { flex: none; }
  .chain--long .chain__step:not(:last-child)::after { content: "↓"; inset-inline-end: auto; inset-inline-start: 50%; top: auto; bottom: -1.3rem; transform: translateX(50%); }
  @media (max-width: 599px) {
    .chain { flex-direction: column; gap: 1.4rem; }
    .chain__step { flex: none; }
    .chain__step:not(:last-child)::after { content: "↓"; inset-inline-end: auto; inset-inline-start: 50%; top: auto; bottom: -1.3rem; transform: translateX(50%); }
  }
</style>
