---
/**
 * An explainer's textbook figure (pipeline/lib/lesson.mjs), drawn by the site from the writer's labels, never generated:
 *
 * - supply_demand: price on the vertical axis, quantity on the horizontal, as every textbook draws it; a supply curve
 *   (ع) and a demand curve (ط), one of them shifting (1 before, 2 after), and the price and quantity before and after
 *   (س1، س2، ك1، ك2) read off the axes, with a key under the drawing;
 * - flows: what flows into something (from the reader's right) and out of it, each bar as long as its value, and the net;
 * - chain: two to five steps of cause and effect, read right to left.
 *
 * The owner, 2026-11-08: the section should read "like economics textbooks with graphs, mathematics and everything (but
 * simplified for everyone to understand)".
 */
import { isolateNumbers } from "@lib/bidi";

interface Flow {
  label: string;
  value: number;
}
type DiagramSpec =
  | { type: "supply_demand"; title: string; caption?: string; price: string; quantity: string; supply: string; demand: string; shift: "demand_up" | "demand_down" | "supply_up" | "supply_down" }
  | { type: "flows"; title: string; caption?: string; center: string; unit?: string; inflows: Flow[]; outflows: Flow[]; net: number }
  | { type: "chain"; title: string; caption?: string; steps: string[] };
interface Props {
  diagram: DiagramSpec;
}
const { diagram } = Astro.props;

function fmt(v: number): string {
  return v.toLocaleString("en-US", { maximumFractionDigits: 2 }).replace(/^-/, "−");
}

// Supply and demand: two straight lines in a 640 × 420 drawing, the origin at (80, 350).
type Pt = [number, number];
type Seg = [Pt, Pt];
const S: Seg = [[200, 320], [480, 80]];
const D: Seg = [[200, 80], [480, 320]];
const move = (seg: Seg, dx: number): Seg => [[seg[0][0] + dx, seg[0][1]], [seg[1][0] + dx, seg[1][1]]];
function cross(p: Seg, q: Seg): Pt {
  const [[x1, y1], [x2, y2]] = p;
  const [[x3, y3], [x4, y4]] = q;
  const den = (x1 - x2) * (y3 - y4) - (y1 - y2) * (x3 - x4);
  const a = x1 * y2 - y1 * x2;
  const b = x3 * y4 - y3 * x4;
  return [(a * (x3 - x4) - (x1 - x2) * b) / den, (a * (y3 - y4) - (y1 - y2) * b) / den];
}
const sd = diagram.type === "supply_demand" ? diagram : null;
// Far enough apart that the marks before and after (س1، س2، ك1، ك2) never crowd, even at a phone's text size.
const SHIFT = 100;
const demandMoves = sd ? sd.shift.startsWith("demand") : false;
const dx = sd ? (sd.shift.endsWith("_up") ? SHIFT : -SHIFT) : 0;
const S2 = sd && !demandMoves ? move(S, dx) : S;
const D2 = sd && demandMoves ? move(D, dx) : D;
const E1 = cross(S, D);
const E2 = cross(S2, D2);
/** The point of a line at height y: where the shift arrow starts and ends. */
const atY = (seg: Seg, y: number): number => seg[0][0] + ((y - seg[0][1]) * (seg[1][0] - seg[0][0])) / (seg[1][1] - seg[0][1]);
const arrowY = 112;
const from = demandMoves ? atY(D, arrowY) : atY(S, arrowY);
const to = demandMoves ? atY(D2, arrowY) : atY(S2, arrowY);
const dir = Math.sign(to - from);
// A curve's name at its far end: above a high end, beside a low one (below it would sit on the quantity axis).
const label = (seg: Seg, name: string) => (seg[1][1] < 200 ? { x: seg[1][0], y: seg[1][1] - 14, name } : { x: seg[1][0] + 22, y: seg[1][1] + 6, name });
const curves = sd
  ? [
      { seg: S, color: "var(--chart-1)", dashed: false, ...label(S, demandMoves ? "ع" : "ع1") },
      ...(demandMoves ? [] : [{ seg: S2, color: "var(--chart-1)", dashed: true, ...label(S2, "ع2") }]),
      { seg: D, color: "var(--chart-2)", dashed: false, ...label(D, demandMoves ? "ط1" : "ط") },
      ...(demandMoves ? [{ seg: D2, color: "var(--chart-2)", dashed: true, ...label(D2, "ط2") }] : []),
    ]
  : [];
const sdSummary = sd
  ? `${sd.title}: ${demandMoves ? sd.demand : sd.supply} ${sd.shift.endsWith("_up") ? "يزيد" : "ينقص"}، فينتقل ${sd.price} من س1 إلى س2 و${sd.quantity} من ك1 إلى ك2.`
  : "";

// Flows: each bar as long as its value against the largest.
const fl = diagram.type === "flows" ? diagram : null;
const maxFlow = fl ? Math.max(...fl.inflows.map((f) => f.value), ...fl.outflows.map((f) => f.value), 1) : 1;
const width = (v: number) => `${Math.max(6, (v / maxFlow) * 100).toFixed(1)}%`;
const withUnit = (v: number) => (fl?.unit ? `${fmt(v)} ${fl.unit}` : fmt(v));
---

<figure class="diagram" aria-labelledby="diagram-title">
  <p class="diagram__kicker ui">شكل توضيحي</p>
  {/* Every printed label goes through isolateNumbers(), as the values do: after Arabic letters a plain «2025-2026»
      reads as two Arabic-context numbers around a neutral dash and is drawn «2026-2025» (the fourth test lesson's label,
      2026-11-08). */}
  <h2 id="diagram-title" class="diagram__title" set:html={isolateNumbers(diagram.title)} />

  {sd && (
    <>
      <svg class="sd" viewBox="0 0 640 410" role="img" aria-label={sdSummary}>
        <defs>
          <marker id="sd-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" fill="var(--ink-3)" />
          </marker>
          <marker id="sd-shift" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" fill="var(--green)" />
          </marker>
        </defs>
        {/* The axes: price up, quantity to the right, from the origin. */}
        <line x1="80" y1="350" x2="80" y2="34" class="sd__axis" marker-end="url(#sd-arrow)" />
        <line x1="80" y1="350" x2="612" y2="350" class="sd__axis" marker-end="url(#sd-arrow)" />
        {/* The axis names start and end inside the drawing: centred on the axis, they ran past its edges on a phone. */}
        <text x="80" y="22" class="sd__axis-name" text-anchor="start" direction="ltr">{sd.price}</text>
        <text x="612" y="398" class="sd__axis-name" text-anchor="end" direction="ltr">{sd.quantity}</text>
        {/* The price and quantity before (1) and after (2), read off the axes. */}
        {[E1, E2].map(([x, y], i) => (
          <g class="sd__guide">
            <line x1="80" y1={y} x2={x} y2={y} />
            <line x1={x} y1={y} x2={x} y2="350" />
            <text x="72" y={y} dy="0.35em" text-anchor="end" class="sd__tick">{`س${i + 1}`}</text>
            <text x={x} y="372" text-anchor="middle" class="sd__tick">{`ك${i + 1}`}</text>
          </g>
        ))}
        {curves.map((c) => (
          <g>
            <line x1={c.seg[0][0]} y1={c.seg[0][1]} x2={c.seg[1][0]} y2={c.seg[1][1]} stroke={c.color} stroke-width="3" stroke-linecap="round" stroke-dasharray={c.dashed ? "9 7" : undefined} />
            <text x={c.x} y={c.y} text-anchor="middle" class="sd__curve" fill={c.color}>{c.name}</text>
          </g>
        ))}
        <line x1={from + dir * 6} y1={arrowY} x2={to - dir * 8} y2={arrowY} class="sd__shift" marker-end="url(#sd-shift)" />
        {[E1, E2].map(([x, y]) => (
          <circle cx={x} cy={y} r="5.5" fill="var(--ink)" stroke="var(--paper)" stroke-width="2" />
        ))}
      </svg>
      <ul class="diagram__key ui">
        <li><span class="diagram__swatch" style="background: var(--chart-1)" />ع: {sd.supply}</li>
        <li><span class="diagram__swatch" style="background: var(--chart-2)" />ط: {sd.demand}</li>
        <li>1 قبل، 2 بعد</li>
      </ul>
    </>
  )}

  {fl && (
    <div class="flows">
      <div class="flows__side">
        <p class="flows__head ui">يدخل</p>
        {fl.inflows.map((f) => (
          <div class="flows__item">
            <span class="flows__label" set:html={isolateNumbers(f.label)} />
            <span class="flows__track"><span class="flows__bar flows__bar--in" style={`width:${width(f.value)}`} /></span>
            <span class="flows__value" set:html={isolateNumbers(withUnit(f.value))} />
          </div>
        ))}
      </div>
      <div class="flows__center" aria-label={`${fl.center}: الفرق ${fmt(fl.net)}`}>
        <span class="flows__name" set:html={isolateNumbers(fl.center)} />
        <span class="flows__net" set:html={isolateNumbers(`${fl.net > 0 ? "+" : ""}${withUnit(fl.net)}`)} />
        {/* «الفرق», never «الصافي»: the figure shows the flows the lesson names, not every flow, so its difference is not a
            balance's net (the first test lesson's critic set 0.7 against the year's overall surplus of 2.8, 2026-11-08). */}
        <span class="flows__net-label ui">الفرق</span>
      </div>
      <div class="flows__side">
        <p class="flows__head ui">يخرج</p>
        {fl.outflows.map((f) => (
          <div class="flows__item">
            <span class="flows__label" set:html={isolateNumbers(f.label)} />
            <span class="flows__track"><span class="flows__bar flows__bar--out" style={`width:${width(f.value)}`} /></span>
            <span class="flows__value" set:html={isolateNumbers(withUnit(f.value))} />
          </div>
        ))}
      </div>
    </div>
  )}

  {diagram.type === "chain" && (
    <ol class:list={["chain", { "chain--long": diagram.steps.length > 3 }]}>
      {diagram.steps.map((s, i) => (
        <li class="chain__step"><span class="chain__n ui">{i + 1}</span><span class="chain__text" set:html={isolateNumbers(s)} /></li>
      ))}
    </ol>
  )}

  {diagram.caption && <figcaption class="diagram__caption" set:html={isolateNumbers(diagram.caption)} />}
</figure>

<style>
  .diagram { margin: 1.5rem 0 1.75rem; max-width: var(--measure); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--rule); padding: 0.8rem 0 0.9rem; }
  .diagram__kicker { font-size: var(--fs-xs); font-weight: 700; color: var(--green); }
  .diagram__title { margin-top: 0.2rem; font-family: var(--font-title); font-weight: 700; font-size: var(--t-head); line-height: 1.4; }
  .diagram__caption { margin-top: 0.7rem; font-family: var(--font-body); font-size: var(--n-text); line-height: 1.7; color: var(--ink-2); }
  .diagram__key { display: flex; flex-wrap: wrap; gap: 0.3rem 1.2rem; margin: 0.4rem 0 0; padding: 0; list-style: none; font-size: var(--fs-sm); color: var(--ink-2); }
  .diagram__key li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .diagram__swatch { width: 0.75rem; height: 0.2rem; display: inline-block; }

  /* Supply and demand, in the drawing's units (as the charts' text: about 13px on screen at the article's width). */
  .sd { width: 100%; height: auto; margin-top: 0.6rem; font-family: var(--font-ui); }
  .sd__axis { stroke: var(--ink-3); stroke-width: 1.5; }
  .sd__axis-name { fill: var(--ink-2); font-size: 16px; font-weight: 500; }
  .sd__guide line { stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 3 4; }
  .sd__tick { fill: var(--ink-2); font-size: 15px; font-weight: 500; }
  .sd__curve { font-size: 17px; font-weight: 700; }
  .sd__shift { stroke: var(--green); stroke-width: 2.5; }
  @media (max-width: 719px) {
    .sd__axis-name { font-size: 24px; }
    .sd__tick { font-size: 21px; }
    .sd__curve { font-size: 26px; }
  }

  /* Flows: in from the reader's right, out to the left, the net in the middle. */
  .flows { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 1rem; margin-top: 0.9rem; }
  .flows__head { font-size: var(--fs-xs); font-weight: 700; color: var(--ink-3); }
  .flows__item { display: grid; gap: 0.2rem; margin-top: 0.55rem; }
  .flows__label { font-family: var(--font-ui); font-size: var(--fs-sm); line-height: 1.4; color: var(--ink); }
  .flows__track { display: block; height: 0.8rem; }
  .flows__bar { display: block; height: 100%; }
  .flows__bar--in { background: var(--chart-1); }
  .flows__bar--out { background: var(--chart-2); }
  .flows__value { font-family: var(--font-ui); font-size: var(--fs-sm); font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums lining-nums; }
  .flows__center { display: grid; justify-items: center; gap: 0.15rem; padding: 0.7rem 0.9rem; border: 1px solid var(--ink); text-align: center; min-width: 8rem; }
  .flows__name { font-family: var(--font-title); font-weight: 700; font-size: var(--t-list); line-height: 1.35; }
  .flows__net { font-family: var(--font-title); font-weight: 700; font-size: var(--t-feature); color: var(--green); font-variant-numeric: tabular-nums lining-nums; }
  .flows__net-label { font-size: var(--fs-xs); color: var(--ink-3); }
  @media (max-width: 599px) {
    .flows { grid-template-columns: 1fr; }
    .flows__center { justify-self: stretch; }
  }

  /* A chain of cause and effect, right to left, each step's number in the house green. */
  .chain { display: flex; flex-wrap: wrap; align-items: stretch; gap: 0.6rem 1.8rem; margin: 0.9rem 0 0; padding: 0; list-style: none; }
  .chain__step { position: relative; display: flex; align-items: center; gap: 0.5rem; flex: 1 1 8rem; padding: 0.55rem 0.7rem; border: 1px solid var(--rule); background: var(--paper-2); }
  .chain__step:not(:last-child)::after { content: "←"; position: absolute; inset-inline-end: -1.45rem; top: 50%; transform: translateY(-50%); font-family: var(--font-ui); font-size: var(--fs-sm); font-weight: 700; color: var(--green); }
  .chain__n { flex: none; font-weight: 700; color: var(--green); }
  .chain__text { font-family: var(--font-ui); font-size: var(--fs-sm); line-height: 1.45; color: var(--ink); }
  /* Four or five steps run top to bottom: in a row the fifth wrapped to a line of its own, its arrow lost (2026-11-08). */
  .chain--long { flex-direction: column; gap: 1.4rem; }
  .chain--long .chain__step { flex: none; }
  .chain--long .chain__step:not(:last-child)::after { content: "↓"; inset-inline-end: auto; inset-inline-start: 50%; top: auto; bottom: -1.3rem; transform: translateX(50%); }
  @media (max-width: 599px) {
    .chain { flex-direction: column; gap: 1.4rem; }
    .chain__step { flex: none; }
    .chain__step:not(:last-child)::after { content: "↓"; inset-inline-end: auto; inset-inline-start: 50%; top: auto; bottom: -1.3rem; transform: translateX(50%); }
  }
</style>
