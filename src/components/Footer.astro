---
import site from "@data/site.json";
import { sections, sectionHref } from "@lib/sections";
import Logo from "./Logo.astro";
const year = new Date().getUTCFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="rule--double" aria-hidden="true"></div>
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="footer__logo" href="/" aria-label={`${site.name} — الصفحة الرئيسية`}>
          <Logo part="lockup" height={56} />
        </a>
        <p class="footer__tagline">{site.tagline}</p>
        <p class="footer__note">
          صحيفة اقتصادية عربية تُكتب آلياً عدة مرات في اليوم من بيانات رسمية وتقارير موثوقة، ويُدقّق كل مقال ببرنامج مراجعة مستقل قبل نشره. كل مقال يعرض مصادره ليتمكن القارئ من التحقق بنفسه.
        </p>
      </div>
      <nav class="footer__col" aria-label="الأقسام">
        <h2 class="module__head">الأقسام</h2>
        <ul>
          {sections.map((s) => (
            <li><a href={sectionHref(s.id)}>{s.name}</a></li>
          ))}
        </ul>
      </nav>
      <nav class="footer__col" aria-label="عن الموقع">
        <h2 class="module__head">خازندار</h2>
        <ul>
          <li><a href="/about/">عن خازندار</a></li>
          <li><a href="/methodology/">المصادر والمنهجية</a></li>
          <li><a href="/privacy/">سياسة الخصوصية</a></li>
          <li><a href="/search/">بحث</a></li>
          <li>
            <a href="/rss.xml" class="footer__rss">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="19" r="2.4" /><path d="M3 10.5a10.5 10.5 0 0 1 10.5 10.5h-3A7.5 7.5 0 0 0 3 13.5zM3 3.5A17.5 17.5 0 0 1 20.5 21h-3A14.5 14.5 0 0 0 3 6.5z" /></svg>
              خلاصة RSS
            </a>
          </li>
          {site.contactEmail && <li><a href={`mailto:${site.contactEmail}`}>تواصل معنا</a></li>}
        </ul>
      </nav>
    </div>
    <div class="footer__bottom ui">
      <p>© <bdi>{year}</bdi> {site.name}. النصوص أصلية ومنسوبة إلى مصادرها؛ الصور من ويكيميديا كومنز برخص مفتوحة مع ذكر المصوّر.</p>
      <p>قد تقع أخطاء رغم التدقيق. عند الشك، يُعتدّ بالمصدر الأصلي المذكور في المقال.</p>
    </div>
  </div>
</footer>

<style>
  .footer { margin-top: clamp(2.5rem, 6vw, 4.5rem); padding-bottom: 1.5rem; color: var(--ink); }
  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-block: clamp(1.5rem, 3.5vw, 2.5rem) 1.5rem;
  }
  .footer__logo { display: inline-flex; align-items: center; gap: 0.7rem; color: var(--green); text-decoration: none; }
  /* Amiri 700, not 400: the regular weight is a 125 kB download and the tagline was its only
     site-wide user, so it now loads solely on the rare article that carries a blockquote. */
  .footer__tagline { font-family: var(--font-title); font-weight: 700; font-size: 1.02rem; margin-top: 0.4rem; color: var(--ink-2); }
  .footer__note { margin-top: 0.75rem; font-size: 0.98rem; line-height: 1.8; max-width: 34rem; color: var(--ink-2); }
  .footer__col li { margin-block: 0.25rem; }
  .footer__col a { font-family: var(--font-body); font-size: 1rem; text-decoration: none; color: var(--ink-2); }
  .footer__col a:hover { color: var(--green); text-decoration: underline; }
  .footer__rss { display: inline-flex; align-items: center; gap: 0.35rem; }
  .footer__bottom { border-top: 1px solid var(--rule); padding-top: 0.9rem; font-size: 0.8rem; line-height: 1.6; color: var(--ink-3); display: grid; gap: 0.2rem; }
  @media (max-width: 719px) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
    .footer__brand { grid-column: 1 / -1; }
  }
</style>
