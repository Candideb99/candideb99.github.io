---
/**
 * The front page under the cover, laid out like a newsroom's site: three ruled columns: the day's
 * digest at the start (الأخبار في سطور: one sentence per story, the way the Journal's What's News
 * runs), two secondary stories over the editor's picks in the centre, and the day's chart and
 * figures at the end.
 */
import type { Article } from "@lib/articles";
import { articleHref } from "@lib/articles";
import { kindLabel, sectionHref } from "@lib/sections";
import { isolateNumbers } from "@lib/bidi";
import { excerpt, timeAgo } from "@lib/format";
import StoryCard from "./StoryCard.astro";
import Chart from "./Chart.astro";
import Agenda from "./Agenda.astro";

interface Figure {
  label: string;
  value: string;
  article: Article;
}
interface Props {
  secondary: Article[];
  /** The digest: one sentence per story, newest first. */
  digest: Article[];
  picks: Article[];
  figures: Figure[];
  chart?: Article;
  /** Ids of the stories allowed to show their picture here (the first appearance of each picture). */
  photoIds: Set<string>;
}
const { secondary, digest, picks, figures, chart, photoIds } = Astro.props;
---

<section class="wrap front" aria-label="أبرز ما في العدد">
  <div class="front__top">
    <h2 class="module__head">الأخبار في سطور</h2>
    <ul class="digest">
      {digest.map((a) => (
        <li class="digest__item">
          <a class="digest__text" href={articleHref(a)}><strong class="digest__head" set:html={isolateNumbers(a.data.title)} /> <span set:html={isolateNumbers(excerpt(a.data.subtitle || a.data.lede, 140))} /></a>
          <p class="meta digest__meta">
            <a href={sectionHref(a.data.section)}>{kindLabel(a.data.kind, a.data.section)}</a>
            <time datetime={a.data.publishedAt} data-relative>{timeAgo(a.data.publishedAt)}</time>
          </p>
        </li>
      ))}
    </ul>
  </div>

  <div class="front__mid">
    {secondary.length > 0 && (
      <div class="front__secondary">
        {secondary.map((a) => (
          <StoryCard article={a} variant="card" showExcerpt showTopic showPhoto={photoIds.has(a.id)} />
        ))}
      </div>
    )}
    {picks.length > 0 && (
      <section class="module front__picks" aria-labelledby="picks-head">
        <h2 id="picks-head" class="module__head">مختارات المحرر</h2>
        <ol class="picks">
          {picks.map((a) => (
            <li class="picks__item">
              <a class="picks__title" href={articleHref(a)} set:html={isolateNumbers(a.data.title)} />
              <p class="meta"><a href={sectionHref(a.data.section)}>{kindLabel(a.data.kind, a.data.section)}</a></p>
            </li>
          ))}
        </ol>
      </section>
    )}
  </div>

  <aside class="front__side">
    {chart?.data.chart && (
      <section class="module" aria-labelledby="chart-head">
        <h2 id="chart-head" class="module__head">أحدث الرسوم البيانية</h2>
        <Chart chart={chart.data.chart} id="front-chart" compact href={articleHref(chart)} />
        <p class="module__from ui">من مادة: <a href={articleHref(chart)} set:html={isolateNumbers(chart.data.title)} /></p>
      </section>
    )}
    {figures.length > 0 && (
      <section class="module figures" aria-labelledby="figures-head">
        <h2 id="figures-head" class="module__head">أرقام اليوم</h2>
        <ul class="figures__list">
          {figures.map((f) => (
            <li class="figures__item">
              <a href={articleHref(f.article)}>
                <span class="figures__value" set:html={isolateNumbers(f.value)} />
                <span class="figures__label" set:html={isolateNumbers(f.label)} />
                <span class="figures__story" set:html={isolateNumbers(f.article.data.title)} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <Agenda limit={5} />
  </aside>
</section>

<style>
  .front {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr);
    column-gap: 0;
    padding-top: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
  }
  .front__top { padding-inline-end: var(--col-gap); }
  .front__mid { padding-inline: var(--col-gap); border-inline: 1px solid var(--rule); }
  .front__side { padding-inline-start: var(--col-gap); display: grid; gap: 1.5rem; }

  /* The digest: a sentence a story on hairlines, Naskh at text size, the section and time beneath. */
  .digest { display: grid; }
  .digest__item { padding-block: 0.6rem; border-top: 1px solid var(--rule); }
  .digest__item:first-child { border-top: 0; padding-top: 0.1rem; }
  .digest__text { display: block; font-family: var(--font-body); font-size: 1.02rem; line-height: 1.7; color: var(--ink); text-decoration: none; }
  .digest__text:hover .digest__head { color: var(--green); }
  .digest__head { font-family: var(--font-title); font-weight: 700; }
  .digest__meta { margin-top: 0.15rem; font-size: 0.78rem; }

  /* The two secondaries run at feature scale, photograph beside the text like every feature on the
     page, so the hierarchy keeps descending down the page instead of inverting under the cover. */
  .front__secondary { display: grid; }
  .front__secondary > :global(.card) { padding-block: 0.85rem; border-top: 1px solid var(--rule); }
  .front__secondary > :global(.card:first-child) { border-top: 0; padding-top: 0; }
  .front__secondary > :global(.card--photo) { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 0 var(--col-gap); align-items: start; }
  .front__secondary :global(.card--photo .card__photo) { order: 2; }
  .front__secondary :global(.card--photo .card__body) { order: 1; }
  .front__secondary :global(.card__title) { font-size: clamp(1.2rem, 1rem + 0.6vw, 1.42rem); line-height: 1.38; }
  .front__picks { margin-top: 1.4rem; }

  .figures__list { display: grid; }
  .figures__item { border-top: 1px solid var(--rule); }
  .figures__item:first-child { border-top: 0; }
  .figures__item a { display: block; padding-block: 0.5rem; text-decoration: none; }
  .figures__item a:hover .figures__value { color: var(--green); }
  .figures__value { display: block; font-family: var(--font-title); font-weight: 700; font-size: 1.25rem; line-height: 1.3; font-variant-numeric: tabular-nums lining-nums; }
  .figures__label { display: block; font-family: var(--font-ui); font-size: 0.82rem; color: var(--ink-3); line-height: 1.4; }
  /* A number without its story is a riddle: the headline it comes from follows, small. */
  .figures__story { display: block; margin-top: 0.2rem; font-family: var(--font-title); font-weight: 700; font-size: 0.9rem; line-height: 1.4; color: var(--ink-2); }
  .figures__item a:hover .figures__story { color: var(--green); }
  .module__from { margin-top: 0.45rem; font-size: 0.8rem; color: var(--ink-3); line-height: 1.5; }
  .module__from a { color: var(--ink-2); text-decoration: none; font-weight: 700; }
  .module__from a:hover { color: var(--green); text-decoration: underline; }

  .picks { display: grid; }
  .picks__item { padding-block: 0.55rem; border-top: 1px solid var(--rule); }
  .picks__item:first-child { border-top: 0; }
  .picks__title { font-family: var(--font-title); font-weight: 700; font-size: 1.02rem; line-height: 1.45; text-decoration: none; display: block; }
  .picks__title:hover { color: var(--green); }
  .picks .meta { margin-top: 0.1rem; font-size: 0.78rem; }

  @media (max-width: 1023px) {
    .front { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .front__secondary { grid-template-columns: 1fr 1fr; column-gap: var(--col-gap); }
    .front__secondary > :global(.card) { border-top: 0; padding-block: 0; }
    .front__mid { grid-column: 1 / -1; order: -1; padding-inline: 0; border-inline: 0; padding-bottom: 1.1rem; margin-bottom: 1.1rem; border-bottom: 1px solid var(--rule); }
    .front__top { padding-inline-end: var(--col-gap); border-inline-end: 1px solid var(--rule); }
  }
  @media (max-width: 719px) {
    .front { grid-template-columns: 1fr; }
    .front__top { padding-inline-end: 0; border-inline-end: 0; }
    .front__side { padding-inline-start: 0; margin-top: 1.5rem; }
    .front__secondary { grid-template-columns: 1fr; }
    .front__secondary > :global(.card) { padding-block: 0.7rem; border-top: 1px solid var(--rule); }
    .front__secondary > :global(.card:first-child) { border-top: 0; padding-top: 0; }
    .front__secondary > :global(.card--photo) { grid-template-columns: 7.5rem minmax(0, 1fr); gap: 0 0.75rem; }
    .front__secondary :global(.card--photo .card__photo) { order: 1; }
    .front__secondary :global(.card--photo .card__body) { order: 2; }
    .front__secondary :global(.card__title) { font-size: 1.2rem; line-height: 1.4; }
    .front__secondary :global(.card__summary) { display: none; }
  }
</style>
