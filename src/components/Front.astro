---
/**
 * The front page under the cover, laid out like a newsroom's site: three ruled columns: the day's
 * digest at the start (الأخبار في سطور: one sentence per story, the way the Journal's What's News
 * runs), two secondary stories over the top stories' list in the centre, and at the end the agenda, the day's
 * chart and its figures. The market box went on 2026-10-19 (the owner's choice: the market strip under the bar is the
 * site's one price line, and the box repeated five of its eight instruments); the agenda took its place and the
 * columns came out level.
 */
import type { Article } from "@lib/articles";
import { articleHref } from "@lib/articles";
import { kindLabel, sectionHref } from "@lib/sections";
import { headline, isolateNumbers } from "@lib/bidi";
import { timeAgo } from "@lib/format";
import StoryCard from "./StoryCard.astro";
import Chart from "./Chart.astro";
import Agenda from "./Agenda.astro";

interface Figure {
  label: string;
  value: string;
  article: Article;
}
interface Props {
  secondary: Article[];
  /** The digest: one sentence per story, newest first. */
  digest: Article[];
  figures: Figure[];
  chart?: Article;
  /** Ids of the stories allowed to show their picture here (the first appearance of each picture). */
  photoIds: Set<string>;
}
// «أرقام اليوم» is empty while «بالأرقام», the band of figure cards, runs under this block (index.astro, 2026-11-21).
const { secondary, digest, figures, chart, photoIds } = Astro.props;
---

<section class="wrap front" aria-label="آخر الأخبار والأرقام">
  <div class="front__top">
    <h2 class="module__head">الأخبار في سطور</h2>
    <ul class="digest">
      {digest.map((a) => (
        <li class="digest__item">
          <a class="digest__head" href={articleHref(a)} set:html={headline(a.data.title)} />
          <p class="meta digest__meta">
            <a href={sectionHref(a.data.section)}>{kindLabel(a.data.kind, a.data.section)}</a>
            <time datetime={a.data.publishedAt} data-relative>{timeAgo(a.data.publishedAt)}</time>
          </p>
        </li>
      ))}
    </ul>
  </div>

  <div class="front__mid">
    {secondary.length > 0 && (
      <div class="front__secondary">
        {secondary.map((a) => (
          <StoryCard article={a} variant="card" showExcerpt showTopic showPhoto={photoIds.has(a.id)} sizes="(min-width: 1320px) 460px, (min-width: 1024px) 36vw, (min-width: 720px) 48vw, 120px" />
        ))}
      </div>
    )}
  </div>

  <aside class="front__side">
    {/* Without «أرقام اليوم» (it rests while «بالأرقام» runs) the column ended 324px above the centre one at 1366px
        (2026-11-21): the agenda then lists eight dates, not five. */}
    <Agenda limit={figures.length > 0 ? 5 : 8} />
    {/* Above the chart since 2026-11-21 (the owner: "is this todays numbers section easy to notice or easy to miss?"): it
        had stood last in the column, 1,888px down at 1366px, each figure in ink at 20px over a bold 17px headline, so
        the list read as three more headlines. The figure is now the house green at the feature size and its story's
        headline a line of reading text under it. */}
    {figures.length > 0 && (
      <section class="module figures" aria-labelledby="figures-head">
        <h2 id="figures-head" class="module__head">أرقام اليوم</h2>
        <ul class="figures__list">
          {figures.map((f) => (
            <li class="figures__item">
              <a href={articleHref(f.article)}>
                <span class="figures__value" set:html={isolateNumbers(f.value)} />
                <span class="figures__label" set:html={isolateNumbers(f.label)} />
                <span class="figures__story" set:html={isolateNumbers(f.article.data.title)} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    {chart?.data.chart && (
      <section class="module" aria-labelledby="chart-head">
        <h2 id="chart-head" class="module__head">بالرسم البياني</h2>
        <Chart chart={chart.data.chart} id="front-chart" narrow href={`${articleHref(chart)}#story-chart`} />
        <p class="module__from"><span class="module__from-label ui">من مادة</span><a href={articleHref(chart)} set:html={isolateNumbers(chart.data.title)} /></p>
      </section>
    )}
  </aside>
</section>

<style>
  .front {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr);
    column-gap: 0;
    padding-top: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
  }
  .front__top { padding-inline-end: var(--col-gap); }
  .front__mid { padding-inline: var(--col-gap); border-inline: 1px solid var(--rule); }
  .front__side { padding-inline-start: var(--col-gap); display: grid; gap: 1.5rem; }
  /* The agenda closes the digest's column: at the foot of the numbers column it left that column 400px longer than
     the other two, over blank paper (2026-09-27). */

  /* «الأخبار في سطور»: a story to a line on hairlines, its Amiri headline with the section and age beneath, and no
     sentence since 2026-11-21 (index.astro has why). The headline is the link and its hit area covers the item. */
  .digest { display: grid; }
  .digest__item { position: relative; padding-block: 0.65rem; border-top: 1px solid var(--rule); }
  .digest__item:first-child { border-top: 0; padding-top: 0.1rem; }
  .digest__head { display: block; font-family: var(--font-title); font-weight: 700; font-size: var(--t-list); line-height: 1.45; color: var(--ink); text-decoration: none; }
  .digest__head::after { content: ""; position: absolute; inset: 0; }
  .digest__item:hover .digest__head { color: var(--green); }
  .digest__meta { margin-top: 0.15rem; font-size: var(--fs-xs); }
  .digest__meta a { position: relative; z-index: 1; }

  /* The two secondaries run at feature scale with the photograph over the headline, the column's full width. Beside
     it (until 2026-09-27) the headline had a 190px column and wrapped four lines deep, and the centre column ended
     some 400px above its neighbours. */
  .front__secondary { display: grid; }
  .front__secondary > :global(.card) { padding-block: 0.85rem; border-top: 1px solid var(--rule); }
  .front__secondary > :global(.card:first-child) { border-top: 0; padding-top: 0; }
  .front__secondary :global(.card__title) { font-size: var(--t-feature); line-height: 1.38; }

  .figures__list { display: grid; }
  .figures__item { border-top: 1px solid var(--rule); }
  .figures__item:first-child { border-top: 0; }
  .figures__item a { display: block; padding-block: 0.5rem; text-decoration: none; }
  .figures__item a:hover .figures__value { color: var(--green-deep); }
  .figures__value { display: block; font-family: var(--font-title); font-weight: 700; font-size: var(--t-feature); line-height: 1.3; color: var(--green); font-variant-numeric: tabular-nums lining-nums; }
  .figures__label { display: block; font-family: var(--font-ui); font-size: var(--fs-sm); color: var(--ink-3); line-height: 1.4; }
  /* A number without its story is a riddle: the headline it comes from follows, in the reading face so the figure leads. */
  .figures__story { display: block; margin-top: 0.2rem; font-family: var(--font-body); font-size: var(--n-text); line-height: 1.6; color: var(--ink-2); }
  .figures__item a:hover .figures__story { color: var(--green); }


  @media (max-width: 1023px) {
    .front { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .front__secondary { grid-template-columns: 1fr 1fr; column-gap: var(--col-gap); }
    .front__secondary > :global(.card) { border-top: 0; padding-block: 0; }
    .front__mid { grid-column: 1 / -1; order: -1; padding-inline: 0; border-inline: 0; padding-bottom: 1.1rem; margin-bottom: 1.1rem; border-bottom: 1px solid var(--rule); }
    .front__top { padding-inline-end: var(--col-gap); border-inline-end: 1px solid var(--rule); }
  }
  @media (max-width: 719px) {
    .front { grid-template-columns: 1fr; }
    .front__top { padding-inline-end: 0; border-inline-end: 0; }
    .front__side { padding-inline-start: 0; margin-top: 1.5rem; }
    .front__secondary { grid-template-columns: 1fr; }
    .front__secondary > :global(.card) { padding-block: 0.7rem; border-top: 1px solid var(--rule); }
    .front__secondary > :global(.card:first-child) { border-top: 0; padding-top: 0; }
    .front__secondary > :global(.card--photo) { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 0 0.75rem; align-items: start; }
    .front__secondary :global(.card--photo .card__photo) { order: 1; }
    .front__secondary :global(.card--photo .card__body) { order: 2; }
    .front__secondary :global(.card__summary) { display: none; }
  }
</style>
