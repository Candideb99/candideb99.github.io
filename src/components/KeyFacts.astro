---
import { isolateNumbers } from "@lib/bidi";

interface Props {
  facts: { label: string; value: string }[];
  /** side: desktop rail only · inline: narrow screens only · always: no responsive hiding */
  placement?: "side" | "inline" | "always";
}
const { facts, placement = "always" } = Astro.props;
const headingId = `facts-${placement}`;
---

{facts.length > 0 && (
  <aside class={`facts facts--${placement}`} aria-labelledby={headingId}>
    <h2 id={headingId} class="module__head">الأرقام</h2>
    <dl class="facts__list">
      {facts.map((f) => (
        <div class="facts__item">
          <dd class="facts__value" set:html={isolateNumbers(f.value)} />
          {f.label && <dt class="facts__label">{f.label}</dt>}
        </div>
      ))}
    </dl>
  </aside>
)}

<style>
  .facts { border-bottom: 1px solid var(--rule); padding: 0 0 0.9rem; }
  .facts__list { margin: 0; display: grid; }
  .facts__item { display: flex; flex-direction: column; gap: 0.05rem; padding-block: 0.55rem; border-top: 1px solid var(--rule); }
  .facts__value {
    margin: 0;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 1.4rem;
    line-height: 1.25;
    color: var(--ink);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .facts__label { font-family: var(--font-ui); font-weight: 500; font-size: 0.86rem; color: var(--ink-3); line-height: 1.4; }
  .facts--inline { display: none; margin-bottom: 1.5rem; max-width: var(--measure); }
  .facts--inline .facts__list { grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); column-gap: 1rem; }
  @media (max-width: 1023px) {
    .facts--inline { display: block; }
    .facts--side { display: none; }
  }
</style>
