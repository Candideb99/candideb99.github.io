---
/** The issue's cover: the lead story lettered over its plate, with the contents beside it. */
import type { Article } from "@lib/articles";
import { articleHref } from "@lib/articles";
import { getSection, sectionHref } from "@lib/sections";
import { timeAgo } from "@lib/format";
import { isolateNumbers } from "@lib/bidi";
import Plate from "./Plate.astro";

interface Props {
  lead: Article;
  contents: Article[];
}
const { lead, contents } = Astro.props;
const sec = getSection(lead.data.section);
---

<section class="wrap issue" aria-labelledby="cover-title">
  <article class="cover" data-section={lead.data.section}>
    <a class="cover__link" href={articleHref(lead)}>
      <Plate article={lead} ratio="16/10" eager sizes="(min-width: 1024px) 66vw, 100vw" />
      <div class="cover__text">
        <h1 id="cover-title" class="cover__title" set:html={isolateNumbers(lead.data.title)} />
        {lead.data.subtitle && <p class="cover__dek" set:html={isolateNumbers(lead.data.subtitle)} />}
        <p class="cover__meta ui"><span>{sec.name}</span><time datetime={lead.data.publishedAt} data-relative>{timeAgo(lead.data.publishedAt)}</time></p>
      </div>
    </a>
  </article>

  <aside class="contents" aria-labelledby="contents-title">
    <h2 id="contents-title" class="contents__head">في هذا العدد</h2>
    <ol class="contents__list">
      {contents.map((a, i) => (
        <li class="contents__item" data-section={a.data.section}>
          <span class="contents__no ui" aria-hidden="true">{i + 1}</span>
          <div>
            <a class="contents__title" href={articleHref(a)} set:html={isolateNumbers(a.data.title)} />
            <p class="meta"><a href={sectionHref(a.data.section)}>{a.data.kind === "explainer" ? "شرح" : getSection(a.data.section).name}</a><time datetime={a.data.publishedAt} data-relative>{timeAgo(a.data.publishedAt)}</time></p>
          </div>
        </li>
      ))}
    </ol>
  </aside>
</section>

<style>
  .issue {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-block: clamp(1.25rem, 3vw, 2.25rem) 0;
    align-items: start;
  }
  .cover { position: relative; background: var(--spot); color: var(--on-spot); box-shadow: var(--shadow); }
  .cover__link { display: block; color: inherit; text-decoration: none; position: relative; }
  .cover__text {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    padding-top: 5rem;
    background: linear-gradient(to top, var(--spot-deep) 0, var(--spot-deep) calc(100% - 5rem), transparent 100%);
  }
  .cover__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 1.2rem + 2.3vw, 3rem);
    line-height: 1.4;
    color: var(--on-spot);
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.25);
  }
  .cover__dek {
    font-family: var(--font-title);
    font-weight: 400;
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.3rem);
    line-height: 1.6;
    margin-top: 0.6rem;
    max-width: 38rem;
    color: var(--on-spot);
    opacity: 0.94;
  }
  .cover__meta { display: flex; gap: 0.75rem; margin-top: 0.85rem; font-weight: 700; font-size: 0.9rem; color: var(--on-spot); opacity: 0.9; }
  .cover__meta time { color: inherit; opacity: 0.8; }
  .cover__link:hover .cover__title { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 0.12em; }

  .contents { border-top: 3px solid var(--ink); padding-top: 0.75rem; }
  .contents__head { font-family: var(--font-display); font-weight: 700; font-size: 1.75rem; line-height: 1.3; color: var(--ink); }
  .contents__list { margin-top: 0.9rem; display: grid; }
  .contents__item {
    display: grid;
    grid-template-columns: 2.1rem minmax(0, 1fr);
    gap: 0.6rem;
    padding-block: 0.75rem;
    border-top: 1px solid var(--rule);
  }
  .contents__item:first-child { border-top: 0; padding-top: 0.1rem; }
  .contents__no { font-weight: 800; font-size: 1.55rem; line-height: 1; color: var(--spot-ink); padding-top: 0.15rem; }
  .contents__title { font-family: var(--font-title); font-weight: 700; font-size: 1.22rem; line-height: 1.45; text-decoration: none; display: block; }
  .contents__title:hover { text-decoration: underline; text-decoration-color: var(--spot); text-decoration-thickness: 2px; }
  .contents .meta { margin-top: 0.25rem; font-size: 0.85rem; }

  @media (max-width: 1023px) {
    .issue { grid-template-columns: 1fr; }
  }
  @media (max-width: 719px) {
    .cover__text { position: static; padding: 1.1rem 1rem 1.25rem; background: var(--spot-deep); }
    .cover__title { font-size: clamp(1.7rem, 1.2rem + 3vw, 2.2rem); }
    .cover__dek { font-size: 1.05rem; }
  }
</style>
