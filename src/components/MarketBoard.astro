---
/**
 * A compact quote table under a module head: name (with its country or unit as a note), last,
 * and the move on the day. The `box` beside the cover lists five instruments and links to the
 * data page; the data page prints one `group` per market group.
 */
import { board, quotes, BOX_IDS, formatPrice, formatMove, direction, DIRECTION_LABEL, whenLabel, type Quote } from "@lib/markets";
import { timeAgo } from "@lib/format";

interface Props {
  variant?: "box" | "group";
  ids?: string[];
  title?: string;
  id?: string;
  level?: 2 | 3;
}
const { variant = "box", ids = BOX_IDS, title = "الأسواق", id, level = 2 } = Astro.props;
const items = quotes(ids);
const Head = `h${level}` as "h2" | "h3";
const headId = `${id ?? "board"}-head`;
const arrow = (d: string) => (d === "up" ? "▲" : d === "down" ? "▼" : "•");
const tip = (q: Quote) => `${q.name}${q.note ? ` (${q.note})` : ""}${q.unit && q.unit !== "%" ? `، ${q.unit}` : ""} · ${whenLabel(q)}`;
---

{items.length > 0 && (
  <section class={`board board--${variant}`} id={id} aria-labelledby={headId}>
    <Head id={headId} class="module__head">{title}</Head>
    <table class="board__table">
      <tbody>
        {items.map((q) => {
          const dir = direction(q);
          return (
            <tr class={q.stale ? "is-stale" : undefined} title={tip(q)}>
              <th scope="row" class="board__name">
                <span class="board__label">{q.name}</span>
                {variant === "group" && (q.note || (q.unit && q.unit !== "%")) && <span class="board__note ui">{[q.note, q.unit && q.unit !== "%" ? q.unit : null].filter(Boolean).join(" · ")}</span>}
              </th>
              <td class="board__num ui"><bdi>{formatPrice(q)}</bdi></td>
              <td class={`board__num ui board__move--${dir}`}>
                {dir === "none" ? (
                  <span class="board__na" title="لا يتوفر تغير اليوم">—</span>
                ) : (
                  <Fragment><span class="visually-hidden">{DIRECTION_LABEL[dir]}</span><bdi><span class="board__arrow" aria-hidden="true">{arrow(dir)}</span>{formatMove(q)}</bdi></Fragment>
                )}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
    {variant === "box" && (
      <p class="board__foot ui"><a href="/markets/data/">لوحة الأسواق كاملة</a>{board.updatedAt && <span> · حُدّثت <time datetime={board.updatedAt} data-relative>{timeAgo(board.updatedAt)}</time></span>}</p>
    )}
  </section>
)}

<style>
  .board__table { width: 100%; border-collapse: collapse; }
  .board__table th, .board__table td { padding: 0.3rem 0; border-top: 1px solid var(--rule); vertical-align: baseline; text-align: start; }
  .board__table tbody tr:first-child > * { border-top: 0; }
  .board__name { font-family: var(--font-body); font-weight: 700; font-size: 0.95rem; line-height: 1.45; color: var(--ink); }
  .board__note { display: block; font-size: 0.72rem; font-weight: 500; color: var(--ink-3); line-height: 1.35; }
  .board__num { text-align: end; font-size: 0.86rem; white-space: nowrap; padding-inline-start: 0.6rem !important; }
  .board__num bdi { direction: ltr; unicode-bidi: isolate; }
  .board__move--up { color: var(--up); font-weight: 700; }
  .board__move--down { color: var(--down); font-weight: 700; }
  .board__move--flat, .board__na { color: var(--ink-3); }
  .board__arrow { font-size: 0.6em; vertical-align: 0.15em; margin-inline-end: 0.15em; }
  .is-stale .board__num { color: var(--ink-3); }
  .board__foot { margin-top: 0.5rem; font-size: 0.78rem; line-height: 1.55; color: var(--ink-3); }
  .board__foot a { font-weight: 700; color: var(--ink-2); text-decoration: none; }
  .board__foot a:hover { color: var(--green); text-decoration: underline; }
  .board__foot time { color: inherit; }
  .board--group .module__head { font-size: 1.05rem; }
</style>
