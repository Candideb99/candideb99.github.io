---
/**
 * The market strip under the section bar, the way the business dailies' sites run theirs: nine
 * reference numbers, still, in the furniture face, each as its move on the day (the level is the
 * tooltip; a yield prints its level, which is the number that matters). Every item links to the board.
 */
import { board, quotes, STRIP_IDS, formatPrice, formatMove, direction, DIRECTION_LABEL } from "@lib/markets";
import { timeAgo } from "@lib/format";
const items = quotes(STRIP_IDS);
---

{items.length > 0 && (
  <div class="markets-wrap">
    <div class="wrap markets ui" role="region" aria-label="الأسواق">
      <a class="markets__label" href="/markets/data/">الأسواق</a>
      <ul class="markets__list">
        {items.map((q) => {
          const dir = direction(q);
          return (
            <li class="markets__item">
              <a class="q" href="/markets/data/" title={`${q.name}${q.note ? ` (${q.note})` : ""}: ${formatPrice(q)}`}>
                <span class="q__name">{q.short}</span>
                {(q.changeMode === "abs" || dir === "none") && <bdi class="q__price">{formatPrice(q)}</bdi>}
                {dir !== "none" && (
                  <span class="visually-hidden">{DIRECTION_LABEL[dir]}</span>
                )}
                {dir !== "none" && (
                  <bdi class={`q__move q__move--${dir}`}>
                    <span class="q__arrow" aria-hidden="true">{dir === "up" ? "▲" : dir === "down" ? "▼" : "•"}</span>
                    {formatMove(q)}
                  </bdi>
                )}
              </a>
            </li>
          );
        })}
      </ul>
      {board.updatedAt && (
        <p class="markets__time">حُدّث <time datetime={board.updatedAt} data-relative>{timeAgo(board.updatedAt)}</time></p>
      )}
    </div>
  </div>
)}

<style>
  .markets-wrap { border-bottom: 1px solid var(--rule); background: var(--paper); }
  .markets { display: flex; align-items: center; gap: 0.75rem; min-height: 2.1rem; }
  .markets__label { flex: none; font-weight: 800; font-size: 0.78rem; color: var(--green); text-decoration: none; padding-inline-end: 0.75rem; border-inline-end: 1px solid var(--rule); }
  .markets__label:hover { text-decoration: underline; }
  .markets__list { display: flex; align-items: center; flex: 1 1 auto; min-width: 0; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .markets__list::-webkit-scrollbar { display: none; }
  .markets__item { flex: none; padding-inline: 0.55rem; border-inline-start: 1px solid var(--rule); }
  .markets__item:first-child { padding-inline-start: 0; border-inline-start: 0; }
  .q { display: inline-flex; align-items: baseline; gap: 0.35rem; font-size: 0.78rem; line-height: 1.4; text-decoration: none; color: var(--ink-2); white-space: nowrap; }
  .q:hover .q__name { color: var(--green); text-decoration: underline; }
  .q__name { font-weight: 700; color: var(--ink); }
  .q__price { font-weight: 500; direction: ltr; unicode-bidi: isolate; }
  .q__move { font-weight: 700; direction: ltr; unicode-bidi: isolate; }
  .q__move--up { color: var(--up); }
  .q__move--down { color: var(--down); }
  .q__move--flat { color: var(--ink-3); }
  .q__arrow { font-size: 0.6em; vertical-align: 0.15em; margin-inline-end: 0.1em; }
  .markets__time { flex: none; font-size: 0.74rem; color: var(--ink-3); white-space: nowrap; padding-inline-start: 0.75rem; border-inline-start: 1px solid var(--rule); }
  .markets__time time { color: inherit; }
  @media (max-width: 719px) {
    .markets { gap: 0.6rem; min-height: 2rem; }
    .markets__time { display: none; }
  }
</style>
