---
import site from "@data/site.json";
import { sections, sectionHref } from "@lib/sections";
import { formatDate, issueNumber } from "@lib/format";

interface Props {
  active?: string;
}
const { active } = Astro.props;
const now = new Date();
const today = formatDate(now);
const issue = issueNumber(now);
---

<header class="masthead">
  <div class="band">
    <div class="wrap band__row">
      <p class="issue ui">
        <span class="issue__no">العدد <bdi data-issue-no>{issue}</bdi></span>
        <time datetime={now.toISOString().slice(0, 10)} data-issue-date data-launch={site.launchDate}>{today}</time>
      </p>
      <div class="brand">
        <a class="wordmark" href="/" aria-label={`${site.name} — الصفحة الرئيسية`}>{site.name}</a>
        <p class="tagline">{site.tagline}</p>
      </div>
      <a class="search ui" href="/search/">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.6-3.6" /></svg>
        <span>بحث</span>
      </a>
    </div>
  </div>
  <nav class="nav" aria-label="أقسام خازندار">
    <div class="wrap">
      <ul class="nav__list">
        <li><a href="/" class="nav__link" aria-current={active ? undefined : "page"}>الرئيسية</a></li>
        {sections.map((s) => (
          <li data-section={s.id}>
            <a href={sectionHref(s.id)} class="nav__link" aria-current={active === s.id ? "page" : undefined}>{s.name}</a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<style>
  .masthead { position: relative; z-index: 2; }
  .band { background: var(--saffron); color: #171512; }
  .band__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 1rem;
    padding-block: 1.1rem 0.9rem;
  }
  .issue {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.35;
    color: #171512;
  }
  .issue__no { font-weight: 800; }
  .issue time { color: #4a3a12; font-weight: 500; }
  .brand { text-align: center; }
  .wordmark {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3rem, 2.2rem + 3.8vw, 4.9rem);
    line-height: 1.15;
    text-decoration: none;
    color: #171512;
  }
  .wordmark:hover { text-decoration: none; }
  .tagline {
    font-family: var(--font-title);
    font-weight: 400;
    font-size: 1.15rem;
    line-height: 1.3;
    color: #4a3a12;
    margin-top: 0.1rem;
  }
  .search {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 800;
    font-size: 0.95rem;
    color: #171512;
    text-decoration: none;
    padding: 0.35rem 0.1rem;
    border-bottom: 2px solid transparent;
  }
  .search:hover, .search:focus-visible { border-bottom-color: #171512; }

  .nav { background: var(--paper); border-bottom: 1px solid var(--rule); }
  .nav__list {
    display: flex;
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .nav__list::-webkit-scrollbar { display: none; }
  @media (max-width: 719px) {
    .nav__list { mask-image: linear-gradient(to right, transparent 0, #000 2.5rem, #000 100%); -webkit-mask-image: linear-gradient(to right, transparent 0, #000 2.5rem, #000 100%); padding-inline-end: 2rem; }
  }
  .nav__link {
    display: block;
    padding: 0.85rem 0.95rem 0.7rem;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 1rem;
    white-space: nowrap;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 4px solid transparent;
    transition: border-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }
  .nav__link:hover, .nav__link:focus-visible { border-bottom-color: var(--spot); color: var(--spot-ink); }
  .nav__link[aria-current="page"] { border-bottom-color: var(--spot); color: var(--spot-ink); }
  li:first-child { --spot: #171512; --spot-ink: #171512; }
  @media (prefers-color-scheme: dark) { li:first-child { --spot: var(--saffron); --spot-ink: var(--saffron-ink); } }

  @media (max-width: 719px) {
    .band__row {
      grid-template-columns: 1fr 1fr;
      grid-template-areas: "brand brand" "issue search";
      align-items: center;
      padding-block: 0.9rem 0.7rem;
      row-gap: 0.5rem;
    }
    .brand { grid-area: brand; }
    .issue { grid-area: issue; flex-direction: row; flex-wrap: wrap; gap: 0.15rem 0.5rem; font-size: 0.82rem; }
    .issue__no, .issue time { white-space: nowrap; }
    .search { grid-area: search; font-size: 0.85rem; }
    .tagline { font-size: 0.95rem; }
    .nav__link { padding: 0.7rem 0.75rem 0.55rem; font-size: 0.95rem; }
  }
</style>
