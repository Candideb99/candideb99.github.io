---
/**
 * The masthead: the date line with the paper's standing tools (الأحدث، لوحة الأسواق، الأجندة، بحث),
 * the logo, and the green section bar. On a wide screen each section opens a panel under the bar,
 * as the business dailies' bars do: the section's standing sub-topics (a curated taxonomy in
 * `src/data/topics.json`, not the writers' tags), its analyses by desk, and the data and pages that
 * belong to it. The panel is sized to its content, never wider than the bar, hung from the bar's start
 * edge, and opens on hover only (a panel held open by keyboard focus used to sit over the section under
 * the pointer); it needs no script. Keyboard and touch readers get plain links and the same taxonomy on
 * the section pages.
 */
import site from "@data/site.json";
import { sections, sectionHref, newsSections } from "@lib/sections";
import { formatDate, issueNumber } from "@lib/format";
import { todayIso } from "@lib/calendar";
import { getArticles, articleHref } from "@lib/articles";
import { analysisDesk, ANALYSIS_DESKS } from "@lib/analysis";
import { topicsOf, topicHref } from "@lib/topics";
import { isolateNumbers } from "@lib/bidi";
import Logo from "./Logo.astro";

interface Props {
  active?: string;
}
const { active } = Astro.props;
const now = new Date();
const today = formatDate(now);
const issue = issueNumber(now);

const articles = await getArticles();
const analyses = articles.filter((a) => a.data.kind === "analysis" || a.data.kind === "weekly");
const newsIds = new Set(newsSections.map((s) => s.id));

interface Link {
  href: string;
  text: string;
  title?: boolean;
}
interface Column {
  head: string;
  links: Link[];
  wide?: boolean;
}
const DATA_LINKS: Record<string, Link[]> = {
  markets: [{ href: "/markets/data/", text: "لوحة الأسواق" }, { href: "/calendar/", text: "الأجندة الاقتصادية" }],
  economy: [{ href: "/calendar/", text: "الأجندة الاقتصادية" }],
  energy: [{ href: "/markets/data/#commodities", text: "أسعار النفط والغاز والمعادن" }],
  defense: [{ href: "/analysis/desk/defense/", text: "التحليل الدفاعي والجيوسياسي" }],
};
const panels = new Map<string, Column[]>();
for (const s of sections) {
  const columns: Column[] = [];
  if (newsIds.has(s.id)) {
    columns.push({ head: "المواضيع", links: topicsOf(s.id).map((t) => ({ href: topicHref(s.id, t.id), text: t.name })) });
    const pieces = analyses.filter((a) => analysisDesk(a, articles)?.id === s.id).slice(0, 3).map((a) => ({ href: articleHref(a), text: a.data.title, title: true }));
    if (pieces.length) columns.push({ head: "تحليلات القسم", links: [...pieces, { href: `/analysis/desk/${s.id}/`, text: "كل تحليلات القسم" }], wide: true });
    columns.push({ head: "المزيد", links: [{ href: sectionHref(s.id), text: `كل مواد ${s.name}` }, ...(DATA_LINKS[s.id] ?? [])] });
  } else if (s.id === "analysis") {
    columns.push({ head: "بحسب المجال", links: Object.entries(ANALYSIS_DESKS).map(([id, name]) => ({ href: `/analysis/desk/${id}/`, text: name })) });
    const pieces = analyses.slice(0, 4).map((a) => ({ href: articleHref(a), text: a.data.title, title: true }));
    if (pieces.length) columns.push({ head: "أحدث التحليلات", links: pieces, wide: true });
    columns.push({ head: "المزيد", links: [{ href: sectionHref(s.id), text: "كل التحليلات" }, { href: "/tags/", text: "الملفات التي نتابعها" }] });
  } else if (s.id === "explainers") {
    columns.push({ head: "الأنواع", links: [{ href: "/explainers/kind/concepts/", text: "شروح مبسّطة" }, { href: "/explainers/kind/papers/", text: "قراءات في أوراق بحثية" }] });
    const pieces = articles.filter((a) => a.data.kind === "explainer" || a.data.kind === "paper").slice(0, 4).map((a) => ({ href: articleHref(a), text: a.data.title, title: true }));
    if (pieces.length) columns.push({ head: "أحدث المواد", links: pieces, wide: true });
    columns.push({ head: "المزيد", links: [{ href: sectionHref(s.id), text: "كل المواد" }] });
  }
  if (columns.length) panels.set(s.id, columns);
}
---

<header class="masthead">
  <div class="wrap masthead__top ui">
    <p class="masthead__issue">
      <time datetime={todayIso(now)} data-issue-date data-launch={site.launchDate} data-zone={site.timeZone}>{today}</time>
      <span class="masthead__sep" aria-hidden="true">·</span>
      <span>العدد <bdi data-issue-no>{issue}</bdi></span>
    </p>
    <nav class="masthead__tools" aria-label="أدوات الصحيفة">
      <a href="/latest/">الأحدث</a>
      <a href="/markets/data/">لوحة الأسواق</a>
      <a href="/calendar/">الأجندة</a>
      <a class="masthead__search" href="/search/">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.6-3.6" /></svg>
        <span>بحث</span>
      </a>
    </nav>
  </div>

  <div class="wrap masthead__brand">
    <a class="brand" href="/" aria-label={`${site.name} — الصفحة الرئيسية`}>
      <Logo part="lockup" height={118} class="brand__lockup" eager />
    </a>
  </div>

  <nav class="masthead__nav" aria-label="أقسام خازندار">
    <div class="wrap masthead__nav-wrap">
      <ul class="nav">
        <li class="nav__item"><a href="/" class="nav__link" aria-current={active === "home" ? "page" : undefined}>الرئيسية</a></li>
        {sections.map((s) => {
          const columns = panels.get(s.id);
          return (
            <li class={`nav__item${columns ? " nav__item--panel" : ""}`}>
              <a href={sectionHref(s.id)} class="nav__link" aria-current={active === s.id ? "page" : undefined}>{s.name}</a>
              {columns && (
                <div class="nav__panel" role="group" aria-label={`قسم ${s.name}`}>
                  {columns.map((c) => (
                    <div class={`nav__col${c.wide ? " nav__col--wide" : ""}${c.links.length > 5 && !c.wide ? " nav__col--two" : ""}`}>
                      <p class="nav__head ui">{c.head}</p>
                      <ul>
                        {c.links.map((l) => (
                          <li class={l.title ? "nav__title" : undefined}><a href={l.href} set:html={isolateNumbers(l.text)} /></li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </nav>
</header>

<style>
  .masthead { position: relative; z-index: 2; background: var(--paper); }
  .masthead__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 0.5rem 0.4rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--ink-2);
  }
  .masthead__issue { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: baseline; }
  .masthead__issue time { color: inherit; }
  .masthead__sep { color: var(--ink-3); }
  .masthead__tools { display: flex; align-items: center; gap: 1.1rem; }
  .masthead__tools a { font-weight: 700; color: var(--ink-2); text-decoration: none; white-space: nowrap; }
  .masthead__tools a:hover, .masthead__tools a:focus-visible { color: var(--green); }
  .masthead__search { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--ink) !important; }
  .masthead__search:hover, .masthead__search:focus-visible { color: var(--green) !important; }

  .masthead__brand { display: flex; justify-content: center; padding-block: clamp(0.8rem, 2vw, 1.15rem); }
  .brand { display: block; min-width: 0; line-height: 0; }
  .brand:focus-visible { outline-offset: 4px; }

  /* The section bar: the one green field on the page. */
  .masthead__nav { background: #0f5c3c; }
  .masthead__nav-wrap { position: relative; }
  .nav {
    display: flex;
    justify-content: center;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .nav::-webkit-scrollbar { display: none; }
  .nav__link {
    display: block;
    padding: 0.62rem 1.1rem 0.5rem;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.4;
    white-space: nowrap;
    color: #fcfcf9;
    text-decoration: none;
    border-bottom: 3px solid transparent;
    transition: background 0.15s var(--ease-out);
  }
  .nav__link:hover, .nav__link:focus-visible { background: rgba(255, 255, 255, 0.12); }
  .nav__link:focus-visible { outline-color: #fcfcf9; outline-offset: -3px; }
  .nav__link[aria-current="page"] { border-bottom-color: #fcfcf9; background: rgba(255, 255, 255, 0.08); }

  /* The section panel: a paper box the size of its content, never wider than the bar, hung from the
     bar's start edge, ruled between its columns and closed by a 2px ink rule; only on a wide screen
     with a pointer that can hover, and on hover alone: a panel held open by keyboard focus used to sit
     over the section under the pointer. Elsewhere the bar scrolls and the sections are plain links. */
  .nav__panel { display: none; position: absolute; top: 100%; inset-inline-start: 0; z-index: 30; width: max-content; max-width: 100%; background: var(--paper); border: 1px solid var(--rule); border-top: 0; border-bottom: 2px solid var(--ink); padding: 1rem 0 1.1rem; }
  .nav__col { min-width: 11rem; padding-inline: 1.4rem; }
  .nav__col + .nav__col { border-inline-start: 1px solid var(--rule); }
  .nav__col--wide { max-width: 22rem; }
  .nav__col--two ul { columns: 2; column-gap: 1.4rem; }
  .nav__col--two li { break-inside: avoid; }
  .nav__head { font-weight: 800; font-size: 0.76rem; color: var(--green); margin-bottom: 0.45rem; }
  .nav__col li { padding-block: 0.16rem; }
  .nav__col a { font-family: var(--font-body); font-size: 0.96rem; line-height: 1.45; color: var(--ink-2); text-decoration: none; white-space: nowrap; }
  .nav__col .nav__title a { font-family: var(--font-title); font-weight: 700; font-size: 0.98rem; color: var(--ink); white-space: normal; display: block; padding-block: 0.1rem; }
  .nav__col a:hover, .nav__col a:focus-visible { color: var(--green); text-decoration: underline; }
  /* A two-column topic list may wrap its names when the panel is held to the bar's width. */
  .nav__col--two a { white-space: normal; }
  @media (min-width: 1024px) and (hover: hover) {
    .nav { overflow: visible; }
    .nav__item--panel:hover > .nav__link { background: var(--paper); color: var(--green); }
    .nav__item--panel:hover .nav__panel { display: flex; align-items: flex-start; }
  }

  @media (max-width: 719px) {
    .masthead__top { font-size: 0.78rem; }
    .masthead__tools { gap: 0.8rem; }
    .masthead__tools a:not(.masthead__search) { display: none; }
    .masthead__brand { padding-block: 0.7rem; }
    .brand :global(.brand__lockup img) { height: 72px; width: auto; }
    .nav { justify-content: flex-start; padding-inline-end: 1rem; }
    .nav__link { padding: 0.55rem 0.8rem 0.42rem; font-size: 0.92rem; }
  }
</style>
