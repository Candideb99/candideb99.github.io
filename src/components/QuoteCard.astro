---
/**
 * One instrument as a card: name, the level large, the move on the day, and a month of closes as
 * a small line, the way the Journal's market-data widget prints its indices. Used in the
 * الأسواق في لمحة band on the markets section and for the headline numbers of the data page.
 */
import { formatPrice, formatMove, direction, DIRECTION_LABEL, sparkline, whenLabel, type Quote } from "@lib/markets";

interface Props {
  quote: Quote;
  href?: string;
}
const { quote: q, href = "/markets/data/" } = Astro.props;
const dir = direction(q);
const spark = sparkline(q, 96, 28);
const stroke = dir === "up" ? "var(--up)" : dir === "down" ? "var(--down)" : "var(--ink-3)";
---

<a class={`quote quote--${dir}${q.stale ? " is-stale" : ""}`} href={href} title={`${q.name}${q.note ? ` (${q.note})` : ""} · ${whenLabel(q)}`}>
  <span class="quote__name">{q.name}</span>
  {q.note && <span class="quote__note ui">{q.unit && q.unit !== "%" ? `${q.note} · ${q.unit}` : q.note}</span>}
  {!q.note && q.unit && q.unit !== "%" && <span class="quote__note ui">{q.unit}</span>}
  <span class="quote__row">
    <bdi class="quote__price ui">{formatPrice(q)}</bdi>
    {dir !== "none" ? (
      <Fragment><span class="visually-hidden">{DIRECTION_LABEL[dir]}</span><bdi class="quote__move ui"><span class="quote__arrow mark-dir" data-dir={dir} aria-hidden="true"></span>{formatMove(q)}</bdi></Fragment>
    ) : (
      <span class="quote__move quote__move--na ui">—</span>
    )}
  </span>
  {spark && (
    <svg class="quote__spark" viewBox="0 0 96 28" width="96" height="28" aria-label={`مسار ${spark.days} يوماً`} role="img">
      <polyline points={spark.points} fill="none" stroke={stroke} stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
    </svg>
  )}
</a>

<style>
  .quote { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-areas: "name" "note" "row" "spark"; align-items: end; text-decoration: none; color: var(--ink); min-width: 0; }
  .quote__name { grid-area: name; font-family: var(--font-body); font-weight: 700; font-size: var(--n-text); line-height: 1.4; }
  .quote:hover .quote__name { color: var(--green); }
  .quote__note { grid-area: note; font-size: var(--fs-xs); color: var(--ink-3); line-height: 1.35; }
  /* In a phone's narrow card the move goes under the level as a whole, never split from its mark. */
  .quote__row { grid-area: row; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.55rem; margin-top: 0.15rem; }
  .quote__price { font-size: 1.25rem; font-weight: 700; line-height: 1.2; direction: ltr; unicode-bidi: isolate; }
  .quote__move { font-size: var(--fs-sm); font-weight: 700; direction: ltr; unicode-bidi: isolate; }
  .quote--up .quote__move { color: var(--up); }
  .quote--down .quote__move { color: var(--down); }
  .quote--flat .quote__move, .quote__move--na { color: var(--ink-3); }
  /* The month's line under the level, the width of a short figure: squeezed beside it in a narrow card it shrank
     to a dash (2026-09-27). */
  .quote__spark { grid-area: spark; display: block; margin-top: 0.4rem; width: 100%; max-width: 7rem; height: auto; }
  .is-stale .quote__price { color: var(--ink-3); }
</style>
