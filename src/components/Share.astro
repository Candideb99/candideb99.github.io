---
/** Share row: the services Arab readers actually use, as plain links, plus a copy-link button. */
interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;
const text = encodeURIComponent(title);
const link = encodeURIComponent(url);
const targets = [
  { name: "واتساب", href: `https://wa.me/?text=${text}%20${link}` },
  { name: "إكس", href: `https://x.com/intent/post?text=${text}&url=${link}` },
  { name: "تيليغرام", href: `https://t.me/share/url?url=${link}&text=${text}` },
  { name: "فيسبوك", href: `https://www.facebook.com/sharer/sharer.php?u=${link}` },
];
---

<div class="share" data-share-url={url}>
  <span class="share__label ui">شارك</span>
  <ul class="share__list">
    {targets.map((t) => (
      <li><a class="share__link ui" href={t.href} rel="noopener" target="_blank">{t.name}</a></li>
    ))}
    <li><button class="share__link ui" type="button" data-copy>نسخ الرابط</button></li>
  </ul>
</div>

<script is:inline>
  (function () {
    var root = document.querySelector("[data-share-url]");
    var button = root && root.querySelector("[data-copy]");
    if (!button || !navigator.clipboard) return;
    button.addEventListener("click", function () {
      navigator.clipboard.writeText(root.getAttribute("data-share-url")).then(function () {
        var old = button.textContent;
        button.textContent = "تم النسخ";
        setTimeout(function () { button.textContent = old; }, 2000);
      });
    });
  })();
</script>

<style>
  .share { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.7rem; margin-top: 0.8rem; }
  .share__label { font-weight: 700; font-size: 0.82rem; color: var(--ink-3); }
  .share__list { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .share__link {
    display: inline-block;
    font-weight: 700;
    font-size: 0.8rem;
    line-height: 1;
    padding: 0.42rem 0.65rem 0.32rem;
    border: 1px solid var(--rule);
    color: var(--ink-2);
    text-decoration: none;
    background: var(--paper);
    transition: border-color 0.15s var(--ease-out), color 0.15s var(--ease-out);
  }
  .share__link:hover, .share__link:focus-visible { border-color: var(--green); color: var(--green); }
</style>
