---
/**
 * The sources under an article, and the note that it was written by machine from them alone. The
 * models that wrote it stay in the article's data but are not printed: the owner, 2026-09-23,
 * «remove such things from the news "النماذج: claude-cli, nex-agi/nex-n2.5-pro"».
 */
import { formatShortDate } from "@lib/format";

interface Props {
  /** `url` is empty for an internal source whose article has since been retired: it is named, not linked. */
  sources: { name: string; nameEn?: string; title: string; url: string; publishedAt?: string | null; lang?: string }[];
  explainer?: boolean;
}
const { sources, explainer = false } = Astro.props;
function host(url: string) {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return "";
  }
}
/** A headline written in Latin letters (an English source's own title). */
const latin = (t: string) => /[A-Za-z]/.test(t) && !/[؀-ۿ]/.test(t);
---

<section class="sources" aria-labelledby="sources-title">
  <h2 id="sources-title" class="module__head">{explainer ? "مواد ذات صلة في خازندار" : "المصادر"}</h2>
  {sources.length > 0 ? (
    <ol class="sources__list">
      {sources.map((s) => (
        <li class="sources__item">
          <span class="sources__name ui">{s.name}</span>
          {s.url ? (
            <a class="sources__title" href={s.url} rel={s.url.startsWith("/") ? undefined : "noopener nofollow"} target={s.url.startsWith("/") ? undefined : "_blank"}>
              <bdi lang={latin(s.title) ? "en" : undefined}>{s.title}</bdi>
            </a>
          ) : (
            <span class="sources__title"><bdi lang={latin(s.title) ? "en" : undefined}>{s.title}</bdi></span>
          )}
          <span class="sources__host ui">
            {host(s.url) && <bdi dir="ltr">{host(s.url)}</bdi>}
            {s.publishedAt && <time datetime={s.publishedAt}>{formatShortDate(s.publishedAt)}</time>}
          </span>
        </li>
      ))}
    </ol>
  ) : (
    <p class="sources__none">شرح مفاهيمي يستند إلى التعريفات الاقتصادية المتعارف عليها؛ الأرقام الواردة فيه أمثلة توضيحية لا إحصاءات جارية.</p>
  )}
  <p class="sources__note">
    {explainer
      ? "كُتب هذا الشرح آلياً بنماذج لغوية ثم رُوجع ببرنامج تدقيق مستقل. "
      : "كُتب هذا المقال آلياً استناداً إلى المصادر أعلاه حصراً، ورُوجعت وقائعه وأرقامه ببرنامج تدقيق مستقل قبل النشر. "}
    عند أي تعارض يُعتدّ بالمصدر الأصلي.
  </p>
</section>

<style>
  .sources { margin-top: 2.25rem; max-width: var(--measure); }
  .sources__list { margin-top: 0.4rem; display: grid; }
  .sources__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.1rem 0.75rem;
    align-items: baseline;
    padding-block: 0.6rem;
    border-top: 1px solid var(--rule);
  }
  .sources__item:first-child { border-top: 0; }
  .sources__name { font-weight: 700; font-size: var(--fs-sm); color: var(--green); white-space: nowrap; }
  .sources__title { font-family: var(--font-body); font-size: 1rem; line-height: 1.6; color: var(--ink); overflow-wrap: anywhere; }
  /* An English headline takes the site's Latin face at the Arabic titles' size: the Arabic faces fell back to
     Amiri's Latin, which ran visibly larger than the Arabic around it (2026-09-24). */
  .sources__title bdi:lang(en) { font-family: var(--font-ui); font-size: 0.94rem; }
  .sources__host { grid-column: 2; display: flex; gap: 0.6rem; font-size: var(--fs-xs); color: var(--ink-3); }
  .sources__none, .sources__note { font-family: var(--font-ui); font-size: var(--fs-sm); line-height: 1.6; color: var(--ink-3); margin-top: 0.9rem; }
</style>
