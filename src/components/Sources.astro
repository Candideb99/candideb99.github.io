---
/**
 * The sources under an article, and the note that it was written by machine from them alone. The
 * models that wrote it stay in the article's data but are not printed: the owner, 2026-09-23,
 * «remove such things from the news "النماذج: claude-cli, nex-agi/nex-n2.5-pro"».
 */
import { formatShortDate } from "@lib/format";
import { safeHref } from "@lib/safe-url.mjs";
import { escapeHtml, isolateNumbers } from "@lib/bidi";
import site from "@data/site.json";

interface Props {
  /** `url` is empty for an internal source whose article has since been retired: it is named, not linked. */
  sources: { name: string; nameEn?: string; title: string; url: string; publishedAt?: string | null; lang?: string; detail?: string }[];
  explainer?: boolean;
  /** A news story credits its outlets in one line, each named once, as the desks credit theirs («المصدر: الجزيرة +
   *  وكالات»), and the line opens the list of the reports it was written from (the owner, 2026-11-09: four rows of
   *  headlines under every story, three of them from one outlet). A hub piece's own stories and a paper reading's paper
   *  stay listed: there the list is the reading, not a credit. */
  credit?: boolean;
  /** The sentence under the list, for a page that is not a story (the agenda: its sources are schedules, read by
   *  code, and a source may carry a `detail`, printed beside its address). */
  note?: string;
  /** The article's kind, which the note under a hub piece's list names (an analysis is no «شرح»). */
  kind?: string;
}
const { explainer = false, credit = false, note, kind } = Astro.props;
/** The note under a hub piece's list says what the piece is (2026-11-20, the owner: "check the article pages design and
 *  organization too"): «كُتب هذا الشرح» closed every hub piece, 36 analyses, 3 weeks' reviews and the in-depth piece
 *  among them. */
const hubNote =
  kind === "analysis" ? "كُتب هذا التحليل آلياً بنماذج لغوية ثم رُوجع ببرنامج تدقيق مستقل. "
  : kind === "explainer" ? "كُتب هذا الشرح آلياً بنماذج لغوية ثم رُوجع ببرنامج تدقيق مستقل. "
  : "كُتبت هذه المادة آلياً بنماذج لغوية ثم رُوجعت ببرنامج تدقيق مستقل. ";
/** Under «مواد ذات صلة في خازندار» every line was a story of ours and printed «خازندار» as its source's name, the
 *  heading's own word again (280 lines on 89 pages, 2026-11-20): such a line gives its headline and date alone. A list
 *  that mixes ours with other sources (an idea piece's «المصادر») keeps every name. */
const ours = (s: { name: string; url: string }) => explainer && s.name.trim() === site.name && (s.url === "" || s.url.startsWith("/"));
// An address that is not a web page is named, not linked, like a retired internal source (lib/safe-url.mjs).
const sources = Astro.props.sources.map((s) => ({ ...s, url: safeHref(s.url) ?? "" }));
function host(url: string) {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return "";
  }
}
/** A headline written in Latin letters (an English source's own title). */
const latin = (t: string) => /[A-Za-z]/.test(t) && !/[؀-ۿ]/.test(t);
/** A headline's language: its source's own when the story recorded one (a Turkish or Persian title is not English,
 *  2026-10-25), else English for Latin letters. */
const titleLang = (s: { title: string; lang?: string }) =>
  s.lang && s.lang !== "ar" && /^[a-z]{2,3}(-[a-z0-9]+)*$/i.test(s.lang) ? s.lang : latin(s.title) ? "en" : undefined;
/** A title in Arabic letters keeps its figures as the site prints them (2026-11-09: «12.7%» drew «%12.7» here while the
 *  same headline read «12.7%» everywhere else); a Latin-script title is its own left-to-right line already. */
const titleHtml = (title: string) => (/[؀-ۿ]/.test(title) ? isolateNumbers(title) : escapeHtml(title));
/** Each outlet once, in the order the story lists them. */
const outlets = [...new Set(sources.map((s) => s.name.trim()).filter(Boolean))];
const oneLine = credit && !explainer && outlets.length > 0;
/** The credit line is the summary of a fold that holds the list; elsewhere the list stands open under its heading. */
const Fold = oneLine ? "details" : "div";
---

<section class="sources" aria-labelledby="sources-title">
  <Fold class={oneLine ? "sources__fold" : "sources__body"}>
    {oneLine ? (
      <summary class="sources__credit">
        <span id="sources-title" class="sources__label">{outlets.length > 1 ? "المصادر:" : "المصدر:"}</span>
        <span class="sources__outlets">{outlets.map((name, i) => (<>{i > 0 && "، "}<bdi>{name}</bdi></>))}</span>
        <span class="sources__more ui"><span class="sources__show">عرض الروابط</span><span class="sources__hide">إخفاء الروابط</span></span>
      </summary>
    ) : (
      <h2 id="sources-title" class="module__head">{explainer ? "مواد ذات صلة في خازندار" : "المصادر"}</h2>
    )}
    {sources.length > 0 ? (
      <ol class="sources__list">
        {sources.map((s) => (
          <li class:list={["sources__item", { "sources__item--ours": ours(s) }]}>
            {!ours(s) && <span class="sources__name ui">{s.name}</span>}
            {s.url ? (
              <a class="sources__title" href={s.url} rel={s.url.startsWith("/") ? undefined : "noopener nofollow"} target={s.url.startsWith("/") ? undefined : "_blank"}>
                <bdi lang={titleLang(s)} set:html={titleHtml(s.title)} />
              </a>
            ) : (
              <span class="sources__title"><bdi lang={titleLang(s)} set:html={titleHtml(s.title)} /></span>
            )}
            <span class="sources__host ui">
              {host(s.url) && <bdi dir="ltr">{host(s.url)}</bdi>}
              {s.publishedAt && <time datetime={s.publishedAt}>{formatShortDate(s.publishedAt)}</time>}
              {s.detail && <span>{s.detail}</span>}
            </span>
          </li>
        ))}
      </ol>
    ) : (
      <p class="sources__none">شرح مفاهيمي يستند إلى التعريفات الاقتصادية المتعارف عليها؛ الأرقام الواردة فيه أمثلة توضيحية لا إحصاءات جارية.</p>
    )}
  </Fold>
  {/* The standing note is the same on every story: left out of the search, where «تدقيق» found all 704 (2026-11-23). */}
  <p class="sources__note" data-pagefind-ignore>
    {note ?? (
      <>
        {explainer
          ? hubNote
          : "كُتب هذا المقال آلياً استناداً إلى المصادر أعلاه حصراً، ورُوجعت وقائعه وأرقامه ببرنامج تدقيق مستقل قبل النشر. "}
        عند أي تعارض يُعتدّ بالمصدر الأصلي.
      </>
    )}
  </p>
</section>

<style>
  .sources { margin-top: 2.25rem; max-width: var(--measure); }
  .sources__list { margin-top: 0.4rem; display: grid; }
  .sources__item {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 0.1rem 0.75rem;
    align-items: baseline;
    padding-block: 0.6rem;
    border-top: 1px solid var(--rule);
  }
  .sources__item:first-child { border-top: 0; }
  .sources__name { font-weight: 700; font-size: var(--fs-sm); color: var(--green); }
  .sources__title { font-family: var(--font-body); font-size: var(--n-text); line-height: 1.6; color: var(--ink); overflow-wrap: anywhere; }
  /* An English headline is set in the reading face's own Latin, like the Arabic titles around it (until 2026-09-27
     it took the furniture face, which the renderer was drawing in the system's Segoe UI). */
  .sources__host { grid-column: 2; display: flex; flex-wrap: wrap; gap: 0.1rem 0.6rem; font-size: var(--fs-xs); color: var(--ink-3); }
  /* On a phone the name sits over its title. This rule must come after the one above: while it stood before it, the
     host line's `grid-column: 2` won, opened a second column, and the title was drawn over the source's name on every
     phone (found 2026-10-19). */
  @media (max-width: 599px) {
    .sources__item { grid-template-columns: minmax(0, 1fr); }
    .sources__host { grid-column: 1; }
  }
  /* A story of ours under «مواد ذات صلة في خازندار»: no name column, its headline and date at the list's full width. */
  .sources__item--ours { grid-template-columns: minmax(0, 1fr); }
  .sources__item--ours .sources__host { grid-column: 1; }
  /* The credit line (a news story): a rule over it, the label in bold, the outlets in the reading face, and the fold's
     handle in the furniture face, in the house green, as the chart's «البيانات» fold is. */
  .sources__fold { border-top: 1px solid var(--rule); padding-top: 0.75rem; }
  .sources__credit {
    list-style: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--n-text);
    line-height: 1.7;
    color: var(--ink-2);
  }
  .sources__credit::-webkit-details-marker { display: none; }
  .sources__label { font-weight: 700; color: var(--ink); margin-inline-end: 0.3rem; }
  .sources__more { font-size: var(--fs-xs); font-weight: 700; color: var(--green); margin-inline-start: 0.6rem; white-space: nowrap; }
  .sources__credit:hover .sources__more { text-decoration: underline; text-underline-offset: 0.2em; }
  .sources__hide, .sources__fold[open] .sources__show { display: none; }
  .sources__fold[open] .sources__hide { display: inline; }
  .sources__fold .sources__list { margin-top: 0.5rem; }
  .sources__none, .sources__note { font-family: var(--font-body); font-size: var(--n-text); line-height: 1.7; color: var(--ink-3); margin-top: 0.9rem; }
</style>
