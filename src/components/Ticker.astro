---
/**
 * The latest-headlines bar under the section bar: a moving strip, as the news channels run it,
 * scrolled by whole pixels so the text stays sharp, that pauses under the pointer. The list is printed twice so the loop is seamless; without
 * JavaScript, or for a reader who asked for reduced motion, it stands still and scrolls by hand.
 */
import type { Article } from "@lib/articles";
import { articleHref } from "@lib/articles";
import { timeAgo } from "@lib/format";
import { isolateNumbers } from "@lib/bidi";

interface Props {
  items: Article[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <div class="ticker-wrap" data-ticker>
    <div class="wrap ticker" aria-label="آخر الأخبار">
      <span class="ticker__label ui">الأحدث</span>
      <div class="ticker__viewport">
        <ul class="ticker__list">
          {items.map((a) => (
            <li class="ticker__item">
              <time class="ticker__time" datetime={a.data.publishedAt} data-relative>{timeAgo(a.data.publishedAt)}</time>
              <a href={articleHref(a)} set:html={isolateNumbers(a.data.title)} />
            </li>
          ))}
          {items.map((a) => (
            <li class="ticker__item" aria-hidden="true">
              <time class="ticker__time" datetime={a.data.publishedAt} data-relative>{timeAgo(a.data.publishedAt)}</time>
              <a href={articleHref(a)} tabindex="-1" set:html={isolateNumbers(a.data.title)} />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
)}

<script is:inline>
  (function () {
    var wrap = document.querySelector("[data-ticker]");
    if (!wrap) return;
    var vp = wrap.querySelector(".ticker__viewport");
    var list = wrap.querySelector(".ticker__list");
    if (!vp || !list || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var half = list.scrollWidth / 2;
    if (half < 200) return;
    // The strip is scrolled by whole pixels, not transformed: text on a moving compositing layer
    // blurs at fractional positions. Sixty pixels a second; the list is printed twice, so at half
    // way the scroll position jumps back to the start and the loop is seamless. In a right-to-left
    // page the content overflows leftwards, so the scroll position runs negative.
    var speed = 60;
    var pos = 0;
    var paused = false;
    var last = null;
    vp.addEventListener("mouseenter", function () { paused = true; });
    vp.addEventListener("mouseleave", function () { paused = false; last = null; });
    vp.addEventListener("focusin", function () { paused = true; });
    vp.addEventListener("focusout", function () { paused = false; last = null; });
    wrap.classList.add("ticker--moving");
    function frame(now) {
      if (!paused && !document.hidden) {
        if (last !== null) pos += ((now - last) / 1000) * speed;
        last = now;
        if (pos >= half) pos -= half;
        vp.scrollLeft = -Math.round(pos);
      } else {
        last = null;
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  })();
</script>

<style>
  .ticker-wrap { border-bottom: 1px solid var(--rule); background: var(--paper-2); }
  .ticker { display: flex; align-items: center; gap: 0.9rem; min-height: 2.4rem; }
  .ticker__label { flex: none; font-weight: 800; font-size: 0.78rem; color: var(--paper); background: var(--green); padding: 0.3rem 0.6rem 0.2rem; }
  .ticker__viewport { flex: 1; min-width: 0; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .ticker__viewport::-webkit-scrollbar { display: none; }
  .ticker__list { display: flex; gap: 1.75rem; white-space: nowrap; width: max-content; padding-block: 0.4rem; }
  .ticker__item { display: inline-flex; align-items: baseline; gap: 0.5rem; font-family: var(--font-body); font-weight: 700; font-size: 0.95rem; }
  .ticker__item a { text-decoration: none; }
  .ticker__item a:hover { color: var(--green); }
  .ticker__time { font-size: 0.75rem; color: var(--green); font-weight: 700; }

  .ticker--moving .ticker__viewport { overflow: hidden; }

  @media (max-width: 719px) {
    .ticker__label { font-size: 0.78rem; padding-inline: 0.5rem; }
  }
</style>
