---
/**
 * The strip under the section bar: a moving line of headlines, as the news channels run it, scrolled
 * by whole pixels so the text stays sharp. It carries the newest stories not already on the first
 * screen (the owner's rule: no headline prints twice above the fold), so it can never hold the day's
 * newest; since 2026-09-22 it says so, «أيضاً في العدد» (until 2026-09-23, when the owner ruled out paper words: «أيضاً على خازندار»), and names each story's section instead of an
 * age that always read «منذ 3 أيام» under the old label الأحدث (the owner's choice).
 *
 * It holds under the pointer and under keyboard focus, and under a finger: a touch stops it, a swipe
 * scrolls it by hand, and it moves on a few seconds after the finger lifts. The list is printed twice
 * so the loop is seamless; without JavaScript, or for a reader who asked for reduced motion, it stands
 * still and scrolls by hand.
 */
import type { Article } from "@lib/articles";
import { articleHref } from "@lib/articles";
import { kindLabel } from "@lib/sections";
import { isolateNumbers } from "@lib/bidi";

interface Props {
  items: Article[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <div class="ticker-wrap" data-ticker>
    <div class="wrap ticker" role="region" aria-label="أيضاً على خازندار">
      <span class="ticker__label ui">أيضاً على خازندار</span>
      <div class="ticker__viewport">
        <ul class="ticker__list">
          {items.map((a) => (
            <li class="ticker__item">
              <span class="ticker__section ui">{kindLabel(a.data.kind, a.data.section)}</span>
              <a href={articleHref(a)} set:html={isolateNumbers(a.data.title)} />
            </li>
          ))}
          {items.map((a) => (
            <li class="ticker__item" aria-hidden="true">
              <span class="ticker__section ui">{kindLabel(a.data.kind, a.data.section)}</span>
              <a href={articleHref(a)} tabindex="-1" set:html={isolateNumbers(a.data.title)} />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
)}

<script is:inline>
  (function () {
    var wrap = document.querySelector("[data-ticker]");
    if (!wrap) return;
    var vp = wrap.querySelector(".ticker__viewport");
    var list = wrap.querySelector(".ticker__list");
    if (!vp || !list || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    // The list is printed twice; one period is the distance from the first headline to its
    // duplicate (the items' widths plus their gaps), measured again once the web fonts are in,
    // since the fallback face sets a different width.
    var items = list.children;
    var n = items.length / 2;
    function period() {
      return n >= 1 && items[n] ? Math.abs(items[n].getBoundingClientRect().left - items[0].getBoundingClientRect().left) : list.scrollWidth / 2;
    }
    var half = period();
    if (half < 200) return;
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { half = period(); });
    // The strip is scrolled by whole pixels, not transformed: text on a moving compositing layer
    // blurs at fractional positions. Sixty pixels a second; at the end of one period the scroll
    // position jumps back by exactly that period and the loop is seamless. In a right-to-left
    // page the content overflows leftwards, so the scroll position runs negative.
    var speed = 60;
    var pos = 0;
    var hover = false;
    var focus = false;
    var touch = false;
    var touchTimer = null;
    var last = null;
    function held() { return hover || focus || touch; }
    // Wherever the reader left it by hand is where it moves on from.
    function adopt() {
      pos = Math.abs(vp.scrollLeft) % half;
      last = null;
    }
    vp.addEventListener("mouseenter", function () { hover = true; });
    vp.addEventListener("mouseleave", function () { hover = false; adopt(); });
    vp.addEventListener("focusin", function () { focus = true; });
    vp.addEventListener("focusout", function () { focus = false; adopt(); });
    vp.addEventListener("touchstart", function () { touch = true; clearTimeout(touchTimer); }, { passive: true });
    vp.addEventListener("touchend", function () {
      clearTimeout(touchTimer);
      touchTimer = setTimeout(function () { touch = false; adopt(); }, 3000);
    }, { passive: true });
    wrap.classList.add("ticker--moving");
    function frame(now) {
      if (!held() && !document.hidden) {
        if (last !== null) pos += ((now - last) / 1000) * speed;
        last = now;
        if (pos >= half) pos -= half;
        vp.scrollLeft = -Math.round(pos);
      } else {
        last = null;
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  })();
</script>

<style>
  .ticker-wrap { border-bottom: 1px solid var(--rule); background: var(--paper-2); }
  .ticker { display: flex; align-items: center; gap: 0.9rem; min-height: 2.4rem; }
  .ticker__label { flex: none; font-weight: 800; font-size: var(--fs-xs); color: var(--paper); background: var(--green); padding: 0.3rem 0.6rem 0.2rem; }
  /* It stays a scroll box while it moves, so a finger can take it by hand. */
  .ticker__viewport { flex: 1; min-width: 0; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .ticker__viewport::-webkit-scrollbar { display: none; }
  .ticker__list { display: flex; gap: 1.75rem; white-space: nowrap; width: max-content; }
  .ticker__item { display: inline-flex; align-items: baseline; gap: 0.5rem; font-family: var(--font-body); font-weight: 700; font-size: 0.95rem; }
  .ticker__item a { text-decoration: none; padding-block: 0.4rem; }
  .ticker__item a:hover { color: var(--green); }
  .ticker__section { font-size: var(--fs-xs); color: var(--green); font-weight: 700; }

  @media (max-width: 719px) {
    .ticker__label { padding-inline: 0.5rem; }
  }
</style>
