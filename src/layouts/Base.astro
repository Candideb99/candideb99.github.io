---
import "../styles/global.css";
import site from "@data/site.json";
import Masthead from "@components/Masthead.astro";
import Footer from "@components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  section?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedAt?: string;
  updatedAt?: string;
}

const {
  title,
  description = site.description,
  path = "/",
  image,
  imageAlt,
  type = "website",
  section,
  noindex = false,
  jsonLd,
  publishedAt,
  updatedAt,
} = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(path, site.url).toString();
const ogImage = new URL(image ?? "/og-default.png", site.url).toString();
---

<!doctype html>
<html lang="ar" dir="rtl" data-section={section}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#e5a52b" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/naskh-arabic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/amiri-arabic-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/tajawal-arabic-700.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <!--
      DIRECTION CONTRACT (seed 6923a822)
      THESIS: خازندار is a daily issue, not a feed. A mid-century Cairo illustrated
      magazine program on the web: flat spot-colour fields, classical Arabic display,
      naskh text, one-colour halftone photographs. It refuses the cream broadsheet
      with gold hairlines and the black terminal with neon figures.
      OWN-WORLD: saffron masthead field; six section inks (cobalt, vermilion, teal,
      plum, cyan, ochre) as flat fields; Amiri display and titles (user-pinned
      respectable register), Noto Naskh body, Tajawal labels and figures; duotone
      plates that reveal colour on hover; procedural abstract covers when no
      licensed photo exists.
      STORY: the reader opens today's issue, sees the cover story and the contents
      at once, reads sourced Arabic reporting with the numbers isolated, and
      trusts it because every source is shown.
      FIRST VIEWPORT: saffron band with wordmark, date and issue number; section
      strip; the cover story as a full-colour plate with the headline lettered
      over the field, and "في هذا العدد" contents beside it.
      FORM: Cairo mid-century illustrated magazine program, candidate 5 of 7.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the
      finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main">انتقل إلى المحتوى</a>
    <Masthead active={section} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Relative times and the masthead date are rendered at build time; keep them honest between builds.
      (function () {
        var MONTHS = ["يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر"];
        var DAYS = ["الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت"];
        function ago(iso) {
          var diff = (Date.now() - Date.parse(iso)) / 1000;
          if (!isFinite(diff)) return null;
          if (diff < 60) return "الآن";
          var m = Math.floor(diff / 60);
          if (m < 60) return m === 1 ? "قبل دقيقة" : m === 2 ? "قبل دقيقتين" : m <= 10 ? "قبل " + m + " دقائق" : "قبل " + m + " دقيقة";
          var h = Math.floor(m / 60);
          if (h < 24) return h === 1 ? "قبل ساعة" : h === 2 ? "قبل ساعتين" : h <= 10 ? "قبل " + h + " ساعات" : "قبل " + h + " ساعة";
          var d = Math.floor(h / 24);
          if (d === 1) return "أمس";
          if (d === 2) return "قبل يومين";
          if (d <= 10) return "قبل " + d + " أيام";
          var t = new Date(iso);
          return t.getDate() + " " + MONTHS[t.getMonth()] + " " + t.getFullYear();
        }
        function tick() {
          var nodes = document.querySelectorAll("time[data-relative][datetime]");
          for (var i = 0; i < nodes.length; i++) {
            var label = ago(nodes[i].getAttribute("datetime"));
            if (label && nodes[i].textContent !== label) nodes[i].textContent = label;
          }
        }
        function masthead() {
          var date = document.querySelector("[data-issue-date]");
          var no = document.querySelector("[data-issue-no]");
          var launch = date && date.getAttribute("data-launch");
          if (!date || !launch) return;
          var now = new Date();
          var parts = new Intl.DateTimeFormat("en-US", { timeZone: "Asia/Riyadh", year: "numeric", month: "numeric", day: "numeric", weekday: "short" }).formatToParts(now);
          var map = {};
          parts.forEach(function (p) { map[p.type] = p.value; });
          var wd = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].indexOf(map.weekday);
          var text = DAYS[wd] + " " + Number(map.day) + " " + MONTHS[Number(map.month) - 1] + " " + map.year;
          if (date.textContent !== text) date.textContent = text;
          if (no) {
            var issue = Math.max(1, Math.floor((now - new Date(launch + "T00:00:00Z")) / 86400000) + 1);
            no.textContent = String(issue);
          }
        }
        tick();
        masthead();
        setInterval(tick, 60000);
      })();
    </script>
  </body>
</html>
