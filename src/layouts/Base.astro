---
import "../styles/global.css";
import site from "@data/site.json";
import Masthead from "@components/Masthead.astro";
import Footer from "@components/Footer.astro";
import MarketStrip from "@components/MarketStrip.astro";
import Ticker from "@components/Ticker.astro";
import { getArticles, articleHref } from "@lib/articles";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  section?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedAt?: string;
  updatedAt?: string;
}

const {
  title,
  description = site.description,
  path = "/",
  image,
  imageAlt,
  type = "website",
  section,
  noindex = false,
  jsonLd,
  publishedAt,
  updatedAt,
} = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
// آخر الأخبار under the market strip, as الشرق الأوسط runs its latest-news line on every page (Task 4,
// 2026-09-24): the eight newest news stories, the page's own story left out. The front page too since 2026-09-28 (the
// owner, on its own «أيضاً على خازندار» strip beside every other page's «آخر الأخبار»: "is this a bug?"; he chose one
// strip everywhere, knowing some of its headlines also stand in the cover below). Not on the latest list, which is the
// same list at full length.
const withLatest = !path.startsWith("/latest") && path !== "/404";
const latestNews = withLatest ? (await getArticles()).filter((a) => a.data.kind === "news" && articleHref(a) !== path).slice(0, 8) : [];
const canonical = new URL(path, site.url).toString();
const ogImage = new URL(image ?? "/og-default.png", site.url).toString();
---

<!doctype html>
<html lang="ar" dir="rtl" data-section={section}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || site.private) && <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />}
    <meta name="theme-color" content="#0f5c3c" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />
    {!site.private && <link rel="sitemap" href="/sitemap-index.xml" />}
    <!-- The faces every page sets from the first line: the Arabic and Latin halves of the headline and body
         faces arrive together (a headline's figures arriving after its letters re-wrapped it and moved the
         article's photo 57px), and the two Tajawal weights the furniture uses. -->
    <link rel="preload" href="/fonts/naskh-arabic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/naskh-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/amiri-arabic-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/amiri-latin-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/tajawal-arabic-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/tajawal-arabic-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/tajawal-latin-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/tajawal-latin-700.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}
    {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}
    {site.adsenseClient && !noindex && !site.private && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`} crossorigin="anonymous" is:inline />
    )}
  </head>
  <body>
    <!--
      DIRECTION CONTRACT (canon, user-pinned 2026-09-09)
      THESIS: خازندار is a news organisation's daily, not a web app: the dense,
      picture-led front page of the Arabic dailies' sites, played straight, on
      white paper with black ink and one banknote green. It refuses washed
      photographs, generated art, sparse editorial templates and web decoration.
      OWN-WORLD: paper #fcfcf9 / ink #141414 / green #0f5c3c (links, section names,
      the section bar, the ticker label); the owner's logo, dark-green calligraphic
      خازندار over the treasurer's gold key, used as delivered; Amiri heads, Noto
      Naskh text justified in ruled columns, Tajawal for dates and small furniture;
      true-colour photographs sized to their column on every story.
      STORY: the reader opens the site, scans the headline strip and the top
      stories, reads the lead, moves through the sections, and trusts every story
      because its sources are printed.
      WORDING (the owner, 2026-09-23): an online news website, not an online
      newspaper. The look keeps the printed register; the words never make it a
      paper: no issue number, no العدد, الطبعة or صحيفة about itself.
      FIRST VIEWPORT: the logo centred between its ears (the date, the tools;
      64px on every other page, which on a phone opens on the bar); green bar; latest-
      headlines strip; the cover (the day's strongest story on the stage, the
      other four as numbered tabs beneath, rotating until the reader touches it);
      then three ruled columns: top stories, secondaries and picks, the day's
      chart and figures.
      FORM: the category standard (an Arabic daily's site), chosen by the user in
      plain words; no seed roll.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the
      finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main">انتقل إلى المحتوى</a>
    <Masthead active={section} compact={path !== "/"} />
    <slot name="under-bar" />
    <MarketStrip />
    {latestNews.length > 0 && <Ticker items={latestNews} label="آخر الأخبار" lead="time" />}
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Relative times and the masthead date are rendered at build time; keep them honest between
      // builds, in the paper's own zone (the masthead carries it), not the reader's.
      (function () {
        var MONTHS = ["يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر"];
        var DAYS = ["الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت"];
        var today = document.querySelector("[data-today]");
        var ZONE = (today && today.getAttribute("data-zone")) || "Africa/Cairo";
        function partsIn(d) {
          var parts = new Intl.DateTimeFormat("en-US", { timeZone: ZONE, year: "numeric", month: "numeric", day: "numeric", weekday: "short" }).formatToParts(d);
          var map = {};
          parts.forEach(function (p) { map[p.type] = p.value; });
          return map;
        }
        function pad(n) { return (n < 10 ? "0" : "") + n; }
        function ago(iso) {
          var diff = (Date.now() - Date.parse(iso)) / 1000;
          if (!isFinite(diff)) return null;
          if (diff < 60) return "الآن";
          var m = Math.floor(diff / 60);
          if (m < 60) return m === 1 ? "منذ دقيقة" : m === 2 ? "منذ دقيقتين" : m <= 10 ? "منذ " + m + " دقائق" : "منذ " + m + " دقيقة";
          var h = Math.floor(m / 60);
          if (h < 24) return h === 1 ? "منذ ساعة" : h === 2 ? "منذ ساعتين" : h <= 10 ? "منذ " + h + " ساعات" : "منذ " + h + " ساعة";
          var d = Math.floor(h / 24);
          if (d === 1) return "منذ يوم";
          if (d === 2) return "منذ يومين";
          if (d <= 10) return "منذ " + d + " أيام";
          var p = partsIn(new Date(iso));
          return Number(p.day) + " " + MONTHS[Number(p.month) - 1] + " " + p.year;
        }
        function tick() {
          var nodes = document.querySelectorAll("time[data-relative][datetime]");
          for (var i = 0; i < nodes.length; i++) {
            var label = ago(nodes[i].getAttribute("datetime"));
            if (label && nodes[i].textContent !== label) nodes[i].textContent = label;
          }
        }
        function masthead() {
          var date = today;
          if (!date) return;
          var now = new Date();
          var map = partsIn(now);
          var wd = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].indexOf(map.weekday);
          var text = DAYS[wd] + " " + Number(map.day) + " " + MONTHS[Number(map.month) - 1] + " " + map.year;
          var iso = map.year + "-" + pad(Number(map.month)) + "-" + pad(Number(map.day));
          if (date.textContent !== text) date.textContent = text;
          if (date.getAttribute("datetime") !== iso) date.setAttribute("datetime", iso);
          // The Hijri date beside it, by the Umm al-Qura calendar, in Western digits.
          var hijri = document.querySelector("[data-hijri]");
          if (hijri) {
            try {
              var h = new Intl.DateTimeFormat("ar-SA-u-ca-islamic-umalqura-nu-latn", { day: "numeric", month: "long", year: "numeric", timeZone: ZONE }).format(now);
              if (hijri.textContent !== h) hijri.textContent = h;
            } catch (e) {
              /* a browser without the calendar keeps the date the page was built with */
            }
          }
        }
        tick();
        masthead();
        setInterval(tick, 60000);
      })();
    </script>
    <script is:inline>
      // Motion (the owner, 2026-09-27; the rules are in global.css under "Motion"). Only what lies below the
      // first screen waits, and only until the reader reaches it: a photograph develops once it has arrived,
      // a story settles in, a chart's bars rise. The text of the story being read never fades (nothing inside
      // .article settles; its chart still rises), the pinned bar's panels are left alone, nothing moves twice,
      // and a reader who asked for reduced motion, or a browser without IntersectionObserver, gets the page
      // exactly as before.
      (function () {
        if (!("IntersectionObserver" in window) || !window.matchMedia || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var fold = window.innerHeight * 0.92;
        // The watch stops 6% above the screen's foot, so a thing the page cannot scroll that far up is left shown.
        var reach = document.documentElement.scrollHeight - window.innerHeight * 0.06 - 8;
        function below(el) {
          var r = el.getBoundingClientRect();
          return r.height > 0 && r.top > fold && r.top + window.scrollY < reach;
        }
        function settle(el) {
          el.classList.add("is-settling");
          el.classList.remove("will-settle");
          setTimeout(function () { el.classList.remove("is-settling"); }, 1700);
        }
        var seen = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var el = entry.target;
            seen.unobserve(el);
            var go = function () { setTimeout(function () { settle(el); }, Number(el.getAttribute("data-settle-delay") || 0)); };
            if (el.tagName === "IMG" && !(el.complete && el.naturalWidth)) {
              el.addEventListener("load", go, { once: true });
              el.addEventListener("error", go, { once: true });
            } else go();
          });
        }, { rootMargin: "0px 0px -6% 0px" });
        function wait(el, delay) {
          if (delay) el.setAttribute("data-settle-delay", String(delay));
          el.classList.add("will-settle");
          seen.observe(el);
        }
        document.documentElement.classList.add("has-motion");
        document.querySelectorAll(".photo img").forEach(function (img) { if (below(img)) wait(img, 0); });
        // Stories side by side follow one another by 90 ms in reading order, three steps at most.
        var rows = {};
        document.querySelectorAll(".card, .digest__item, .picks__item, .figures__item, .agenda__item, .lines__item, .desk, .module__head, .section-head").forEach(function (el) {
          if (el.closest(".article, .masthead, .masthead__nav") || !below(el)) return;
          var row = Math.round((el.getBoundingClientRect().top + window.scrollY) / 40);
          rows[row] = (rows[row] || 0) + 1;
          el.classList.add("settle");
          wait(el, Math.min(rows[row] - 1, 3) * 90);
        });
        document.querySelectorAll(".chart").forEach(function (chart) {
          if (!below(chart)) return;
          chart.querySelectorAll(".chart__mark rect").forEach(function (bar, i) { bar.style.transitionDelay = Math.min(i, 8) * 55 + "ms"; });
          wait(chart, 0);
        });
      })();
    </script>
  </body>
</html>
