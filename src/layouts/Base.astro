---
import "../styles/global.css";
import site from "@data/site.json";
import Masthead from "@components/Masthead.astro";
import Footer from "@components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  section?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedAt?: string;
  updatedAt?: string;
}

const {
  title,
  description = site.description,
  path = "/",
  image,
  imageAlt,
  type = "website",
  section,
  noindex = false,
  jsonLd,
  publishedAt,
  updatedAt,
} = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(path, site.url).toString();
const ogImage = new URL(image ?? "/og-default.png", site.url).toString();
---

<!doctype html>
<html lang="ar" dir="rtl" data-section={section}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || site.private) && <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />}
    <meta name="theme-color" content="#0f5c3c" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />
    {!site.private && <link rel="sitemap" href="/sitemap-index.xml" />}
    <link rel="preload" href="/fonts/naskh-arabic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/amiri-arabic-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/tajawal-arabic-500.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}
    {site.adsenseClient && !noindex && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`} crossorigin="anonymous" is:inline />
    )}
  </head>
  <body>
    <!--
      DIRECTION CONTRACT (canon, user-pinned 2026-09-09)
      THESIS: خازندار is a news organisation's daily, not a web app: the dense,
      picture-led front page of the Arabic dailies' sites, played straight, on
      white paper with black ink and one banknote green. It refuses washed
      photographs, generated art, sparse editorial templates and web decoration.
      OWN-WORLD: paper #fcfcf9 / ink #141414 / green #0f5c3c (links, section names,
      the section bar, the ticker label); the owner's logo, dark-green calligraphic
      خازندار over the treasurer's gold key, used as delivered; Amiri heads, Noto
      Naskh text justified in ruled columns, Tajawal for dates and small furniture;
      true-colour photographs sized to their column on every story.
      STORY: the reader opens today's paper, scans the headline strip and the top
      stories, reads the lead, moves through the sections, and trusts every story
      because its sources are printed.
      FIRST VIEWPORT: date line; the logo centred; green section bar; latest-
      headlines strip; the cover (the day's strongest story on the stage, the
      other four as numbered tabs beneath, rotating until the reader touches it);
      then three ruled columns: top stories, secondaries and picks, the day's
      chart and figures.
      FORM: the category standard (an Arabic daily's site), chosen by the user in
      plain words; no seed roll.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the
      finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main">انتقل إلى المحتوى</a>
    <Masthead active={section} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Relative times and the masthead date are rendered at build time; keep them honest between builds.
      (function () {
        var MONTHS = ["يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر"];
        var DAYS = ["الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت"];
        function ago(iso) {
          var diff = (Date.now() - Date.parse(iso)) / 1000;
          if (!isFinite(diff)) return null;
          if (diff < 60) return "الآن";
          var m = Math.floor(diff / 60);
          if (m < 60) return m === 1 ? "منذ دقيقة" : m === 2 ? "منذ دقيقتين" : m <= 10 ? "منذ " + m + " دقائق" : "منذ " + m + " دقيقة";
          var h = Math.floor(m / 60);
          if (h < 24) return h === 1 ? "منذ ساعة" : h === 2 ? "منذ ساعتين" : h <= 10 ? "منذ " + h + " ساعات" : "منذ " + h + " ساعة";
          var d = Math.floor(h / 24);
          if (d === 1) return "منذ يوم";
          if (d === 2) return "منذ يومين";
          if (d <= 10) return "منذ " + d + " أيام";
          var t = new Date(iso);
          return t.getDate() + " " + MONTHS[t.getMonth()] + " " + t.getFullYear();
        }
        function tick() {
          var nodes = document.querySelectorAll("time[data-relative][datetime]");
          for (var i = 0; i < nodes.length; i++) {
            var label = ago(nodes[i].getAttribute("datetime"));
            if (label && nodes[i].textContent !== label) nodes[i].textContent = label;
          }
        }
        function masthead() {
          var date = document.querySelector("[data-issue-date]");
          var no = document.querySelector("[data-issue-no]");
          var launch = date && date.getAttribute("data-launch");
          if (!date || !launch) return;
          var now = new Date();
          var parts = new Intl.DateTimeFormat("en-US", { timeZone: "Asia/Riyadh", year: "numeric", month: "numeric", day: "numeric", weekday: "short" }).formatToParts(now);
          var map = {};
          parts.forEach(function (p) { map[p.type] = p.value; });
          var wd = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].indexOf(map.weekday);
          var text = DAYS[wd] + " " + Number(map.day) + " " + MONTHS[Number(map.month) - 1] + " " + map.year;
          if (date.textContent !== text) date.textContent = text;
          if (no) {
            var issue = Math.max(1, Math.floor((now - new Date(launch + "T00:00:00Z")) / 86400000) + 1);
            no.textContent = String(issue);
          }
        }
        tick();
        masthead();
        setInterval(tick, 60000);
      })();
    </script>
  </body>
</html>
