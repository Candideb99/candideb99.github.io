---
import "../styles/global.css";
import site from "@data/site.json";
import Masthead from "@components/Masthead.astro";
import Footer from "@components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  section?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedAt?: string;
  updatedAt?: string;
}

const {
  title,
  description = site.description,
  path = "/",
  image,
  imageAlt,
  type = "website",
  section,
  noindex = false,
  jsonLd,
  publishedAt,
  updatedAt,
} = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(path, site.url).toString();
const ogImage = new URL(image ?? "/og-default.png", site.url).toString();
---

<!doctype html>
<html lang="ar" dir="rtl" data-section={section}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#e5a52b" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/naskh-arabic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/amiri-arabic-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/tajawal-arabic-700.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <!--
      DIRECTION CONTRACT (seed 6923a822)
      THESIS: خازندار is a daily issue, not a feed. A mid-century Cairo illustrated
      magazine program on the web: flat spot-colour fields, hand-lettered display,
      naskh text, one-colour halftone photographs. It refuses the cream broadsheet
      with gold hairlines and the black terminal with neon figures.
      OWN-WORLD: saffron masthead field; six section inks (cobalt, vermilion, teal,
      plum, cyan, ochre) as flat fields; Rakkas display, Marhey titles, Naskh body,
      Tajawal figures; duotone plates that reveal colour on hover; procedural
      abstract covers when no licensed photo exists.
      STORY: the reader opens today's issue, sees the cover story and the contents
      at once, reads sourced Arabic reporting with the numbers isolated, and
      trusts it because every source is shown.
      FIRST VIEWPORT: saffron band with wordmark, date and issue number; section
      strip; the cover story as a full-colour plate with the headline lettered
      over the field, and "في هذا العدد" contents beside it.
      FORM: Cairo mid-century illustrated magazine program, candidate 5 of 7.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the
      finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main">انتقل إلى المحتوى</a>
    <Masthead active={section} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
