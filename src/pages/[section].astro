---
import Base from "@layouts/Base.astro";
import StoryCard from "@components/StoryCard.astro";
import { getArticlesBySection } from "@lib/articles";
import { sections } from "@lib/sections";

export async function getStaticPaths() {
  return sections.map((section) => ({ params: { section: section.id }, props: { section } }));
}

const { section } = Astro.props;
const articles = await getArticlesBySection(section.id);
const [first, ...others] = articles;
const beside = others.slice(0, 3);
const rest = others.slice(3);
---

<Base title={section.name} description={`${section.name} في خازندار: ${section.description}`} path={`/${section.id}/`} section={section.id}>
  <section class="wrap block" data-section={section.id}>
    <header class="page-head">
      <h1 class="page-title">{section.name}</h1>
      <p class="page-intro">{section.description}</p>
    </header>

    {articles.length === 0 ? (
      <p class="section-page__empty">لم تُنشر مواد في هذا القسم بعد. غرفة الأخبار تعمل على مدار الساعة.</p>
    ) : (
      <div class="section-page">
        <div class={`section-page__top${beside.length ? "" : " section-page__top--solo"}`}>
          <div class="section-page__lead">
            <StoryCard article={first} variant="lead" level={2} showSection={false} eager />
          </div>
          {beside.length > 0 && (
            <div class="section-page__beside">
              {beside.map((a) => (
                <StoryCard article={a} variant="list" showSection={false} showExcerpt />
              ))}
            </div>
          )}
        </div>
        {rest.length > 0 && (
          <div class={`section-page__rest ${rest.length < 3 ? "cards cards--list" : "cards"}`} style={`--n:${Math.min(rest.length, 4)}`}>
            {rest.map((a) => (
              <StoryCard article={a} variant={rest.length < 3 ? "list" : "card"} showSection={false} showExcerpt={!a.data.image} />
            ))}
          </div>
        )}
      </div>
    )}
  </section>
</Base>

<style>
  .section-page__empty { font-family: var(--font-ui); color: var(--ink-3); }
  .section-page__top { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); column-gap: 0; align-items: start; }
  .section-page__lead { padding-inline-end: var(--col-gap); }
  .section-page__top--solo { grid-template-columns: 1fr; }
  .section-page__top--solo .section-page__lead { padding-inline-end: 0; max-width: 56rem; }
  .section-page__beside { border-inline-start: 1px solid var(--rule); padding-inline-start: var(--col-gap); display: grid; }
  .section-page__beside > :global(.card) { padding-block: 0.8rem; border-top: 1px solid var(--rule); }
  .section-page__beside > :global(.card:first-child) { border-top: 0; padding-top: 0.1rem; }
  .section-page__rest { margin-top: clamp(1.5rem, 3vw, 2.5rem); border-top: 3px solid var(--ink); padding-top: 1.25rem; }
  @media (max-width: 1023px) {
    .section-page__top { grid-template-columns: 1fr; row-gap: 1.25rem; }
    .section-page__lead { padding-inline-end: 0; }
    .section-page__beside { border-inline-start: 0; padding-inline-start: 0; border-top: 1px solid var(--rule); padding-top: 0.5rem; }
  }
</style>
