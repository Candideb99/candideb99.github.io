---
import type { GetStaticPaths, Page } from "astro";
import Base from "@layouts/Base.astro";
import StoryCard from "@components/StoryCard.astro";
import MarketBoard from "@components/MarketBoard.astro";
import type { Article } from "@lib/articles";
import { getArticlesBySection } from "@lib/articles";
import { sections, type Section } from "@lib/sections";

/**
 * A section, newest first, in pages of twelve. The first page keeps the front-page shape (a lead
 * with three stories beside it); later pages are a plain grid of cards. Before this, الاقتصاد put
 * twenty-eight stories on one page and grew with every run.
 */
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const routes = [];
  for (const section of sections) {
    const articles = await getArticlesBySection(section.id);
    routes.push(
      ...paginate(articles, {
        params: { section: section.id },
        props: { section },
        pageSize: 12,
      }),
    );
  }
  return routes;
};

interface Props {
  section: Section;
  page: Page<Article>;
}
const { section, page } = Astro.props;
const first = page.currentPage === 1;
const [lead, ...others] = page.data;
// Up to three stories beside the lead; when the section is small the ruled list takes them all,
// so a page never ends with one orphan card under a rule.
const besideCount = others.length <= 5 ? others.length : 3;
const beside = first ? others.slice(0, besideCount) : [];
const rest = first ? others.slice(besideCount) : page.data;
const title = first ? section.name : `${section.name} — صفحة ${page.currentPage}`;
---

<Base title={title} description={`${section.name} في خازندار: ${section.description}`} path={page.url.current} section={section.id}>
  <section class="wrap block" data-section={section.id}>
    <header class="page-head">
      <h1 class="page-title">{section.name}</h1>
      <p class="page-intro">{section.description}</p>
    </header>

    {first && section.id === "markets" && <MarketBoard variant="full" id="board" />}

    {page.total === 0 ? (
      <p class="section-page__empty">لم تُنشر مواد في هذا القسم بعد. غرفة الأخبار تعمل على مدار الساعة.</p>
    ) : (
      <div class="section-page">
        {first && lead && (
          <div class={`section-page__top${beside.length ? "" : " section-page__top--solo"}`}>
            <div class="section-page__lead">
              <StoryCard article={lead} variant="lead" level={2} showSection={false} showTopic eager />
            </div>
            {beside.length > 0 && (
              <div class="section-page__beside">
                {beside.map((a) => (
                  <StoryCard article={a} variant="list" showSection={false} showExcerpt />
                ))}
              </div>
            )}
          </div>
        )}
        {rest.length > 0 && (
          <div class={`section-page__rest ${rest.length < 3 ? "cards cards--list" : "cards"}`} style={`--n:${Math.min(rest.length, 4)}`}>
            {rest.map((a, i) => (
              <StoryCard article={a} variant={rest.length < 3 ? "list" : "card"} showSection={false} showExcerpt={!a.data.image} eager={!first && i < 4} />
            ))}
          </div>
        )}
      </div>
    )}

    {page.lastPage > 1 && (
      <nav class="pager" aria-label="صفحات القسم">
        {page.url.prev ? (
          <a class="pager__step" href={page.url.prev} rel="prev">أحدث</a>
        ) : (
          <span class="pager__step pager__step--off" aria-hidden="true">أحدث</span>
        )}
        <p class="pager__count ui">صفحة <bdi>{page.currentPage}</bdi> من <bdi>{page.lastPage}</bdi></p>
        {page.url.next ? (
          <a class="pager__step" href={page.url.next} rel="next">أقدم</a>
        ) : (
          <span class="pager__step pager__step--off" aria-hidden="true">أقدم</span>
        )}
      </nav>
    )}
  </section>
</Base>

<style>
  .section-page__empty { font-family: var(--font-ui); color: var(--ink-3); }
  .section-page__top { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); column-gap: 0; align-items: start; }
  .section-page__lead { padding-inline-end: var(--col-gap); }
  .section-page__top--solo { grid-template-columns: 1fr; }
  .section-page__top--solo .section-page__lead { padding-inline-end: 0; max-width: 56rem; }
  .section-page__beside { border-inline-start: 1px solid var(--rule); padding-inline-start: var(--col-gap); display: grid; }
  .section-page__beside > :global(.card) { padding-block: 0.8rem; border-top: 1px solid var(--rule); }
  .section-page__beside > :global(.card:first-child) { border-top: 0; padding-top: 0.1rem; }
  .section-page__rest { margin-top: clamp(1.5rem, 3vw, 2.5rem); border-top: 1px solid var(--ink); padding-top: 1.25rem; }
  /* The lead runs like the cover: headline first in the reading direction, photograph beside it. */
  .section-page__lead :global(.card--lead) { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 0 clamp(1.25rem, 3vw, 2.5rem); align-items: center; }
  /* The section lead has two thirds of the cover's measure, so its headline steps down a size. */
  .section-page__lead :global(.card--lead .card__title) { font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.3rem); line-height: 1.3; }
  .section-page__lead :global(.card--lead .card__photo) { order: 2; margin-bottom: 0; }
  .section-page__lead :global(.card--lead .card__body) { order: 1; }

  .pager { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: clamp(1.5rem, 3vw, 2.5rem); border-top: 1px solid var(--rule); padding-top: 0.9rem; }
  .pager__step { font-family: var(--font-ui); font-weight: 700; font-size: 0.92rem; color: var(--green); text-decoration: none; padding: 0.4rem 0.8rem 0.3rem; border: 1px solid var(--rule); }
  .pager__step:hover { border-color: var(--green); }
  .pager__step--off { color: var(--ink-3); border-color: var(--rule); opacity: 0.5; }
  .pager__count { font-size: 0.86rem; color: var(--ink-3); }

  @media (max-width: 719px) {
    .section-page__lead :global(.card--lead) { grid-template-columns: 1fr; gap: 0.6rem 0; align-items: start; }
    .section-page__lead :global(.card--lead .card__photo) { order: 1; }
    .section-page__lead :global(.card--lead .card__body) { order: 2; }
  }
  @media (max-width: 1023px) {
    .section-page__top { grid-template-columns: 1fr; row-gap: 1.25rem; }
    .section-page__lead { padding-inline-end: 0; }
    .section-page__beside { border-inline-start: 0; padding-inline-start: 0; border-top: 1px solid var(--rule); padding-top: 0.5rem; }
  }
</style>
