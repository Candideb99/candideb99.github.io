---
import type { GetStaticPaths, Page } from "astro";
import Base from "@layouts/Base.astro";
import StoryCard from "@components/StoryCard.astro";
import StoryFront from "@components/StoryFront.astro";
import LinkRow from "@components/LinkRow.astro";
import Pager from "@components/Pager.astro";
import { analysisLabel, liveDesks, WEEKLY_HREF } from "@lib/analysis";
import { menuTopics, topicHref } from "@lib/topics";
import type { Article } from "@lib/articles";
import { getArticles, getArticlesBySection } from "@lib/articles";
import { sections, HUB_SECTIONS, type Section } from "@lib/sections";

/**
 * A section, newest first, in pages of twelve, set out by StoryFront.astro: the first page keeps the front-page shape
 * (a lead with three stories beside it); later pages are a plain grid of cards. Before this, الاقتصاد put
 * twenty-eight stories on one page and grew with every run.
 */
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const routes = [];
  for (const section of sections) {
    // «مدخل إلى الاقتصاد» has its own page, set out by kind (src/pages/explainers/index.astro, 2026-11-20), and no
    // pages by date: its kinds' pages keep every piece.
    if (section.id === "explainers") continue;
    // The week's review is a series of its own (WEEKLY_HREF, 2026-11-20): its newest edition has a block on the first
    // page and every edition its own page, so the pages by date are the daily analyses.
    const articles = (await getArticlesBySection(section.id)).filter((a) => section.id !== "analysis" || a.data.kind !== "weekly");
    routes.push(
      ...paginate(articles, {
        params: { section: section.id },
        props: { section },
        pageSize: 12,
      }),
    );
  }
  return routes;
};

interface Props {
  section: Section;
  page: Page<Article>;
}
const { section, page } = Astro.props;
const all = section.id === "analysis" ? await getArticles() : [];
const first = page.currentPage === 1;
// News sections are their own label; the hubs print each story's kind (analysis desk, explainer, paper reading).
const showKind = HUB_SECTIONS.has(section.id);
const title = first ? section.name : `${section.name} — صفحة ${page.currentPage}`;
// The sub-topics we are writing about (menuTopics, 2026-10-19); the analysis hub lists its desks the same way (the
// owner's check of the section pages, 2026-10-19: on a phone the desks were reachable only from a piece's label, and the
// phone menu lists sections only). No counts since 2026-11-20 (the owner, of the explainers' «الأنواع» row with its
// counts: "do we need these types tags ... if redundant then remove it also check other website section for similar
// redundant stuff"): a count is the archive's bookkeeping, as on the front's region block he cleared on 18 November;
// the names are the way in. «الأسواق في لمحة», six quote cards under the markets lead, went on 2026-10-19 at his choice:
// the market strip above it is the site's one price line.
const everything = first ? await getArticles() : [];
const topics = first && !HUB_SECTIONS.has(section.id) ? menuTopics(everything, section.id) : [];
const divisions: { href: string; name: string }[] =
  first && section.id === "analysis" ? liveDesks(everything).map((desk) => ({ href: `/analysis/desk/${desk.id}/`, name: desk.label })) : [];
// «حصاد الأسبوع» (2026-11-20, the owner: "check the analysis page design and organization too"): its three editions had
// stood among the daily analyses, the eleventh card of the first page, with no page of their own. Its newest edition
// now has a block under the top stories, with the way to all of them.
const weekly = first && section.id === "analysis" ? everything.find((a) => a.data.kind === "weekly") : undefined;
---

<Base title={title} description={`${section.name} في خازندار: ${section.description}`} path={page.url.current} section={section.id} printed={[...page.data, ...(weekly ? [weekly] : [])].map((a) => a.id)}>
  <section class="wrap block" data-section={section.id}>
    <header class="page-head">
      <h1 class="page-title">{section.name}</h1>
      {/* A news section's sentence listed its sub-topics, which the row under it names (2026-11-20, the owner: "check the
          section pages design and organization too"): it is printed only where no row follows (the analysis hub says
          what its readings are; a news section with no live sub-topic, or past its first page). The sentence stays the
          page's description for search engines, the about page's line and the editor's guide (select.mjs). */}
      {(HUB_SECTIONS.has(section.id) || topics.length === 0) && <p class="page-intro">{section.description}</p>}
      {section.id === "markets" && <a class="page-head__link ui" href="/markets/data/">لوحة الأسواق: المؤشرات والعملات والسلع</a>}
      <LinkRow label="المواضيع:" links={topics.map((t) => ({ href: topicHref(section.id, t.topic.id), name: t.topic.name }))} />
      <LinkRow label="المجالات:" links={divisions} />
    </header>

    {page.total === 0 ? (
      <p class="section-page__empty">لم تُنشر مواد في هذا القسم بعد. غرفة الأخبار تعمل على مدار الساعة.</p>
    ) : (
      <StoryFront articles={page.data} first={first} showSection={showKind} labelPool={all}>
        {weekly && (
          <section class="section-page__series" aria-labelledby="series-weekly">
            <div class="section-head">
              <h2 id="series-weekly"><a href={WEEKLY_HREF}>حصاد الأسبوع</a></h2>
              <a class="more" href={WEEKLY_HREF}>كل حلقات حصاد الأسبوع</a>
            </div>
            <StoryCard article={weekly} variant="lead" level={3} showSection={false} />
          </section>
        )}
      </StoryFront>
    )}

    <Pager page={page} label="صفحات القسم" />
  </section>
</Base>

<style>
  .section-page__empty { font-family: var(--font-ui); color: var(--ink-3); }
  /* The week's review: a block of its own between the day's analyses and the older ones, its head the series' name. */
  .section-page__series { margin-top: clamp(1.75rem, 3.5vw, 2.75rem); }
  .section-page__series :global(.card) { max-width: 64rem; }
  .page-head__link { display: inline-block; margin-top: 0.6rem; font-weight: 700; font-size: var(--fs-sm); color: var(--green); text-decoration: none; }
  .page-head__link:hover { text-decoration: underline; }
</style>
