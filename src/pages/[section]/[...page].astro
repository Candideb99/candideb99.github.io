---
import type { GetStaticPaths, Page } from "astro";
import Base from "@layouts/Base.astro";
import StoryCard from "@components/StoryCard.astro";
import { analysisDesk, analysisLabel, liveDesks } from "@lib/analysis";
import { menuTopics, topicHref } from "@lib/topics";
import type { Article } from "@lib/articles";
import { getArticles, getArticlesBySection, firstPictures } from "@lib/articles";
import { sections, HUB_SECTIONS, type Section } from "@lib/sections";
import { cardSizes } from "@lib/wikimedia";

/**
 * A section, newest first, in pages of twelve. The first page keeps the front-page shape (a lead
 * with three stories beside it); later pages are a plain grid of cards. Before this, الاقتصاد put
 * twenty-eight stories on one page and grew with every run.
 */
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const routes = [];
  for (const section of sections) {
    const articles = await getArticlesBySection(section.id);
    routes.push(
      ...paginate(articles, {
        params: { section: section.id },
        props: { section },
        pageSize: 12,
      }),
    );
  }
  return routes;
};

interface Props {
  section: Section;
  page: Page<Article>;
}
const { section, page } = Astro.props;
const all = section.id === "analysis" ? await getArticles() : [];
const first = page.currentPage === 1;
// News sections are their own label; the hubs print each story's kind (analysis desk, explainer, paper reading).
const showKind = HUB_SECTIONS.has(section.id);
const [lead, ...others] = page.data;
// Up to three stories beside the lead; when the section is small the ruled list takes them all,
// so a page never ends with one orphan card under a rule.
const besideCount = others.length <= 5 ? others.length : 3;
const beside = first ? others.slice(0, besideCount) : [];
const rest = first ? others.slice(besideCount) : page.data;
const pics = firstPictures(first ? [lead, ...beside, ...rest] : rest);
// A lead without a photograph runs across the page with the stories beside it as a ruled row under it.
const textLead = first && lead && !lead.data.image && beside.length > 0;
const title = first ? section.name : `${section.name} — صفحة ${page.currentPage}`;
// The sub-topics we are writing about (menuTopics, 2026-10-19), with their counts; the hubs list their own divisions
// the same way (the owner's check of the section pages, 2026-10-19: on a phone the analysis desks and the explainers'
// two kinds were reachable only from a piece's label). «الأسواق في لمحة», six quote cards under the markets lead, went
// the same day at his choice: the market strip above it is the site's one price line.
const everything = first ? await getArticles() : [];
const topics = first && !HUB_SECTIONS.has(section.id) ? menuTopics(everything, section.id) : [];
const divisions: { href: string; name: string; count: number }[] = !first
  ? []
  : section.id === "analysis"
    ? liveDesks(everything).map((desk) => ({ href: `/analysis/desk/${desk.id}/`, name: desk.label, count: everything.filter((a) => analysisDesk(a, everything)?.id === desk.id).length }))
    : section.id === "explainers"
      ? [
          { href: "/explainers/kind/concepts/", name: "شروح مبسّطة", count: everything.filter((a) => a.data.kind === "explainer").length },
          { href: "/explainers/kind/papers/", name: "قراءات في أوراق بحثية", count: everything.filter((a) => a.data.kind === "paper").length },
        ].filter((k) => k.count > 0)
      : [];
---

<Base title={title} description={`${section.name} في خازندار: ${section.description}`} path={page.url.current} section={section.id} printed={page.data.map((a) => a.id)}>
  <section class="wrap block" data-section={section.id}>
    <header class="page-head">
      <h1 class="page-title">{section.name}</h1>
      <p class="page-intro">{section.description}</p>
      {section.id === "markets" && <a class="page-head__link ui" href="/markets/data/">لوحة الأسواق: المؤشرات والعملات والسلع</a>}
      {topics.length > 0 && (
        <p class="page-head__topics ui">
          <span class="page-head__topics-label">المواضيع:</span>
          {topics.map((t) => <a href={topicHref(section.id, t.topic.id)}>{t.topic.name} <bdi>{t.count}</bdi></a>)}
        </p>
      )}
      {divisions.length > 0 && (
        <p class="page-head__topics ui">
          <span class="page-head__topics-label">{section.id === "analysis" ? "المجالات:" : "الأنواع:"}</span>
          {divisions.map((v) => <a href={v.href}>{v.name} <bdi>{v.count}</bdi></a>)}
        </p>
      )}
    </header>

    {page.total === 0 ? (
      <p class="section-page__empty">لم تُنشر مواد في هذا القسم بعد. غرفة الأخبار تعمل على مدار الساعة.</p>
    ) : (
      <div class="section-page">
        {first && lead && (
          <div class={`section-page__top${beside.length ? "" : " section-page__top--solo"}${textLead ? " section-page__top--text" : ""}`}>
            <div class="section-page__lead">
              <StoryCard article={lead} variant="lead" level={2} showSection={showKind} label={analysisLabel(lead, all)} showTopic eager />
            </div>
            {beside.length > 0 && (
              <div class="section-page__beside" style={textLead ? `--n:${Math.min(beside.length, 3)}` : undefined}>
                {beside.map((a) => (
                  <StoryCard article={a} variant="list" showSection={showKind} label={analysisLabel(a, all)} showExcerpt showPhoto={pics.has(a.id)} />
                ))}
              </div>
            )}
          </div>
        )}
        {rest.length > 0 && (
          <div class={`section-page__rest ${rest.length < 3 ? "cards cards--list" : "cards"}`} style={`--n:${Math.min(rest.length, 4)}`}>
            {rest.map((a, i) => (
              <StoryCard article={a} variant={rest.length < 3 ? "list" : "card"} showSection={showKind} label={analysisLabel(a, all)} showPhoto={pics.has(a.id)} showExcerpt={!pics.has(a.id)} eager={!first && i < 4} sizes={rest.length < 3 ? undefined : cardSizes(Math.min(rest.length, 4))} />
            ))}
          </div>
        )}
      </div>
    )}

    {page.lastPage > 1 && (
      <nav class="pager" aria-label="صفحات القسم">
        {page.url.prev ? (
          <a class="pager__step" href={page.url.prev} rel="prev">أحدث</a>
        ) : (
          <span class="pager__step pager__step--off" aria-hidden="true">أحدث</span>
        )}
        <p class="pager__count ui">صفحة <bdi>{page.currentPage}</bdi> من <bdi>{page.lastPage}</bdi></p>
        {page.url.next ? (
          <a class="pager__step" href={page.url.next} rel="next">أقدم</a>
        ) : (
          <span class="pager__step pager__step--off" aria-hidden="true">أقدم</span>
        )}
      </nav>
    )}
  </section>
</Base>

<style>
  .section-page__empty { font-family: var(--font-ui); color: var(--ink-3); }
  .section-page__top { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); column-gap: 0; align-items: start; }
  .section-page__lead { padding-inline-end: var(--col-gap); }
  .section-page__top--solo { grid-template-columns: 1fr; }
  .section-page__top--solo .section-page__lead { padding-inline-end: 0; max-width: 56rem; }
  .section-page__beside { border-inline-start: 1px solid var(--rule); padding-inline-start: var(--col-gap); display: grid; }
  .section-page__beside > :global(.card) { padding-block: 0.8rem; border-top: 1px solid var(--rule); }
  .section-page__beside > :global(.card:first-child) { border-top: 0; padding-top: 0.1rem; }
  /* Beside a lead with a photograph the three stories run as headlines with their thumbnails, as the front's briefs do:
     with an excerpt each, the list ran 103-248px past the lead and left that much blank paper under it on every news
     section (827 by 269px on الاقتصاد at 1440, 2026-10-19); without, the two columns end within about 60px. Phones,
     where the list runs under the lead, keep the excerpts. */
  @media (min-width: 1024px) {
    .section-page__top:not(.section-page__top--text) .section-page__beside :global(.card__summary) { display: none; }
  }
  /* A lead without a photograph: beside the list its column was a headline and a line over half a screen of blank
     paper (الأسواق, 2026-10-19). It now runs across the page at the reading measure, and the next stories stand under
     it in ruled columns, three to a row, as a text-only lead runs on a printed page. */
  @media (min-width: 1024px) {
    .section-page__top--text { grid-template-columns: 1fr; }
    .section-page__top--text .section-page__lead { padding-inline-end: 0; max-width: 56rem; }
    .section-page__top--text .section-page__beside { grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr)); border-inline-start: 0; padding-inline-start: 0; margin-top: 1.25rem; padding-top: 1.1rem; border-top: 1px solid var(--rule); }
    .section-page__top--text .section-page__beside > :global(.card) { padding-block: 0; padding-inline: var(--col-gap); border-top: 0; }
    .section-page__top--text .section-page__beside > :global(.card:nth-child(3n + 1)) { padding-inline-start: 0; }
    .section-page__top--text .section-page__beside > :global(.card:nth-child(3n)), .section-page__top--text .section-page__beside > :global(.card:last-child) { padding-inline-end: 0; }
    .section-page__top--text .section-page__beside > :global(.card:not(:nth-child(3n + 1))) { border-inline-start: 1px solid var(--rule); }
    .section-page__top--text .section-page__beside > :global(.card:nth-child(n + 4)) { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--rule); }
  }
  .section-page__rest { margin-top: clamp(1.5rem, 3vw, 2.5rem); border-top: 1px solid var(--ink); padding-top: 1.25rem; }
  .page-head__link { display: inline-block; margin-top: 0.6rem; font-weight: 700; font-size: var(--fs-sm); color: var(--green); text-decoration: none; }
  .page-head__link:hover { text-decoration: underline; }
  /* The lead runs like the cover (StoryCard.astro: the headline across the block, the summary beside the photograph);
     the photograph's column only when there is one: a lead without a photo kept the two columns and left half its block
     blank (2026-09-27). */

  .pager { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: clamp(1.5rem, 3vw, 2.5rem); border-top: 1px solid var(--rule); padding-top: 0.9rem; }
  .pager__step { font-family: var(--font-ui); font-weight: 700; font-size: var(--fs-sm); color: var(--green); text-decoration: none; padding: 0.4rem 0.8rem 0.3rem; border: 1px solid var(--rule); }
  .pager__step:hover { border-color: var(--green); }
  /* No newer page before the first, no older after the last: the step keeps its place, so the count stays centred,
     but is not drawn; a grey boxed «أحدث» on page 1 looked like a button that did nothing (2026-10-19). */
  .pager__step--off { visibility: hidden; }
  .pager__count { font-size: var(--fs-sm); color: var(--ink-3); }

  @media (max-width: 1023px) {
    .section-page__top { grid-template-columns: 1fr; row-gap: 1.25rem; }
    .section-page__lead { padding-inline-end: 0; }
    .section-page__beside { border-inline-start: 0; padding-inline-start: 0; border-top: 1px solid var(--rule); padding-top: 0.5rem; }
  }
</style>
