---
/**
 * The analyses of one desk (economic, markets, energy, companies, technology, defence and
 * geopolitics), newest first, so a reader can follow the paper's readings on one field without
 * the others in between.
 */
import Base from "@layouts/Base.astro";
import StoryCard from "@components/StoryCard.astro";
import { getArticles } from "@lib/articles";
import { ANALYSIS_DESKS, analysisDesk, analysisLabel } from "@lib/analysis";

export async function getStaticPaths() {
  const articles = await getArticles();
  return Object.keys(ANALYSIS_DESKS).map((desk) => ({
    params: { desk },
    props: { desk, label: ANALYSIS_DESKS[desk], items: articles.filter((a) => analysisDesk(a, articles)?.id === desk) },
  }));
}

interface Props {
  desk: string;
  label: string;
  items: Awaited<ReturnType<typeof getArticles>>;
}
const { desk, label, items } = Astro.props;
const all = await getArticles();
const n = items.length;
---

<Base title={label} description={`${label}: قراءات خازندار في هذا المجال.`} path={`/analysis/desk/${desk}/`} section="analysis">
  <section class="wrap block" data-section="analysis">
    <header class="page-head">
      <p class="page-head__section ui"><a href="/analysis/">تحليلات</a></p>
      <h1 class="page-title">{label}</h1>
      <p class="page-intro">{n > 0 ? <span>قراءات خازندار في هذا المجال، من الأحدث إلى الأقدم.</span> : <span>لم تُنشر قراءات في هذا المجال بعد؛ تُكتب التحليلات من تغطية خازندار نفسها حين تتراكم.</span>}</p>
      <p class="page-head__topics ui">
        <span class="page-head__topics-label">المجالات:</span>
        {Object.entries(ANALYSIS_DESKS).filter(([id]) => id !== desk).map(([id, name]) => <a href={`/analysis/desk/${id}/`}>{name}</a>)}
      </p>
    </header>
    {n > 0 && (
      <div class="cols cols--rows" style={`--n:${Math.min(n, 3)}`}>
        {items.map((a) => (
          <StoryCard article={a} variant="text" showSection label={analysisLabel(a, all)} showExcerpt />
        ))}
      </div>
    )}
  </section>
</Base>

<style>
</style>
