---
/**
 * The analyses of one desk (economic, markets, energy, companies, technology, defence and
 * geopolitics), newest first, so a reader can follow the paper's readings on one field without
 * the others in between.
 */
import Base from "@layouts/Base.astro";
import StoryFront from "@components/StoryFront.astro";
import LinkRow from "@components/LinkRow.astro";
import { getArticles } from "@lib/articles";
import { ANALYSIS_DESKS, analysisDesk, liveDesks } from "@lib/analysis";

export async function getStaticPaths() {
  const articles = await getArticles();
  return Object.keys(ANALYSIS_DESKS).map((desk) => ({
    params: { desk },
    props: { desk, label: ANALYSIS_DESKS[desk], items: articles.filter((a) => analysisDesk(a, articles)?.id === desk) },
  }));
}

interface Props {
  desk: string;
  label: string;
  items: Awaited<ReturnType<typeof getArticles>>;
}
const { desk, label, items } = Astro.props;
const all = await getArticles();
const n = items.length;
// The other desks we are writing in (liveDesks), never an empty page.
const siblings = liveDesks(all).filter((d) => d.id !== desk);
---

<Base title={label} description={`${label}: قراءات خازندار في هذا المجال.`} path={`/analysis/desk/${desk}/`} section="analysis">
  <section class="wrap block" data-section="analysis">
    <header class="page-head">
      <p class="page-head__section ui"><a href="/analysis/">تحليلات</a></p>
      <h1 class="page-title">{label}</h1>
      <p class="page-intro">{n > 0 ? <span>قراءات خازندار في هذا المجال، من الأحدث إلى الأقدم.</span> : <span>لم تُنشر قراءات في هذا المجال بعد؛ تُكتب التحليلات من تغطية خازندار نفسها حين تتراكم.</span>}</p>
      <LinkRow label="المجالات:" links={siblings.map((d) => ({ href: `/analysis/desk/${d.id}/`, name: d.label }))} />
    </header>
    {/* No label under each card: every one of them is this page's desk, its name the page's title (2026-11-20). Set
        out as the section's page since 2026-11-21: every analysis carries a photograph, and the page had printed
        columns of text. */}
    {n > 0 && <StoryFront articles={items} />}
  </section>
</Base>

<style>
</style>
