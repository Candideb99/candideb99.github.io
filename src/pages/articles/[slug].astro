---
import { render } from "astro:content";
import Base from "@layouts/Base.astro";
import Photo from "@components/Photo.astro";
import KeyFacts from "@components/KeyFacts.astro";
import Sources from "@components/Sources.astro";
import StoryCard from "@components/StoryCard.astro";
import Chart from "@components/Chart.astro";
import DataTable from "@components/DataTable.astro";
import Share from "@components/Share.astro";
import TextSize from "@components/TextSize.astro";
import { TEXT_SIZE_KEY, TEXT_SIZE_MIN, TEXT_SIZE_MAX } from "@lib/text-size";
import { getArticles, related, articleHref, stripStories } from "@lib/articles";
import { getSection, sectionHref, kindLabel, moreLabel, allLabel } from "@lib/sections";
import { subTopicOf, topicHref, tagHref, kickerOf } from "@lib/topics";
import { analysisLabel, analysisDesk, ANALYSIS_DESKS } from "@lib/analysis";
import { formatDate, formatHijri, formatTime, readingLabel, excerpt } from "@lib/format";
import { headline, isolateNumbers } from "@lib/bidi";
import { cardSizes } from "@lib/wikimedia";
import { safeHref } from "@lib/safe-url.mjs";
import site from "@data/site.json";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.data.slug }, props: { article } }));
}

const { article } = Astro.props;
const all = await getArticles();
const { Content } = await render(article);
const d = article.data;
const sec = getSection(d.section);
const isHub = d.kind === "explainer" || d.kind === "analysis" || d.kind === "paper" || d.kind === "weekly" || d.kind === "feature";
const description = d.subtitle || excerpt(d.lede, 160);
const ogImage = d.image?.url ?? `/og/${d.slug}.png`;
const more = related(article, all, 4);
// Over a news story's headline, its sub-topic (kickerOf), never a writer's tag (2026-10-20).
const kicker = isHub ? undefined : kickerOf(article);
// The story's tags as links, each to its one page (lib/topics.ts); two tags of one subject («النفط», «أسعار النفط») would
// be two chips to the same page, so only the first of them is printed.
const pills = d.tags.map((tag) => ({ tag, href: tagHref(tag) })).filter((p, i, all) => all.findIndex((q) => q.href === p.href) === i);
const path = articleHref(article);
// «اقرأ أيضاً» runs once inside the text (the first related story, moved after the third paragraph) and the rest in the
// side column; until 2026-10-19 the side list opened with the same story again, under the same label.
const sideRelated = more.slice(1);
// The paper does not end at the sources: the newest of the same section close the page, none of them already on it
// (related, or in the «آخر الأخبار» strip above). The side column's «الأحدث» (the five newest stories) went on 2026-10-19
// at the owner's choice: 17 of its 20 headlines on the pages checked were already in the strip at the top of the page.
const onPage = new Set([...more, ...stripStories(all, path)].map((a) => a.id));
const moreFromSection = all.filter((a) => a.data.section === d.section && a.id !== article.id && !onPage.has(a.id)).slice(0, 4);
// Internal sources point at the paper's own stories; one that has since been retired is named, not linked.
const known = new Set(all.map(articleHref));
const sources = d.sources.map((s) => {
  if (!s.url.startsWith("/")) return s;
  const href = s.url.replace(/\/?$/, "/");
  return known.has(href) ? { ...s, url: href } : { ...s, url: "" };
});

// Where the story sits: its section and, for news, the standing sub-topic it falls under (الطاقة ›
// النفط والغاز), as the Arab news sites print a trail above or beside the headline.
const sub = isHub ? undefined : subTopicOf(article);
// The kicker above the headline and the trail under it never name the same page (2026-10-19: «الصناعات الدفاعية» twice
// on Qatar's defence plant); the trail then stops at the section. The breadcrumb data keeps the full trail.
const subInTrail = sub && !(kicker && kicker.href === topicHref(d.section, sub.id)) ? sub : undefined;
const sectionLabel = analysisLabel(article, all) ?? kindLabel(d.kind, d.section);
// A piece of the paper's own (an analysis, the week's review, an explainer, a paper reading) is named by its kind over
// its headline, on a page head's 3px ink rule, where a news story carries its subject: an analysis had been told from
// news only by a 13.76px label in its date line, under a tag such as «الدار» (the critique of 2026-10-19). The kind
// leads to its own list: the analysis desk, or the explainers' kind.
const desk = analysisDesk(article, all);
const kindHead = isHub
  ? {
      label: sectionLabel,
      href:
        d.kind === "explainer" ? "/explainers/kind/concepts/"
        : d.kind === "paper" ? "/explainers/kind/papers/"
        : desk && ANALYSIS_DESKS[desk.id] ? `/analysis/desk/${desk.id}/`
        : sectionHref(d.section),
    }
  : undefined;
const trail = [
  { name: "الرئيسية", url: "/" },
  { name: sec.name, url: sectionHref(d.section) },
  ...(sub ? [{ name: sub.name, url: topicHref(d.section, sub.id) }] : []),
];

const articleLd = {
  "@context": "https://schema.org",
  "@type": isHub ? "Article" : "NewsArticle",
  headline: d.title,
  description,
  inLanguage: "ar",
  datePublished: d.publishedAt,
  dateModified: d.updatedAt ?? d.publishedAt,
  image: [new URL(ogImage, site.url).toString()],
  articleSection: sec.name,
  keywords: d.tags.join(", "),
  author: { "@type": "Organization", name: site.name, url: site.url },
  publisher: { "@type": "Organization", name: site.name, url: site.url, logo: { "@type": "ImageObject", url: new URL("/icon-512.png", site.url).toString() } },
  mainEntityOfPage: new URL(path, site.url).toString(),
  isBasedOn: d.sources.filter((s) => !s.url.startsWith("/")).map((s) => s.url),
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [...trail, { name: d.title, url: path }].map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: new URL(c.url, site.url).toString() })),
};
const jsonLd = [articleLd, breadcrumbLd];
---

<Base title={d.title} description={description} path={path} image={ogImage} imageAlt={d.image?.alt} type="article" section={d.section} jsonLd={jsonLd} publishedAt={d.publishedAt} updatedAt={d.updatedAt}>
  {/* Search can list a story by its date (`data-pagefind-sort`, in milliseconds so no colon splits the value): «النفط»
      listed 7 September to 1 October first, by relevance alone, with that day's oil stories out of sight (2026-10-19). */}
  <article class="article wrap--article" data-section={d.section} data-pagefind-body data-pagefind-meta={`section:${d.section}`} data-pagefind-sort={`date:${Date.parse(d.publishedAt)}`}>
    {/* The reader's own text size (TextSize.astro), put back before the text below is drawn so the page never jumps. */}
    <script is:inline define:vars={{ key: TEXT_SIZE_KEY, min: TEXT_SIZE_MIN, max: TEXT_SIZE_MAX }}>
      try { var px = Number(localStorage.getItem(key)); if (px >= min && px <= max) document.documentElement.style.setProperty("--reader-size", px + "px"); } catch (e) {}
    </script>
    <header class:list={["article__head", { "article__head--kind": kindHead }]}>
      {/* The kicker, the meta lines, the share row and the photo credit are furniture and stay out of the search text
          (data-pagefind-ignore; the meta values inside are still read): a result's excerpt read «الطاقة › أوبك+
          خازندار نُشر الجمعة 11 سبتمبر 2026 م.» before the story's first words (2026-10-19). */}
      {kindHead ? (
        <p class="article__kind" data-pagefind-ignore><a href={kindHead.href}>{kindHead.label}</a></p>
      ) : (
        kicker && <span class="kicker" data-pagefind-ignore><a href={kicker.href}>{kicker.label}</a></span>
      )}
      {/* The headline outweighs the body in search, and the dek comes next (2026-09-24: «التضخم في مصر» ranked a US
          story above «التضخم في مصر يتباطأ إلى 12.7%»). */}
      <h1 class="article__title" data-pagefind-meta={`title:${d.title}`} data-pagefind-weight="10" set:html={headline(d.title)} />
      {/* A search result prints the dek, as the desks' search pages print a story's standfirst: Pagefind's own excerpt
          opened on the headline's last words and ran on into the photo caption (2026-10-19). */}
      {d.subtitle && <p class="article__dek" data-pagefind-weight="4" data-pagefind-meta="summary" set:html={isolateNumbers(d.subtitle)} />}
      {/* Two lines on purpose: where the story sits and who wrote it, then when. The hour and the reading time are
          each kept whole, so a phone never leaves «بتوقيت القاهرة» or «دقيقتا قراءة» alone on a line (2026-09-24). */}
      <div class="article__meta" data-pagefind-ignore>
        <p class="meta">
          <span class="crumbs">
            <a href={sectionHref(d.section)} data-pagefind-meta={`sectionName:${sec.name}`}>{kindHead ? sec.name : sectionLabel}</a>
            {subInTrail && <span class="crumbs__sep" aria-hidden="true">›</span>}
            {subInTrail && <a href={topicHref(d.section, subInTrail.id)}>{subInTrail.name}</a>}
          </span>
          <span class="article__byline">{site.name}</span>
        </p>
        <p class="meta article__when">
          {/* Both calendars, as الشرق الأوسط prints them on every story (Task 4, 2026-09-24). */}
          <time datetime={d.publishedAt} data-pagefind-meta={`date:${formatDate(d.publishedAt, { weekday: false })}`}>نُشر {formatDate(d.publishedAt)} م، {formatHijri(d.publishedAt)}</time>
          <span class="article__whole">{formatTime(d.publishedAt)} {site.timeZoneLabel}</span>
          <span class="article__whole">{readingLabel(d.readingMinutes)}</span>
        </p>
      </div>
      <div class="article__tools" data-pagefind-ignore>
        <Share url={new URL(path, site.url).toString()} title={d.title} />
        <TextSize />
      </div>
    </header>

    {/* The photograph and its caption stay out of the search text: a stock refinery's «(صورة تعبيرية)» made a story
        match «نفط» for its picture (2026-10-19). */}
    {d.image && (
      <figure class="article__figure" data-pagefind-ignore>
        <Photo image={d.image} ratio="3/2" eager sizes="(min-width: 1100px) 1024px, 100vw" class="article__photo" />
        <figcaption class="article__caption ui">
          <span>{d.image.alt}</span>
          {d.image.credit && (
            <span class="article__credit" data-pagefind-ignore>
              الصورة: {safeHref(d.image.pageUrl) ? <a href={safeHref(d.image.pageUrl)} rel="noopener" target="_blank"><bdi>{d.image.credit}</bdi></a> : <bdi>{d.image.credit}</bdi>}
            </span>
          )}
        </figcaption>
      </figure>
    )}

    <div class="article__layout">
      <div class="article__main">
        {d.lede && <p class="article__lede" set:html={isolateNumbers(d.lede)} />}
        <KeyFacts facts={d.keyFacts} placement="inline" terms={d.kind === "explainer"} />
        {/* A chart's title elsewhere on the site links here (`#story-chart`): the reader who clicked a chart lands on
            the chart, not on a headline and a photograph that do not name it (the owner, 2026-09-28). */}
        {d.chart && <Chart chart={d.chart} id="story-chart" />}
        <div class="prose" data-body>
          <Content />
        </div>
        {more.length > 0 && (
          <aside class="also" data-also data-pagefind-ignore aria-labelledby="also-head">
            <span id="also-head" class="also__head ui">اقرأ أيضاً</span>
            <a class="also__link" href={articleHref(more[0])} set:html={headline(more[0].data.title)} />
          </aside>
        )}
        {d.table && <DataTable table={d.table} />}
        {/* «لماذا يهمّ» closes the story as a block of its own (the owner, 2026-09-27: it read as merged into the
            article at its beginning; it should stand at the end and separate). From 2026-09-23 it had followed the
            lede at the text's own size, and read as the story's second paragraph. */}
        {d.whyItMatters && (
          <section class="why" aria-labelledby="why-title">
            <h2 id="why-title" class="module__head">لماذا يهمّ</h2>
            <p class="why__text" set:html={isolateNumbers(d.whyItMatters)} />
          </section>
        )}
        {/* A corrected story says so at its foot, with the date and what changed (/methodology/: «نصحّح
            المقال نفسه ونثبّت في أسفله تاريخ التصحيح وما تغيّر»), as the desks print تصحيح. */}
        {d.corrections.length > 0 && (
          <aside class="corrections" aria-labelledby="corrections-head">
            <h2 id="corrections-head" class="corrections__head ui">تصحيح</h2>
            {d.corrections.map((c) => (
              <p class="corrections__item">
                <time class="ui" datetime={c.date}>{formatDate(c.date, { weekday: false })}</time>
                <span set:html={isolateNumbers(c.note)} />
              </p>
            ))}
          </aside>
        )}
        {d.tags.length > 0 && (
          <p class="tags">
            {pills.map((p) => (
              <a class="pill" href={p.href}>{p.tag}</a>
            ))}
          </p>
        )}
        <Sources sources={sources} explainer={isHub} />
      </div>
      {/* Other stories' headlines stay out of this story's search entry (data-pagefind-ignore below): the «الأحدث» rail
          put the five newest headlines in every article, so «مضيق هرمز» matched all 147 (2026-09-24). */}
      <aside class="article__side">
        <KeyFacts facts={d.keyFacts} placement="side" terms={d.kind === "explainer"} />
        {sideRelated.length > 0 && (
          <section class="side-related" data-pagefind-ignore aria-labelledby="side-related-title">
            <h2 id="side-related-title" class="module__head">اقرأ أيضاً</h2>
            <div class="side-related__list">
              {sideRelated.map((a) => (
                <StoryCard article={a} variant="text" showExcerpt={false} />
              ))}
            </div>
          </section>
        )}
      </aside>
    </div>
  </article>

  {moreFromSection.length >= 2 && (
    <section class="wrap--article article__more" aria-labelledby="more-head">
      <div class="section-head">
        <h2 id="more-head"><a href={sectionHref(d.section)}>{moreLabel(d.section)}</a></h2>
        <a class="more" href={sectionHref(d.section)}>{allLabel(d.section)}</a>
      </div>
      <div class={moreFromSection.length >= 3 ? "cards" : "cards cards--list"} style={`--n:${moreFromSection.length}`}>
        {moreFromSection.map((a) => (
          <StoryCard article={a} variant={moreFromSection.length >= 3 ? "card" : "list"} showSection={false} sizes={moreFromSection.length >= 3 ? cardSizes(moreFromSection.length) : undefined} />
        ))}
      </div>
    </section>
  )}
  <script is:inline>
    // Move the "read also" line after the third paragraph of the body; without JavaScript it
    // stays where it was rendered, at the end of the text.
    (function () {
      var also = document.querySelector("[data-also]");
      var body = document.querySelector("[data-body]");
      if (!also || !body) return;
      var paragraphs = body.querySelectorAll(":scope > p");
      if (paragraphs.length >= 5) paragraphs[2].insertAdjacentElement("afterend", also);
    })();
  </script>
</Base>

<style>
  .article__head { padding-top: clamp(1.5rem, 3.5vw, 2.5rem); max-width: 52rem; }
  /* A piece of the paper's own opens like a page head: the 3px ink rule, then its kind in the green Amiri of a module's
     label, over the headline. */
  .article__head--kind { padding-top: 0; margin-top: clamp(1.5rem, 3.5vw, 2.5rem); border-top: 3px solid var(--ink); }
  .article__kind { margin: 0.75rem 0 0.35rem; font-family: var(--font-title); font-weight: 700; font-size: var(--t-module); line-height: 1.3; color: var(--green); }
  .article__kind a { color: inherit; text-decoration: none; display: inline-block; padding-block: 0.2rem; }
  .article__kind a:hover { text-decoration: underline; }
  .article__more { padding-top: clamp(2.25rem, 4.5vw, 3.75rem); }
  /* اقرأ أيضاً inside the text, after the third paragraph, as the desks place it: a ruled line, not a box. */
  .also { max-width: var(--measure); margin: 1.25rem 0 1.5rem; padding: 0.55rem 0; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--rule); display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.75rem; }
  .also__head { font-weight: 700; font-size: var(--fs-xs); color: var(--green); white-space: nowrap; }
  .also__link { font-family: var(--font-title); font-weight: 700; font-size: var(--t-list); line-height: 1.45; color: var(--ink); text-decoration: none; }
  .also__link:hover { color: var(--green); }
  /* A story too short for the line to sit inside its text (fewer than five paragraphs) leaves it where it was printed,
     at the end, where it only repeated the first headline of the اقرأ أيضاً list beside or under the story and stacked
     a second pair of rules on top of لماذا يهمّ (2026-10-19). There it is not shown. */
  .article__main > .also { display: none; }
  .article__title {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: var(--t-display);
    line-height: 1.3;
    color: var(--ink);
  }
  .article__dek {
    font-family: var(--font-body);
    font-size: var(--n-dek);
    line-height: 1.65;
    color: var(--ink-2);
    margin-top: 0.7rem;
    max-width: 44rem;
  }
  .article__meta { margin-top: 0.9rem; padding-top: 0.6rem; border-top: 1px solid var(--rule); display: grid; gap: 0.2rem; }
  /* The share row at the start and the reader's text size at the end, on one line where they fit. */
  .article__tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; column-gap: 1.5rem; }
  .article__whole { white-space: nowrap; }
  .article__byline { font-weight: 700; color: var(--ink-2); }
  .crumbs { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.35rem; }
  .crumbs__sep { color: var(--ink-3); }

  /* The photograph runs at the width of the story, cropped to a panoramic frame so it never costs a whole screen. */
  .article__figure { margin: clamp(1.25rem, 3vw, 2rem) 0 0; }
  .article__figure :global(.article__photo) { aspect-ratio: 2 / 1 !important; }
  .article__caption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1.5rem; margin-top: 0.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--rule); font-size: var(--fs-sm); color: var(--ink-3); line-height: 1.5; }
  .article__credit a { color: var(--ink-3); }

  .article__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    column-gap: 0;
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
  }
  .article__main { max-width: none; padding-inline-end: clamp(1.5rem, 3vw, 2.75rem); }
  .article__main > :global(.prose) { max-width: var(--measure); }
  .article__lede {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--reader-size, var(--n-body));
    line-height: 1.85;
    margin-bottom: 1.25rem;
    max-width: var(--measure);
    text-align: justify;
    text-align-last: start;
  }
  /* A rule-bottomed block like the figures, not a box: the site draws rules, never frames. It sits
     under the lede and the figures, set at the text's own size (it was a step smaller than the text). */
  /* «لماذا يهمّ» closes the story, ruled off from it (the owner, 2026-09-27). It is the paper's own reading of the news,
     so it is set at the body's size in ink and marked off by its frame, not by a smaller face: the 1px ink rule that
     opens the corrections and the related line, its head, and a hairline under it. A step under the body (16px against
     20px, about 95 letters a line) it read as a footnote under the last paragraph (the critique of 2026-10-19). */
  .why { margin: 2.5rem 0 0.5rem; max-width: var(--measure); border-top: 1px solid var(--ink); padding-top: 0.85rem; border-bottom: 1px solid var(--rule); padding-bottom: 1.1rem; }
  .why__text { margin: 0; font-family: var(--font-body); font-size: var(--reader-size, var(--n-body)); line-height: 1.9; color: var(--ink); text-align: justify; text-align-last: start; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 1.5rem; }
  /* The correction note: a ruled line under the text, like اقرأ أيضاً, never a box. */
  .corrections { max-width: var(--measure); margin-top: 1.5rem; padding-block: 0.6rem; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--rule); }
  .corrections__head { font-weight: 700; font-size: var(--fs-xs); color: var(--green); margin-bottom: 0.25rem; }
  .corrections__item { font-family: var(--font-body); font-size: var(--n-text); line-height: 1.8; color: var(--ink-2); }
  .corrections__item time { font-size: var(--fs-sm); font-weight: 700; color: var(--ink-3); margin-inline-end: 0.5rem; }

  .article__side { border-inline-start: 1px solid var(--rule); padding-inline-start: clamp(1.5rem, 3vw, 2.5rem); display: grid; gap: 2rem; align-content: start; align-self: stretch; }
  .side-related__list { display: grid; }
  .side-related__list > :global(.card--text) { border-top: 1px solid var(--rule); padding-block: 0.7rem; }
  .side-related__list > :global(.card--text:first-child) { border-top: 0; padding-top: 0; }

  @media (max-width: 1023px) {
    .article__layout { grid-template-columns: 1fr; }
    .article__main { padding-inline-end: 0; }
    .article__side { border-inline-start: 0; padding-inline-start: 0; margin-top: 2rem; }
  }
  @media (max-width: 719px) {
    .article__figure :global(.article__photo) { aspect-ratio: 3 / 2 !important; }
    /* In a 343px column a bold lede a size above the text justified with word gaps nearly four
       spaces wide; at the text's size it keeps the column even. Even so the phone's column still opened
       gaps near four spaces wide, so on a phone the lede and لماذا يهمّ run flush to the start like the
       body (the owner, 2026-09-27). */
    .article__lede { text-align: start; }
    .why__text { text-align: start; }
  }
</style>
