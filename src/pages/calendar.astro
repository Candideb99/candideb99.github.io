---
/**
 * الأجندة الاقتصادية: the rate decisions and the large data releases of the coming three months, a column a month,
 * read from the institutions' own schedules (pipeline/calendar.mjs).
 *
 * The page as it stood until 2026-11-15 (the owner: "is this section well organized or still needs some
 * work/improvement/expansion … is not the sources should be collapsed like in the articles section"): seven events in
 * 75 days from five schedules, one flat list in a third of the page's width, each row saying its kind three times
 * («قرار فائدة» beside «قرار الفائدة: الاحتياطي الفيدرالي الأمريكي» over «الاحتياطي الفيدرالي»), a day's events in the
 * order of the sources and not of their hours, and the sources a paragraph written by hand that named neither a link
 * nor a date. Now: whole months side by side, so the quarter is read at a glance; over each event its hour and its
 * kind, as a story card carries its label over its headline; the institution once (a decision is headed by its bank,
 * a release by its own name with its publisher under it); and the sources as an article credits its own, one line
 * that opens the list, written from the data, where a schedule that has stopped answering or runs out early says so.
 */
import Base from "@layouts/Base.astro";
import Sources from "@components/Sources.astro";
import { byMonth, localTime, notYetIn, relativeDay, sourceNotes, calendar } from "@lib/calendar";
import { formatDate, formatTime, timeAgo } from "@lib/format";
import { safeHref } from "@lib/safe-url.mjs";
import site from "@data/site.json";

const months = byMonth(3);
const updated = calendar.updatedAt ? `${formatDate(calendar.updatedAt)}، ${formatTime(calendar.updatedAt)}` : "";
const KIND = { rates: "قرار فائدة", data: "بيانات", minutes: "محضر" } as const;
/** The last day the page covers: the end of its last month. */
const last = months.at(-1);
const until = last ? `${last.key}-31` : "";
const lastMonth = last?.label.split(" ")[0];
const sources = sourceNotes(until).map((s) => ({ name: s.name, title: s.what, url: s.url, detail: s.detail }));
/** A note under an event is said once on the page (2026-11-20): «مقياس التضخم الذي يعتمده الاحتياطي الفيدرالي» stood under
 *  all three PCE releases, and the Gulf pegs under both Fed decisions. Rendered in the page's order, months then days. */
const said = new Set<string>();
const once = (note?: string) => (note && !said.has(note) ? (said.add(note), note) : "");
/** «and» before the last of several names. */
const joined = (names: string[]) => (names.length > 1 ? `${names.slice(0, -1).join("، ")} و${names.at(-1)}` : names[0] ?? "");
/** «اليوم» or «غداً» beside a day, written at build time and turned with the clock in the page. */
const near = (date: string) => {
  const label = relativeDay(date);
  return label === "اليوم" || label === "غداً" ? label : "";
};
---

<Base title="الأجندة الاقتصادية" description="مواعيد قرارات الفائدة والبيانات الاقتصادية الكبرى في الأشهر المقبلة، من جداول المؤسسات نفسها." path="/calendar/">
  <section class="wrap block">
    <header class="page-head">
      <h1 class="page-title">الأجندة الاقتصادية</h1>
      <p class="page-intro">قرارات الفائدة والبيانات الاقتصادية الكبرى المنتظرة{lastMonth && <span> حتى نهاية {lastMonth}</span>}، بمواعيدها كما تعلنها المؤسسات نفسها{calendar.updatedAt && <span>، حُدّثت <time datetime={calendar.updatedAt} data-relative title={updated}>{timeAgo(calendar.updatedAt)}</time></span>}. الأوقات {site.timeZoneLabel}.</p>
    </header>

    {months.length === 0 ? (
      <p class="empty ui">لا مواعيد مسجّلة في الفترة المقبلة.</p>
    ) : (
      <div class="months">
        {months.map((m) => (
          <section class="month" aria-labelledby={`month-${m.key}`}>
            <h2 id={`month-${m.key}`} class="module__head">{m.label}</h2>
            <ol class="days">
              {m.days.map((d) => (
                <li class="day" data-agenda-date={d.date}>
                  <h3 class="day__date ui">
                    <time datetime={d.date}>{d.label}</time>
                    <span class="day__near">{near(d.date)}</span>
                  </h3>
                  <ul class="day__events">
                    {d.events.map((e) => {
                      const at = localTime(e);
                      // A decision or a set of minutes is headed by its institution, a release by its own name.
                      const named = e.kind === "data";
                      const note = once(e.note);
                      return (
                        <li class="event">
                          <p class="event__label ui">{at && <bdi class="event__time">{at}</bdi>}<span class={`event__kind event__kind--${e.kind}`}>{KIND[e.kind]}</span></p>
                          <p class="event__title"><a href={safeHref(e.url)} rel="noopener nofollow" target="_blank">{named ? e.title : e.org}</a></p>
                          {(named || note) && <p class="event__meta ui">{named && e.org}{named && note && "، "}{note}</p>}
                        </li>
                      );
                    })}
                  </ul>
                </li>
              ))}
            </ol>
            {notYetIn(m.key).length > 0 && <p class="month__pending ui">لم تُعلَن بعد مواعيد {joined(notYetIn(m.key))} لهذا الشهر.</p>}
          </section>
        ))}
      </div>
    )}

    {sources.length > 0 && (
      <Sources sources={sources} credit note="تُقرأ المواعيد آلياً من جداول هذه المؤسسات عدة مرات في اليوم، وقد تعدّلها المؤسسة بعد إعلانها. عند أي تعارض يُعتدّ بجدول المؤسسة." />
    )}
  </section>
</Base>

{/* The days are written at build time and turned with the clock here, as the front's module is (Base.astro): between
    midnight and the next build a day gone by stood among the coming ones, and «اليوم» over yesterday's. */}
<script is:inline define:vars={{ zone: site.timeZone }}>
  (function () {
    function today() {
      try {
        return new Intl.DateTimeFormat("en-CA", { timeZone: zone, year: "numeric", month: "2-digit", day: "2-digit" }).format(new Date());
      } catch (e) {
        return null;
      }
    }
    function turn() {
      var now = today();
      if (!now || !/^\d{4}-\d{2}-\d{2}$/.test(now)) return;
      var months = document.querySelectorAll(".month");
      for (var i = 0; i < months.length; i++) {
        var days = months[i].querySelectorAll("[data-agenda-date]");
        var left = 0;
        for (var j = 0; j < days.length; j++) {
          var diff = Math.round((Date.parse(days[j].getAttribute("data-agenda-date")) - Date.parse(now)) / 86400000);
          if (!isFinite(diff)) continue;
          // The row's own `display: grid` outranks the hidden attribute, so it is put away by its style.
          days[j].style.display = diff < 0 ? "none" : "";
          if (diff >= 0) left++;
          var near = days[j].querySelector(".day__near");
          var label = diff === 0 ? "اليوم" : diff === 1 ? "غداً" : "";
          if (near && near.textContent !== label) near.textContent = label;
        }
        months[i].style.display = left ? "" : "none";
      }
    }
    turn();
    setInterval(turn, 60000);
  })();
</script>

<style>
  .page-intro time { color: inherit; }
  .empty { color: var(--ink-3); }
  /* A column a month: three across a desk's screen, two on a tablet, one on a phone. */
  .months { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); gap: 2rem var(--col-gap); align-items: start; }
  .days { display: grid; }
  /* The day at the side of its events; the month is in the column's head. */
  .day { display: grid; grid-template-columns: 5.25rem minmax(0, 1fr); column-gap: 0.75rem; padding-block: 0.8rem; border-top: 1px solid var(--rule); }
  .day:first-child { border-top: 0; padding-top: 0.2rem; }
  .day__date { font-size: var(--fs-sm); font-weight: 700; color: var(--ink); line-height: 1.5; }
  .day__near { display: block; font-size: var(--fs-xs); color: var(--green); }
  .day__near:empty { display: none; }
  .day__events { display: grid; row-gap: 0.75rem; }
  .event__label { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 0.5rem; font-size: var(--fs-xs); font-weight: 700; line-height: 1.5; color: var(--ink-3); }
  .event__time { color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .event__kind--rates { color: var(--green); }
  .event__title { font-family: var(--font-title); font-weight: 700; font-size: var(--t-list); line-height: 1.45; text-wrap: balance; }
  .event__title a { text-decoration: none; }
  .event__title a:hover { color: var(--green); }
  .event__meta { font-size: var(--fs-xs); color: var(--ink-3); line-height: 1.55; margin-top: 0.1rem; }
  /* A month some schedules have not reached yet says so at its foot, so it does not read as a quiet month. */
  .month__pending { margin-top: 0.6rem; padding-top: 0.6rem; border-top: 1px solid var(--rule); font-size: var(--fs-xs); line-height: 1.6; color: var(--ink-3); }
</style>
