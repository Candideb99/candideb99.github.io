---
import Base from "@layouts/Base.astro";
import site from "@data/site.json";
// The contact form (2026-11-19). It posts to the site's own endpoint (functions/api/contact.js, a Cloudflare Pages
// Function) and the owner reads the messages in the control room; no address is printed anywhere. The GitHub Pages
// mirror has no Functions, so there the form posts to the live site.
const endpoint = new URL("/api/contact", site.url).toString();
const topics = [
  { id: "correction", name: "تصحيح خبر" },
  { id: "suggestion", name: "ملاحظة أو اقتراح" },
  { id: "business", name: "إعلانات وشراكات" },
  { id: "other", name: "أمر آخر" },
];
---

<Base title="تواصل معنا" description="راسل خازندار: تصحيح لخبر، ملاحظة على الموقع، أو استفسار تجاري." path="/contact/">
  <section class="wrap block contact" data-pagefind-ignore>
    <header class="page-head">
      <h1 class="page-title">تواصل معنا</h1>
      <p class="page-intro">تصحيحٌ لخبر، ملاحظةٌ على الموقع، أو استفسارٌ تجاري: اكتب لنا هنا. تصل رسالتك إلى المحرر وحده، ولا تُنشر.</p>
    </header>

    <div class="contact__grid">
      <div class="contact__main">
        <form class="contact__form" id="contact-form" novalidate>
          <p class="contact__about ui" id="contact-about" hidden>
            <span>بخصوص:</span>
            <a id="contact-about-link" href="/">المقال الذي كنت تقرؤه</a>
            <button type="button" id="contact-about-drop" aria-label="إزالة الإشارة إلى المقال">إزالة</button>
          </p>

          <fieldset class="contact__topics">
            <legend class="contact__label">موضوع الرسالة</legend>
            <div class="contact__choices">
              {topics.map((t, i) => (
                <label class="contact__choice">
                  <input type="radio" name="topic" value={t.id} checked={i === 1} />
                  <span>{t.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="contact__field">
            <label class="contact__label" for="contact-message">الرسالة</label>
            <textarea id="contact-message" name="message" rows="7" maxlength="5000" required dir="auto" aria-describedby="contact-hint"></textarea>
            <p class="contact__hint" id="contact-hint" data-correction="اذكر الجملة التي تراها خاطئة، والمصدر الذي يثبت الصواب إن وُجد." data-plain=""></p>
          </div>

          <div class="contact__row">
            <div class="contact__field">
              <label class="contact__label" for="contact-name">الاسم <span class="contact__opt">اختياري</span></label>
              <input id="contact-name" name="name" type="text" maxlength="100" autocomplete="name" dir="auto" />
            </div>
            <div class="contact__field">
              <label class="contact__label" for="contact-email">بريدك الإلكتروني <span class="contact__opt">اختياري، إن أردت رداً</span></label>
              <input id="contact-email" name="email" type="email" maxlength="200" autocomplete="email" dir="ltr" inputmode="email" />
            </div>
          </div>

          {/* A field people never see: a program that fills every field gives itself away. */}
          <div class="contact__trap" aria-hidden="true">
            <label for="contact-website">Website</label>
            <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="contact__send">
            <button type="submit" class="contact__go" id="contact-go">إرسال</button>
            <p class="contact__status ui" id="contact-status" role="status"></p>
          </div>
          <noscript><p class="contact__status contact__status--err ui">يحتاج النموذج إلى تفعيل JavaScript في متصفحك.</p></noscript>
        </form>

        <div class="contact__done" id="contact-done" tabindex="-1" hidden>
          <h2 class="contact__done-head">وصلت رسالتك</h2>
          <p>شكراً لك. نقرأ كل ما يصلنا، ونردّ على من ترك بريداً للرد.</p>
          <p class="ui"><button type="button" class="contact__again" id="contact-again">كتابة رسالة أخرى</button> <a href="/">العودة إلى الصفحة الرئيسية</a></p>
        </div>
      </div>

      <aside class="contact__side" aria-labelledby="contact-side-head">
        <h2 id="contact-side-head" class="module__head">قبل أن تكتب</h2>
        <dl class="contact__notes">
          <dt>التصحيحات</dt>
          <dd>نراجع كل بلاغ مقابل مصادر الخبر. إن ثبت الخطأ صحّحنا المقال نفسه وأثبتنا التصحيح في أسفله، كما توضح <a href="/methodology/">المنهجية</a>.</dd>
          <dt>ما لا نجيب عنه</dt>
          <dd>لا يقدّم خازندار نصائح استثمارية، ولا توصيات بالبيع أو الشراء.</dd>
          <dt>خصوصيتك</dt>
          <dd>نحفظ نص الرسالة وما تكتبه من اسم وبريد، ووقت الإرسال والبلد الذي أُرسلت منه. لا نحفظ عنوان جهازك، ولا نشارك الرسائل مع أحد. التفاصيل في <a href="/privacy/">سياسة الخصوصية</a>.</dd>
        </dl>
      </aside>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ endpoint }}>
  (function () {
    var form = document.getElementById("contact-form");
    if (!form) return;
    var done = document.getElementById("contact-done");
    var status = document.getElementById("contact-status");
    var go = document.getElementById("contact-go");
    var hint = document.getElementById("contact-hint");
    var about = document.getElementById("contact-about");
    var aboutLink = document.getElementById("contact-about-link");
    var message = form.elements.namedItem("message");
    // The live site answers on its own address; only the mirror, which has no endpoint, posts across.
    var api = /\.github\.io$/.test(location.hostname) ? endpoint : "/api/contact";
    var opened = Date.now();
    var story = "";

    function say(text, kind) {
      status.textContent = text;
      status.className = "contact__status ui" + (kind ? " contact__status--" + kind : "");
    }
    function topic() {
      var picked = form.querySelector('input[name="topic"]:checked');
      return picked ? picked.value : "other";
    }
    function showHint() {
      hint.textContent = topic() === "correction" ? hint.dataset.correction : hint.dataset.plain;
    }
    form.querySelectorAll('input[name="topic"]').forEach(function (r) { r.addEventListener("change", showHint); });

    // «أبلغنا عن خطأ» under a story opens this page with the story's address name: the message then carries it, the
    // subject is a correction, and the story's headline is read from its own page.
    var params = new URLSearchParams(location.search);
    var asked = params.get("story") || "";
    if (/^[a-z0-9][a-z0-9-]{0,159}$/.test(asked)) {
      story = asked;
      aboutLink.href = "/articles/" + story + "/";
      about.hidden = false;
      var correction = form.querySelector('input[name="topic"][value="correction"]');
      if (correction) correction.checked = true;
      fetch(aboutLink.href).then(function (r) { return r.ok ? r.text() : ""; }).then(function (html) {
        var h1 = html && new DOMParser().parseFromString(html, "text/html").querySelector("h1");
        var title = h1 && h1.textContent.trim();
        if (title) aboutLink.textContent = "«" + title + "»";
      }).catch(function () {});
    }
    document.getElementById("contact-about-drop").addEventListener("click", function () {
      story = "";
      about.hidden = true;
      message.focus();
    });
    showHint();

    form.addEventListener("submit", function (ev) {
      ev.preventDefault();
      var email = form.elements.namedItem("email");
      if (message.value.trim().length < 5) { say("اكتب رسالتك أولاً.", "err"); message.focus(); return; }
      if (email.value.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) { say("عنوان البريد لا يبدو صحيحاً.", "err"); email.focus(); return; }
      go.disabled = true;
      say("جارٍ الإرسال…", "");
      fetch(api, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          topic: topic(),
          message: message.value,
          name: form.elements.namedItem("name").value,
          email: email.value,
          story: story,
          website: form.elements.namedItem("website").value,
          elapsed: Date.now() - opened,
        }),
      }).then(function (r) {
        return r.json().catch(function () { return {}; }).then(function (out) {
          if (r.ok && out.ok) {
            form.reset();
            say("", "");
            form.hidden = true;
            done.hidden = false;
            done.focus();
          } else {
            // A second try a moment later is a person's, not a program's.
            opened = Date.now() - 2000;
            say(out.error || "تعذّر إرسال الرسالة. حاول مرة أخرى بعد قليل.", "err");
          }
        });
      }).catch(function () {
        say("لا اتصال بالإنترنت. حاول مرة أخرى.", "err");
      }).then(function () { go.disabled = false; });
    });

    document.getElementById("contact-again").addEventListener("click", function () {
      done.hidden = true;
      form.hidden = false;
      opened = Date.now();
      showHint();
      message.focus();
    });
  })();
</script>

<style>
  .contact__grid { display: grid; grid-template-columns: minmax(0, 40rem) minmax(0, 20rem); justify-content: space-between; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .contact__form { display: grid; gap: 1.4rem; }
  .contact__form[hidden], .contact__done[hidden], .contact__about[hidden] { display: none; }
  .contact__label { display: block; font-family: var(--font-ui); font-weight: 700; font-size: var(--fs-sm); color: var(--ink); margin-bottom: 0.4rem; padding: 0; }
  .contact__opt { font-weight: 500; color: var(--ink-3); margin-inline-start: 0.35rem; }

  /* The story a message is about: a ruled line in the furniture face, as a correction note is. */
  .contact__about { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.5rem; padding-block: 0.6rem; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--rule); font-size: var(--fs-sm); color: var(--ink-3); }
  .contact__about span { font-weight: 700; color: var(--green); }
  .contact__about a { font-family: var(--font-body); font-weight: 700; font-size: var(--n-text); color: var(--ink); text-decoration: none; }
  .contact__about a:hover { color: var(--green); text-decoration: underline; }
  .contact__about button { margin-inline-start: auto; font: inherit; color: var(--ink-3); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; }
  .contact__about button:hover { color: var(--ink); }

  /* The subject: one choice of four. The chosen one turns green and bold on a green rule, as a state does on this
     site, never by a fill. */
  .contact__topics { border: 0; padding: 0; margin: 0; min-width: 0; }
  .contact__choices { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .contact__choice { position: relative; cursor: pointer; }
  .contact__choice input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .contact__choice span { display: inline-flex; align-items: center; min-height: var(--tap); padding-inline: 0.95rem; border: 1px solid var(--rule); font-family: var(--font-ui); font-weight: 500; font-size: var(--fs-sm); color: var(--ink-2); background: var(--paper); }
  .contact__choice:hover span { border-color: var(--ink-3); color: var(--ink); }
  .contact__choice input:checked + span { border-color: var(--green); box-shadow: inset 0 -2px 0 var(--green); color: var(--green); font-weight: 700; }
  .contact__choice input:focus-visible + span { outline: 2px solid var(--green); outline-offset: 3px; }

  .contact__field { min-width: 0; }
  .contact__form textarea, .contact__form input[type="text"], .contact__form input[type="email"] {
    display: block;
    width: 100%;
    font-family: var(--font-body);
    font-size: var(--n-text);
    line-height: 1.7;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-bottom: 2px solid var(--ink);
    border-radius: 0;
    padding: 0.6rem 0.75rem;
  }
  .contact__form textarea { resize: vertical; min-height: 11rem; }
  .contact__form input[type="email"] { font-family: var(--font-ui); text-align: start; }
  /* Focus thickens the rule and turns it green, as the search field does. */
  .contact__form textarea:focus, .contact__form input[type="text"]:focus, .contact__form input[type="email"]:focus { outline: none; border-color: var(--green); border-bottom-width: 3px; padding-bottom: calc(0.6rem - 1px); }
  .contact__hint { font-family: var(--font-body); font-size: var(--fs-sm); line-height: 1.7; color: var(--ink-3); margin-top: 0.35rem; }
  .contact__hint:empty { margin: 0; }
  .contact__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }

  .contact__trap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .contact__send { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.1rem; }
  /* The one filled control on the page: the house green as a plate, the paper's colour as ink. */
  .contact__go { min-height: var(--tap); padding: 0.5rem 2rem 0.4rem; font-family: var(--font-ui); font-weight: 700; font-size: var(--n-text); color: var(--paper); background: var(--green); border: 1px solid var(--green); border-radius: 0; cursor: pointer; }
  .contact__go:hover { background: var(--green-deep); border-color: var(--green-deep); }
  .contact__go:disabled { opacity: 0.6; cursor: default; }
  .contact__status { font-size: var(--fs-sm); color: var(--ink-3); }
  .contact__status:empty { margin: 0; }
  .contact__status--err { color: var(--down); font-weight: 700; }

  .contact__done { border-top: 3px solid var(--green); padding-top: 1rem; }
  .contact__done:focus { outline: none; }
  .contact__done-head { font-family: var(--font-title); font-weight: 700; font-size: var(--t-feature); line-height: 1.4; color: var(--green); }
  .contact__done p { font-family: var(--font-body); font-size: var(--n-lead); line-height: 1.8; color: var(--ink-2); margin-top: 0.4rem; }
  .contact__done p.ui { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.25rem; margin-top: 1.1rem; font-family: var(--font-ui); font-size: var(--fs-sm); }
  .contact__done a { color: var(--green); font-weight: 700; text-decoration: none; }
  .contact__done a:hover { text-decoration: underline; }
  .contact__again { min-height: var(--tap); padding: 0.5rem 1.2rem 0.4rem; font-family: var(--font-ui); font-weight: 700; font-size: var(--fs-sm); color: var(--green); background: none; border: 1px solid var(--rule); cursor: pointer; }
  .contact__again:hover { border-color: var(--green); }

  .contact__notes dt { font-family: var(--font-ui); font-weight: 700; font-size: var(--fs-sm); color: var(--ink); margin-top: 1rem; }
  .contact__notes dt:first-child { margin-top: 0; }
  .contact__notes dd { margin: 0.2rem 0 0; font-family: var(--font-body); font-size: var(--n-text); line-height: 1.8; color: var(--ink-2); }
  .contact__notes a { color: var(--green); text-decoration: underline; }

  @media (max-width: 899px) {
    .contact__grid { grid-template-columns: minmax(0, 1fr); }
    .contact__side { max-width: 40rem; }
  }
  @media (max-width: 519px) {
    .contact__row { grid-template-columns: 1fr; }
    .contact__choices { display: grid; grid-template-columns: 1fr 1fr; }
    .contact__choice span { width: 100%; justify-content: center; padding-inline: 0.4rem; }
    .contact__go { width: 100%; }
  }
</style>
