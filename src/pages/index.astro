---
import Base from "@layouts/Base.astro";
import Cover from "@components/Cover.astro";
import Front from "@components/Front.astro";
import Ticker from "@components/Ticker.astro";
import FilesRow from "@components/FilesRow.astro";
import StoryCard from "@components/StoryCard.astro";
import Chart from "@components/Chart.astro";
import { DESKS, desksOf } from "@lib/regions";
import { analysisLabel } from "@lib/analysis";
import { getArticles, pickLead, threads, chartOfTheDay, hoursOld, repeatedEvents, onTheSameTopic, firstPictures, type Article } from "@lib/articles";
import { newsSections, getSection, sectionHref, moreLabel } from "@lib/sections";
import { articleHref } from "@lib/articles";
import { isolateNumbers } from "@lib/bidi";
import { cardSizes } from "@lib/wikimedia";
import { timeAgo, countLabel } from "@lib/format";
import site from "@data/site.json";

const articles = await getArticles();
// The lead: the editor's featured story, else the strongest of the last day (lib/articles.ts).
const lead = pickLead(articles);
// One event, one story on the front: when the newsroom has filed an event twice (two oil stories on
// one day's talks, two on one White House announcement, 2026-09-21), the older telling is left to
// its section page. The lead is looked at first, so its telling is the one that stays.
const allNews = articles.filter((a) => a.data.kind === "news");
const repeats = repeatedEvents(lead ? [lead, ...allNews.filter((a) => a.id !== lead.id)] : allNews);
const news = allNews.filter((a) => !repeats.has(a.id));
const importance = (a: Article) => (a.data.quality?.importance ?? 5) + (a.data.image ? 0.5 : 0);
const byImportance = (list: Article[]) => [...list].sort((x, y) => importance(y) - importance(x));
// How long a story stays fresh enough for a section block on the front.
const FRESH_HOURS = 72;

// Every story is printed once on the front page (the owner chose the clean-up on 2026-09-27, when 26 of the
// page's 55 stories were printed two to four times): each module takes only stories no module above it has
// placed. The strip, the day's figures and the charts are furniture and cite stories printed elsewhere.
const placed = new Set<string>();
const place = (list: Article[]) => list.forEach((a) => placed.add(a.id));
const unplaced = (list: Article[]) => list.filter((a) => !placed.has(a.id));

// The cover: the lead on the stage with the four strongest of the freshest dozen turning behind it.
const cover = lead ? [lead, ...byImportance(unplaced(news).filter((a) => a.id !== lead.id).slice(0, 12)).slice(0, 4)] : [];
place(cover);
// The column beside the cover is the paper's own voice: one reading of each kind, so the column
// never shows three items of the same shape under the same label.
// The week's review leads the column in the days after it appears; otherwise the latest analysis does.
// «في العمق» (the weekly in-depth piece, 2026-09-24) takes the research reading's place for its first three
// days: the column is three readings wide by design (three columns on a tablet).
const freshFeature = articles.find((a) => a.data.kind === "feature" && Date.now() - Date.parse(a.data.publishedAt) < 3 * 864e5);
const readings = [
  ...articles.filter((a) => a.data.kind === "weekly" || a.data.kind === "analysis").slice(0, 1),
  ...articles.filter((a) => a.data.kind === "explainer").slice(0, 1),
  ...(freshFeature ? [freshFeature] : articles.filter((a) => a.data.kind === "paper").slice(0, 1)),
];
place(readings);
const secondary = byImportance(unplaced(news).slice(0, 8)).slice(0, 2);
place(secondary);
// The digest: the next seven stories, each its headline and one sentence, newest first.
const digest = unplaced(news).slice(0, 7);
place(digest);
// Picks are the strongest of the last three days: ranked by importance alone they reached back a week,
// and one said the Saudi pipeline had closed beside a lead saying it had reopened.
const picks = byImportance(unplaced(articles).filter((a) => !repeats.has(a.id) && hoursOld(a) < 72)).slice(0, 4);
place(picks);
// The strip (أيضاً على خازندار) carries the newest stories not already on the first screen, so no
// headline prints twice above the fold; it names each story's section, not its age.
const ticker = unplaced(news).slice(0, 5);
// Under each cover story, up to two headlines on its running topic (ذات صلة) from the last week, none already on
// the first screen or under another cover story; they fill the text column beside the photograph with the story's
// own context. Until 2026-09-27 they could reach back two weeks (a 12-day-old story under the lead).
const onFirstScreen = new Set([...placed, ...ticker.map((a) => a.id)]);
const relatedPool = articles.filter((a) => !repeats.has(a.id));
const coverRelated = new Map<string, Article[]>();
for (const story of cover) {
  const list = onTheSameTopic(story, relatedPool, { exclude: onFirstScreen, days: 7 });
  list.forEach((a) => onFirstScreen.add(a.id));
  coverRelated.set(story.id, list);
  place(list);
}

// Today's figures: one telling number per recent story, never a bare year or a sprawling value. Never an explainer's:
// its numbers are illustrative examples, and its box is a glossary (2026-09-27).
const figureScore = (value: string) => {
  const v = value.trim();
  if (!/\d/.test(v) || /^(19|20)\d{2}$/.test(v) || v.length > 30) return -1;
  return (/[%٪]/.test(v) ? 2 : 0) + (/(مليار|مليون|ألف|دولار|ريال|يورو|جنيه|دينار|درهم|يوان|طن|برميل)/.test(v) ? 2 : 0) + (v.length <= 18 ? 1 : 0);
};
const figures = articles
  .filter((a) => a.data.kind !== "explainer")
  .slice(0, 8)
  .flatMap((a) => {
    const best = [...a.data.keyFacts].map((f) => ({ ...f, article: a, score: figureScore(f.value) })).filter((f) => f.score >= 0 && (f.label ?? "").length <= 48).sort((x, y) => y.score - x.score)[0];
    return best ? [best] : [];
  })
  .slice(0, 3);
const chart = chartOfTheDay(articles);
// ملفات نتابعها runs as a row under the section bar: what the paper is following this week, subjects and running
// files alike, busiest first, each once under its one page (lib/articles.ts `threads`). The band of four files it
// replaced printed three headlines each, 10 of 12 of them printed elsewhere.
const files = threads(articles.filter((a) => !repeats.has(a.id)));
// The charts band (the Economist's graphic detail): the three freshest charts after the chart of the day.
const chartsBand = articles
  .filter((a) => a.id !== chart?.id && a.data.chart && a.data.chart.title && a.data.chart.categories.length <= 8 && a.data.chart.series.length <= 2)
  .slice(0, 3);

// Section blocks: a feature and up to three briefs, only stories no module above has printed and none older than
// three days; the blocks follow the news, the section with the newest story first. A section with fewer than two
// such stories runs as one line in «من الأقسام» (its newest story not yet printed, with its date) instead of a block
// filled with reprints and week-old stories (الدفاع's stories on the front had a median age of 214 hours).
const sectionPools = newsSections.map((section) => ({ section, pool: unplaced(news.filter((a) => a.data.section === section.id)) }));
const rows = sectionPools
  .map(({ section, pool }) => ({ section, items: pool.filter((a) => hoursOld(a) < FRESH_HOURS).slice(0, 4) }))
  .filter((r) => r.items.length >= 2)
  .sort((x, y) => Date.parse(y.items[0].data.publishedAt) - Date.parse(x.items[0].data.publishedAt));
rows.forEach((r) => place(r.items));
const lines = sectionPools
  .filter(({ section }) => !rows.some((r) => r.section.id === section.id))
  .map(({ section, pool }) => ({ section, story: pool[0] as Article | undefined }))
  .sort((x, y) => (y.story ? Date.parse(y.story.data.publishedAt) : 0) - (x.story ? Date.parse(x.story.data.publishedAt) : 0));
lines.forEach((l) => l.story && place([l.story]));

// الأخبار بحسب المنطقة, the four desks readers see, as a way in rather than a fourth printing: each desk its count, its
// last update and at most one story of the last three days no module above has printed (it reprinted 11 of 12).
const desks = DESKS.map((d) => {
  const inDesk = news.filter((a) => desksOf(a).some((x) => x.id === d.id));
  const story = unplaced(inDesk).find((a) => hoursOld(a) < FRESH_HOURS);
  if (story) place([story]);
  return { ...d, count: inDesk.length, latest: inDesk[0], story };
}).filter((d) => d.count > 0);

// The hubs: analyses and explainers run as text in ruled columns, which also tells the reader at a
// glance that these are argument and concept pieces, not news reports; the readings shown beside the
// cover are not printed again.
const hubs = [
  { id: "analysis", kind: "analysis", more: "كل التحليلات" },
  { id: "explainers", kind: "explainer", more: "كل المواد" },
]
  .map((h) => ({ ...h, section: getSection(h.id), items: unplaced(articles.filter((a) => a.data.kind === h.kind || (h.id === "explainers" && a.data.kind === "paper") || (h.id === "analysis" && (a.data.kind === "weekly" || a.data.kind === "feature")))).slice(0, 4) }))
  .filter((h) => h.items.length > 0);

// A picture is printed once per page even when two stories share it.
const photoIds = firstPictures([...cover, ...secondary, ...rows.flatMap((r) => r.items), ...hubs.flatMap((h) => h.items)]);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsMediaOrganization",
  name: site.name,
  alternateName: site.latinName,
  url: site.url,
  description: site.description,
  inLanguage: "ar",
  logo: new URL("/icon-512.png", site.url).toString(),
};
---

<Base jsonLd={jsonLd} section="home">
  <FilesRow slot="under-bar" files={files} />
  <h1 class="visually-hidden">{site.name} — {site.tagline}</h1>
  {cover.length > 0 ? (
    <>
      <Ticker items={ticker} />
      <div class="first">
        <Cover stories={cover} readings={readings} photoIds={photoIds} all={articles} related={coverRelated} />
        <Front secondary={secondary} digest={digest} picks={picks} figures={figures} chart={chart} photoIds={photoIds} />
      </div>
    </>
  ) : (
    <section class="wrap block">
      <h1 class="page-title">أولى الأخبار قيد الإعداد</h1>
      <p class="page-intro">تعمل غرفة الأخبار الآن على أولى المواد. عد بعد قليل.</p>
    </section>
  )}

  {chartsBand.length > 0 && (
    <section class="wrap row charts" aria-labelledby="charts-head">
      <div class="section-head">
        <h2 id="charts-head">بالرسوم البيانية</h2>
      </div>
      <div class="cols" style={`--n:${chartsBand.length}`}>
        {chartsBand.map((a, i) => (
          <div class="charts__cell">
            <Chart chart={a.data.chart!} id={`band-chart-${i}`} compact href={articleHref(a)} />
            <p class="module__from"><span class="module__from-label ui">من مادة</span><a href={articleHref(a)} set:html={isolateNumbers(a.data.title)} /></p>
          </div>
        ))}
      </div>
    </section>
  )}

  {rows.map((r, i) => {
    const [feature, ...briefs] = r.items;
    // Blocks alternate between two shapes so no block repeats its neighbour: a feature beside
    // briefs, then a row of picture cards. A block with fewer than three stories keeps the first.
    const cardsRow = i % 2 === 1 && r.items.length >= 3;
    return (
      <section class="wrap row" data-section={r.section.id} aria-labelledby={`sec-${r.section.id}`}>
        <div class="section-head">
          <h2 id={`sec-${r.section.id}`}><a href={sectionHref(r.section.id)}>{r.section.name}</a></h2>
          <a class="more" href={sectionHref(r.section.id)}>{moreLabel(r.section.id)}</a>
        </div>
        {cardsRow ? (
          <div class="cards" style={`--n:${r.items.length}`}>
            {r.items.map((a) => (
              <StoryCard article={a} variant="card" showSection={false} showExcerpt={!photoIds.has(a.id)} showPhoto={photoIds.has(a.id)} sizes={cardSizes(r.items.length)} />
            ))}
          </div>
        ) : briefs.length === 1 ? (
          <div class="cols row__pair" style="--n:2">
            {r.items.map((a) => (
              <StoryCard article={a} variant="card" showSection={false} showExcerpt showTopic showPhoto={photoIds.has(a.id)} sizes="(min-width: 1320px) 600px, (min-width: 720px) 48vw, 120px" />
            ))}
          </div>
        ) : (
        <div class={`row__body${briefs.length ? "" : " row__body--solo"}`}>
          <div class="row__feature">
            <StoryCard article={feature} variant="card" showSection={false} showExcerpt showTopic showPhoto={photoIds.has(feature.id)} sizes="(min-width: 1320px) 380px, (min-width: 1024px) 30vw, (min-width: 720px) 52vw, 120px" />
          </div>
          {briefs.length > 0 && (
            <div class="row__briefs">
              {briefs.map((a) => (
                <StoryCard article={a} variant="list" showSection={false} showExcerpt={false} showPhoto={photoIds.has(a.id)} />
              ))}
            </div>
          )}
        </div>
        )}
      </section>
    );
  })}

  {lines.length > 0 && (
    <section class="wrap row lines" aria-labelledby="lines-head">
      <div class="section-head">
        <h2 id="lines-head">من الأقسام</h2>
      </div>
      <ul class="lines__list">
        {lines.map(({ section, story }) => (
          <li class="lines__item" data-section={section.id}>
            <a class="lines__section" href={sectionHref(section.id)}>{section.name}</a>
            {story ? (
              <p class="lines__story">
                <a href={articleHref(story)} set:html={isolateNumbers(story.data.title)} />
                <time class="ui" datetime={story.data.publishedAt} data-relative>{timeAgo(story.data.publishedAt)}</time>
              </p>
            ) : (
              <p class="lines__story lines__story--none ui">لا جديد في القسم</p>
            )}
            <a class="lines__more ui" href={sectionHref(section.id)}>{moreLabel(section.id)}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {desks.length > 0 && (
    <section class="wrap row desks" aria-labelledby="desks-head">
      <div class="section-head">
        <h2 id="desks-head"><a href="/tags/">الأخبار بحسب المنطقة</a></h2>
        <a class="more" href="/tags/">كل الملفات والمناطق</a>
      </div>
      <div class="cols" style={`--n:${desks.length}`}>
        {desks.map((d) => (
          <div class="desk">
            <h3 class="desk__name"><a href={`/tags/${encodeURIComponent(d.name)}/`}>{d.name}</a></h3>
            <p class="desk__count ui">
              <bdi>{countLabel(d.count)}</bdi> · آخر تحديث <time datetime={d.latest.data.publishedAt} data-relative>{timeAgo(d.latest.data.publishedAt)}</time>
            </p>
            {d.story && (
              <p class="desk__story">
                <a href={articleHref(d.story)} set:html={isolateNumbers(d.story.data.title)} />
                <time class="ui" datetime={d.story.data.publishedAt} data-relative>{timeAgo(d.story.data.publishedAt)}</time>
              </p>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  {hubs.map((h) => (
    <section class="wrap row hub" data-section={h.id} aria-labelledby={`sec-${h.id}`}>
      <div class="section-head">
        <h2 id={`sec-${h.id}`}><a href={sectionHref(h.id)}>{h.section.name}</a></h2>
        <a class="more" href={sectionHref(h.id)}>{h.more}</a>
      </div>
      <div class="cols" style={`--n:${Math.min(h.items.length, 4)}`}>
        {h.items.map((a) => (
          <StoryCard article={a} variant="text" showSection showExcerpt label={analysisLabel(a, articles)} />
        ))}
      </div>
    </section>
  ))}
</Base>

<style>
  /* Rhythm. The gap between blocks is several times the gap inside one, so the eye reads the
     boundaries: air between, tight within. */
  .row { padding-top: clamp(2.25rem, 4.5vw, 3.75rem); }

  /* The first screen on a phone is one column in reading order, not in the desktop's column order:
     the lead with the day's other top stories, the secondaries, the digest, then the paper's readings,
     the picks and the numbers. Until 2026-09-22 the readings and the market box came before the news,
     and الأخبار في سطور began three screens down. The cover and the columns under it give up their own
     boxes (display: contents) so their parts can be ordered as one list. */
  @media (max-width: 719px) {
    .first { display: flex; flex-direction: column; gap: 1.5rem; width: min(var(--wrap), 100% - 2 * var(--gutter)); margin-inline: auto; padding-top: 1.1rem; }
    .first > :global(.cover), .first > :global(.front), .first :global(.front__mid) { display: contents; }
    .first :global(.cover__stage) { order: 1; padding-bottom: 1.25rem; border-bottom: 3px solid var(--ink); }
    .first :global(.front__secondary) { order: 2; }
    .first :global(.front__top) { order: 3; }
    .first :global(.cover__beside) { order: 4; padding-top: 0; }
    .first :global(.front__picks) { order: 5; margin-top: 0; }
    .first :global(.front__side) { order: 6; margin-top: 0; }
  }

  /* Two stories make a pair of equal features in ruled columns: as a feature and one brief they left the brief
     column three-fifths empty (2026-09-27). */
  .row__pair :global(.card__title) { font-size: var(--t-feature); line-height: 1.36; }
  .row__pair :global(.card__summary) { font-size: var(--n-text); margin-top: 0.35rem; }

  /* One story leads each block, the rest sit beside it as briefs. */
  .row__body { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: 0; align-items: start; }
  .row__body--solo { grid-template-columns: 1fr; }
  .row__feature { padding-inline-end: var(--col-gap); }
  .row__body--solo .row__feature { padding-inline-end: 0; max-width: 56rem; }
  .row__briefs { border-inline-start: 1px solid var(--rule); padding-inline-start: var(--col-gap); display: grid; align-content: start; }
  .row__briefs > :global(.card) { padding-block: 0.7rem; border-top: 1px solid var(--rule); }
  .row__briefs > :global(.card:first-child) { border-top: 0; padding-top: 0; }

  /* The block's own lead sits a clear step above the briefs beside it and runs horizontally like
     the cover story, so six blocks do not become six tall photographs. */
  .row__feature :global(.card__title) { font-size: var(--t-feature); line-height: 1.36; }
  .row__feature :global(.card__summary) { font-size: var(--n-text); margin-top: 0.35rem; }

  /* The charts band: three compact charts in ruled columns, each naming its story. */
  .charts .section-head h2 { color: var(--green); }

  /* من الأقسام: a section with too little fresh news for a block runs as one ruled line: its name in green Amiri,
     its newest story not yet on the page with the story's age, and the way into the section. */
  .lines__list { display: grid; }
  .lines__item { display: grid; grid-template-columns: 9rem minmax(0, 1fr) auto; column-gap: var(--col-gap); align-items: baseline; padding-block: 0.65rem; border-top: 1px solid var(--rule); }
  .lines__item:first-child { border-top: 0; padding-top: 0.2rem; }
  .lines__section { font-family: var(--font-title); font-weight: 700; font-size: var(--t-module); line-height: 1.35; color: var(--green); text-decoration: none; }
  .lines__section:hover { color: var(--green-deep); text-decoration: underline; }
  .lines__story { margin: 0; font-family: var(--font-title); font-weight: 700; font-size: var(--t-list); line-height: 1.45; }
  .lines__story a { text-decoration: none; }
  .lines__story a:hover { color: var(--green); }
  .lines__story time { margin-inline-start: 0.6rem; font-size: var(--fs-xs); font-weight: 500; color: var(--ink-3); white-space: nowrap; }
  .lines__story--none { font-size: var(--fs-sm); font-weight: 500; color: var(--ink-3); }
  .lines__more { font-size: var(--fs-xs); font-weight: 700; color: var(--ink-2); text-decoration: none; white-space: nowrap; }
  .lines__more:hover { color: var(--green); text-decoration: underline; }

  /* The desks: a region's name in green Amiri, its count and last update, and at most one story not printed above. */
  .desk__name { font-family: var(--font-title); font-weight: 700; font-size: var(--t-section); line-height: 1.3; color: var(--green); }
  .desk__name a { text-decoration: none; }
  .desk__name a:hover { color: var(--green-deep); text-decoration: underline; }
  .desk__count { margin-top: 0.15rem; font-size: var(--fs-xs); color: var(--ink-3); }
  .desk__story { margin-top: 0.55rem; padding-top: 0.5rem; border-top: 1px solid var(--rule); font-family: var(--font-title); font-weight: 700; font-size: var(--t-list); line-height: 1.45; }
  .desk__story a { text-decoration: none; }
  .desk__story a:hover { color: var(--green); }
  .desk__story time { display: block; margin-top: 0.1rem; font-size: var(--fs-xs); font-weight: 500; color: var(--ink-3); }

  .hub .cols :global(.card__title) { font-size: var(--t-head); line-height: 1.38; }
  .hub .cols :global(.card__summary) { font-size: var(--n-text); line-height: 1.7; margin-top: 0.4rem; }
  .row__feature :global(.card--photo) { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: var(--col-gap); align-items: start; gap: 0 var(--col-gap); }
  .row__feature :global(.card--photo .card__photo) { order: 2; }
  .row__feature :global(.card--photo .card__body) { order: 1; }

  @media (max-width: 1023px) {
    .row__body { grid-template-columns: 1fr; row-gap: 1.1rem; }
    .row__feature { padding-inline-end: 0; }
    .row__briefs { border-inline-start: 0; padding-inline-start: 0; border-top: 1px solid var(--rule); padding-top: 0.4rem; }
  }
  @media (max-width: 719px) {
    /* On a phone the feature keeps its larger headline but runs as a thumbnail row: a full-width
       photograph for every block made the page ten thousand pixels long. */
    .row__feature :global(.card--photo) { grid-template-columns: 7.5rem minmax(0, 1fr); column-gap: 0.75rem; gap: 0 0.75rem; }
    .row__feature :global(.card--photo .card__photo) { order: 1; }
    .row__feature :global(.card--photo .card__body) { order: 2; }
    .row__feature :global(.card__summary) { display: none; }
    /* One chart of the band on a phone: three full charts in a column took two screens. */
    .charts .charts__cell:nth-child(n + 2) { display: none; }
    /* A line on a phone: the section and the way in on one line, the story under them. */
    .lines__item { grid-template-columns: minmax(0, 1fr) auto; row-gap: 0.2rem; }
    .lines__section { grid-column: 1; grid-row: 1; }
    .lines__more { grid-column: 2; grid-row: 1; }
    .lines__story { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
