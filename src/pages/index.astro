---
import Base from "@layouts/Base.astro";
import Cover from "@components/Cover.astro";
import Front from "@components/Front.astro";
import Ticker from "@components/Ticker.astro";
import Dossiers from "@components/Dossiers.astro";
import StoryCard from "@components/StoryCard.astro";
import Chart from "@components/Chart.astro";
import { DESKS, desksOf } from "@lib/regions";
import { analysisLabel } from "@lib/analysis";
import { getArticles, pickLead, dossiers, chartOfTheDay, hoursOld, repeatedEvents, onTheSameTopic, type Article } from "@lib/articles";
import { newsSections, getSection, sectionHref, moreLabel } from "@lib/sections";
import { articleHref } from "@lib/articles";
import { isolateNumbers } from "@lib/bidi";
import { cardSizes } from "@lib/wikimedia";
import { timeAgo } from "@lib/format";
import site from "@data/site.json";

const articles = await getArticles();
// The lead: the editor's featured story, else the strongest of the last day (lib/articles.ts).
const lead = pickLead(articles);
// One event, one story on the front: when the newsroom has filed an event twice (two oil stories on
// one day's talks, two on one White House announcement, 2026-09-21), the older telling is left to
// its section page. The lead is looked at first, so its telling is the one that stays.
const allNews = articles.filter((a) => a.data.kind === "news");
const repeats = repeatedEvents(lead ? [lead, ...allNews.filter((a) => a.id !== lead.id)] : allNews);
const news = allNews.filter((a) => !repeats.has(a.id));
const importance = (a: Article) => (a.data.quality?.importance ?? 5) + (a.data.image ? 0.5 : 0);
const byImportance = (list: Article[]) => [...list].sort((x, y) => importance(y) - importance(x));

// Every story is placed once with its own module; anything shown again further down runs as text.
const placed = new Set<string>();
const place = (list: Article[]) => list.forEach((a) => placed.add(a.id));
const unplaced = (list: Article[]) => list.filter((a) => !placed.has(a.id));

// The cover: the lead on the stage with the four strongest of the freshest dozen turning behind it;
// all five are placed, so none of them comes back as a secondary or a digest line.
const cover = lead ? [lead, ...byImportance(unplaced(news).filter((a) => a.id !== lead.id).slice(0, 12)).slice(0, 4)] : [];
place(cover);
// The column beside the cover is the paper's own voice: one reading of each kind, so the column
// never shows three items of the same shape under the same label.
// The week's review leads the column in the days after it appears; otherwise the latest analysis does.
const readings = [
  ...articles.filter((a) => a.data.kind === "weekly" || a.data.kind === "analysis").slice(0, 1),
  ...(["explainer", "paper"] as const).flatMap((kind) => articles.filter((a) => a.data.kind === kind).slice(0, 1)),
];
const secondary = byImportance(unplaced(news).slice(0, 8)).slice(0, 2);
place(secondary);
// The digest: the next seven stories, each its headline and one sentence, newest first.
const digest = unplaced(news).slice(0, 7);
place(digest);
// The readings beside the cover are not picked again. Picks are the strongest of the last three days:
// ranked by importance alone they reached back a week, and one said the Saudi pipeline had closed
// beside a lead saying it had reopened.
const picks = byImportance(unplaced(articles).filter((a) => !readings.includes(a) && !repeats.has(a.id) && hoursOld(a) < 72)).slice(0, 4);
place(picks);
// The strip (أيضاً على خازندار) carries the newest stories not already on the first screen, so no
// headline prints twice above the fold; it names each story's section, not its age.
const ticker = unplaced(news).slice(0, 5);
// Under each cover story, up to two headlines on its running topic (ذات صلة), none of them already on
// the first screen; they fill the text column beside the photograph with the story's own context.
const onFirstScreen = new Set([...placed, ...ticker.map((a) => a.id)]);
const coverRelated = new Map(cover.map((s) => [s.id, onTheSameTopic(s, articles.filter((a) => !repeats.has(a.id)), { exclude: onFirstScreen })]));

// Today's figures: one telling number per recent story, never a bare year or a sprawling value.
const figureScore = (value: string) => {
  const v = value.trim();
  if (!/\d/.test(v) || /^(19|20)\d{2}$/.test(v) || v.length > 30) return -1;
  return (/[%٪]/.test(v) ? 2 : 0) + (/(مليار|مليون|ألف|دولار|ريال|يورو|جنيه|دينار|درهم|يوان|طن|برميل)/.test(v) ? 2 : 0) + (v.length <= 18 ? 1 : 0);
};
const figures = articles
  .slice(0, 8)
  .flatMap((a) => {
    const best = [...a.data.keyFacts].map((f) => ({ ...f, article: a, score: figureScore(f.value) })).filter((f) => f.score >= 0 && (f.label ?? "").length <= 48).sort((x, y) => y.score - x.score)[0];
    return best ? [best] : [];
  })
  .slice(0, 3);
const chart = chartOfTheDay(articles);
const files = dossiers(articles.filter((a) => !repeats.has(a.id)));
// The charts band (the Economist's graphic detail): the three freshest charts after the chart of the day.
const chartsBand = articles
  .filter((a) => a.id !== chart?.id && a.data.chart && a.data.chart.title && a.data.chart.categories.length <= 8 && a.data.chart.series.length <= 2)
  .slice(0, 3);
// The desks: the four regions with the freshest news, three headlines each, a story printed in
// one desk only even when it carries two regions (as the files band does).
const deskShown = new Set<string>();
const desks = DESKS.map((d) => ({ ...d, pool: news.filter((a) => desksOf(a).some((x) => x.id === d.id)).slice(0, 8) }))
  .filter((d) => d.pool.length >= 2)
  .sort((x, y) => Date.parse(y.pool[0].data.publishedAt) - Date.parse(x.pool[0].data.publishedAt))
  .slice(0, 4)
  .map((d) => {
    const items = [...d.pool.filter((a) => !deskShown.has(a.id)), ...d.pool.filter((a) => deskShown.has(a.id))].slice(0, 3);
    items.forEach((a) => deskShown.add(a.id));
    return { ...d, items: items.sort((x, y) => Date.parse(y.data.publishedAt) - Date.parse(x.data.publishedAt)) };
  });

// Section blocks: one feature and up to three briefs, the stories not yet on the page first (with
// their pictures), then stories already placed above, as text.
const rows = newsSections
  .map((s) => {
    const inSection = news.filter((a) => a.data.section === s.id);
    const fresh = inSection.filter((a) => !placed.has(a.id)).slice(0, 4);
    const repeats = inSection.filter((a) => placed.has(a.id)).slice(0, Math.max(0, 4 - fresh.length));
    const items = [...fresh.map((a) => ({ a, repeat: false })), ...repeats.map((a) => ({ a, repeat: true }))];
    place(fresh);
    return { section: s, items };
  })
  .filter((r) => r.items.length > 0);

// The hubs: analyses and explainers run as text in ruled columns, which also tells the reader at a
// glance that these are argument and concept pieces, not news reports.
const hubs = [
  { id: "analysis", kind: "analysis", more: "كل التحليلات" },
  { id: "explainers", kind: "explainer", more: "كل المواد" },
]
  .map((h) => ({ ...h, section: getSection(h.id), items: articles.filter((a) => a.data.kind === h.kind || (h.id === "explainers" && a.data.kind === "paper") || (h.id === "analysis" && a.data.kind === "weekly")).slice(0, 4) }))
  .filter((h) => h.items.length > 0);

// A picture is printed once per page even when two stories share it.
const photoIds = new Set<string>();
{
  const seenUrls = new Set<string>();
  const order = [...cover, ...secondary, ...rows.flatMap((r) => r.items.filter((i) => !i.repeat).map((i) => i.a)), ...hubs.flatMap((h) => h.items)];
  for (const a of order) {
    const url = a?.data.image?.url;
    if (!a || !url || seenUrls.has(url)) continue;
    seenUrls.add(url);
    photoIds.add(a.id);
  }
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsMediaOrganization",
  name: site.name,
  alternateName: site.latinName,
  url: site.url,
  description: site.description,
  inLanguage: "ar",
  logo: new URL("/icon-512.png", site.url).toString(),
};
---

<Base jsonLd={jsonLd} section="home">
  <h1 class="visually-hidden">{site.name} — {site.tagline}</h1>
  {cover.length > 0 ? (
    <>
      <Ticker items={ticker} />
      <div class="first">
        <Cover stories={cover} readings={readings} photoIds={photoIds} all={articles} related={coverRelated} />
        <Front secondary={secondary} digest={digest} picks={picks} figures={figures} chart={chart} photoIds={photoIds} />
      </div>
    </>
  ) : (
    <section class="wrap block">
      <h1 class="page-title">أولى الأخبار قيد الإعداد</h1>
      <p class="page-intro">تعمل غرفة الأخبار الآن على أولى المواد. عد بعد قليل.</p>
    </section>
  )}

  <Dossiers files={files} />

  {chartsBand.length > 0 && (
    <section class="wrap row charts" aria-labelledby="charts-head">
      <div class="section-head">
        <h2 id="charts-head">بالرسوم البيانية</h2>
      </div>
      <div class="cols" style={`--n:${chartsBand.length}`}>
        {chartsBand.map((a, i) => (
          <div class="charts__cell">
            <Chart chart={a.data.chart!} id={`band-chart-${i}`} compact href={articleHref(a)} />
            <p class="module__from ui">من مادة: <a href={articleHref(a)} set:html={isolateNumbers(a.data.title)} /></p>
          </div>
        ))}
      </div>
    </section>
  )}

  {rows.map((r, i) => {
    const [feature, ...briefs] = r.items;
    // Blocks alternate between two shapes so no block repeats its neighbour: a feature beside
    // briefs, then a row of picture cards. A block with fewer than three stories keeps the first.
    const cardsRow = i % 2 === 1 && r.items.length >= 3;
    return (
      <section class="wrap row" data-section={r.section.id} aria-labelledby={`sec-${r.section.id}`}>
        <div class="section-head">
          <h2 id={`sec-${r.section.id}`}><a href={sectionHref(r.section.id)}>{r.section.name}</a></h2>
          <a class="more" href={sectionHref(r.section.id)}>{moreLabel(r.section.id)}</a>
        </div>
        {cardsRow ? (
          <div class="cards" style={`--n:${r.items.length}`}>
            {r.items.map(({ a, repeat }) => (
              <StoryCard article={a} variant={repeat ? "text" : "card"} showSection={false} showExcerpt={repeat || !photoIds.has(a.id)} showPhoto={!repeat && photoIds.has(a.id)} sizes={cardSizes(r.items.length)} />
            ))}
          </div>
        ) : (
        <div class={`row__body${briefs.length ? "" : " row__body--solo"}`}>
          <div class="row__feature">
            <StoryCard article={feature.a} variant="card" showSection={false} showExcerpt showTopic showPhoto={!feature.repeat && photoIds.has(feature.a.id)} sizes="(min-width: 1320px) 380px, (min-width: 1024px) 30vw, (min-width: 720px) 52vw, 120px" />
          </div>
          {briefs.length > 0 && (
            <div class="row__briefs">
              {briefs.map(({ a, repeat }) => (
                <StoryCard article={a} variant="list" showSection={false} showExcerpt={false} showPhoto={!repeat && photoIds.has(a.id)} />
              ))}
            </div>
          )}
        </div>
        )}
      </section>
    );
  })}

  {desks.length > 0 && (
    <section class="wrap row desks" aria-labelledby="desks-head">
      <div class="section-head">
        <h2 id="desks-head"><a href="/tags/">الأخبار بحسب المنطقة</a></h2>
        <a class="more" href="/tags/">كل الملفات والمناطق</a>
      </div>
      <div class="cols" style={`--n:${desks.length}`}>
        {desks.map((d) => (
          <div class="desk">
            <h3 class="desk__name"><a href={`/tags/${encodeURIComponent(d.name)}/`}>{d.name}</a></h3>
            <ul class="desk__list">
              {d.items.map((a) => (
                <li>
                  <a href={articleHref(a)} set:html={isolateNumbers(a.data.title)} />
                  <time class="ui" datetime={a.data.publishedAt} data-relative>{timeAgo(a.data.publishedAt)}</time>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}

  {hubs.map((h) => (
    <section class="wrap row hub" data-section={h.id} aria-labelledby={`sec-${h.id}`}>
      <div class="section-head">
        <h2 id={`sec-${h.id}`}><a href={sectionHref(h.id)}>{h.section.name}</a></h2>
        <a class="more" href={sectionHref(h.id)}>{h.more}</a>
      </div>
      <div class="cols" style={`--n:${Math.min(h.items.length, 4)}`}>
        {h.items.map((a) => (
          <StoryCard article={a} variant="text" showSection showExcerpt label={analysisLabel(a, articles)} />
        ))}
      </div>
    </section>
  ))}
</Base>

<style>
  /* Rhythm. The gap between blocks is several times the gap inside one, so the eye reads the
     boundaries: air between, tight within. */
  .row { padding-top: clamp(2.25rem, 4.5vw, 3.75rem); }

  /* The first screen on a phone is one column in reading order, not in the desktop's column order:
     the lead with the day's other top stories, the secondaries, the digest, then the paper's readings,
     the picks and the numbers. Until 2026-09-22 the readings and the market box came before the news,
     and الأخبار في سطور began three screens down. The cover and the columns under it give up their own
     boxes (display: contents) so their parts can be ordered as one list. */
  @media (max-width: 719px) {
    .first { display: flex; flex-direction: column; gap: 1.5rem; width: min(var(--wrap), 100% - 2 * var(--gutter)); margin-inline: auto; padding-top: 1.1rem; }
    .first > :global(.cover), .first > :global(.front), .first :global(.front__mid) { display: contents; }
    .first :global(.cover__stage) { order: 1; padding-bottom: 1.25rem; border-bottom: 3px solid var(--ink); }
    .first :global(.front__secondary) { order: 2; }
    .first :global(.front__top) { order: 3; }
    .first :global(.cover__beside) { order: 4; padding-top: 0; }
    .first :global(.front__picks) { order: 5; margin-top: 0; }
    .first :global(.front__side) { order: 6; margin-top: 0; }
  }

  /* One story leads each block, the rest sit beside it as briefs. */
  .row__body { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: 0; align-items: start; }
  .row__body--solo { grid-template-columns: 1fr; }
  .row__feature { padding-inline-end: var(--col-gap); }
  .row__body--solo .row__feature { padding-inline-end: 0; max-width: 56rem; }
  .row__briefs { border-inline-start: 1px solid var(--rule); padding-inline-start: var(--col-gap); display: grid; align-content: start; }
  .row__briefs > :global(.card) { padding-block: 0.7rem; border-top: 1px solid var(--rule); }
  .row__briefs > :global(.card:first-child) { border-top: 0; padding-top: 0; }

  /* The block's own lead sits a clear step above the briefs beside it and runs horizontally like
     the cover story, so six blocks do not become six tall photographs. */
  .row__feature :global(.card__title) { font-size: clamp(1.22rem, 1rem + 0.7vw, 1.5rem); line-height: 1.36; }
  .row__feature :global(.card__summary) { font-size: 1.02rem; margin-top: 0.35rem; }

  /* The charts band: three compact charts in ruled columns, each naming its story. */
  .charts .section-head h2 { color: var(--green); }
  .charts .module__from { margin-top: 0.5rem; font-size: var(--fs-xs); color: var(--ink-3); line-height: 1.5; }
  .charts .module__from a { color: var(--ink-2); text-decoration: none; font-weight: 700; }
  .charts .module__from a:hover { color: var(--green); text-decoration: underline; }

  /* The desks: a region's name in green Amiri over three dated headlines, as the files band. */
  .desk__name { font-family: var(--font-title); font-weight: 700; font-size: 1.3rem; line-height: 1.3; color: var(--green); }
  .desk__name a { text-decoration: none; }
  .desk__name a:hover { color: var(--green-deep); text-decoration: underline; }
  .desk__list { margin-top: 0.5rem; }
  .desk__list li { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 0.75rem; align-items: baseline; padding-block: 0.5rem; border-top: 1px solid var(--rule); font-family: var(--font-title); font-weight: 700; font-size: 1.02rem; line-height: 1.45; }
  .desk__list a { text-decoration: none; }
  .desk__list a:hover { color: var(--green); }
  .desk__list time { font-size: var(--fs-xs); color: var(--ink-3); white-space: nowrap; }

  .hub .cols :global(.card__title) { font-size: 1.28rem; line-height: 1.38; }
  .hub .cols :global(.card__summary) { font-size: 1.02rem; line-height: 1.7; margin-top: 0.4rem; }
  .row__feature :global(.card--photo) { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: var(--col-gap); align-items: start; gap: 0 var(--col-gap); }
  .row__feature :global(.card--photo .card__photo) { order: 2; }
  .row__feature :global(.card--photo .card__body) { order: 1; }

  @media (max-width: 1023px) {
    .row__body { grid-template-columns: 1fr; row-gap: 1.1rem; }
    .row__feature { padding-inline-end: 0; }
    .row__briefs { border-inline-start: 0; padding-inline-start: 0; border-top: 1px solid var(--rule); padding-top: 0.4rem; }
  }
  @media (max-width: 719px) {
    /* On a phone the feature keeps its larger headline but runs as a thumbnail row: a full-width
       photograph for every block made the page ten thousand pixels long. */
    .row__feature :global(.card--photo) { grid-template-columns: 7.5rem minmax(0, 1fr); column-gap: 0.75rem; gap: 0 0.75rem; }
    .row__feature :global(.card--photo .card__photo) { order: 1; }
    .row__feature :global(.card--photo .card__body) { order: 2; }
    .row__feature :global(.card__title) { font-size: 1.2rem; line-height: 1.4; }
    .row__feature :global(.card__summary) { display: none; }
  }
</style>
