---
import Base from "@layouts/Base.astro";
import Front from "@components/Front.astro";
import StoryCard from "@components/StoryCard.astro";
import { getArticles, pickLead, type Article } from "@lib/articles";
import { newsSections, getSection, sectionHref } from "@lib/sections";
import site from "@data/site.json";

const articles = await getArticles();
const news = articles.filter((a) => a.data.kind === "news");
const explainers = articles.filter((a) => a.data.kind === "explainer");
const importance = (a: Article) => (a.data.quality?.importance ?? 5) + (a.data.image ? 0.5 : 0);

// Every story is placed once with its own module; anything shown again further down runs as text.
const placed = new Set<string>();
const place = (list: Article[]) => list.forEach((a) => placed.add(a.id));

const lead = pickLead(articles);
if (lead) placed.add(lead.id);
const secondary = news
  .filter((a) => !placed.has(a.id))
  .slice(0, 8)
  .sort((x, y) => importance(y) - importance(x))
  .slice(0, 2);
place(secondary);
const top = news.filter((a) => !placed.has(a.id)).slice(0, 5);
place(top);
// Three text briefs finish the centre column, which otherwise held two cards and a tall void while
// the columns either side ran on for hundreds of pixels.
const midBriefs = news.filter((a) => !placed.has(a.id)).slice(0, 3);
place(midBriefs);
// The strip carries what is newest but not already shouting from the top of the page; it used to
// repeat the lead headline a few hundred pixels above the lead itself.
const ticker = news.filter((a) => a.id !== lead?.id && !secondary.some((s) => s.id === a.id)).slice(0, 5);
const picks = articles
  .filter((a) => !placed.has(a.id))
  .sort((x, y) => importance(y) - importance(x))
  .slice(0, 4);
place(picks);
// A lone explainer sits in the front's side column; two or more get their own row below instead.
const asideExplainer = explainers.length === 1 ? explainers[0] : undefined;
if (asideExplainer) placed.add(asideExplainer.id);

// Today's figures: one telling number per recent story, never a bare year or a sprawling value.
const figureScore = (value: string) => {
  const v = value.trim();
  if (!/\d/.test(v) || /^(19|20)\d{2}$/.test(v) || v.length > 30) return -1;
  return (/[%٪]/.test(v) ? 2 : 0) + (/(مليار|مليون|ألف|دولار|ريال|يورو|جنيه|دينار|درهم|يوان|طن|برميل)/.test(v) ? 2 : 0) + (v.length <= 18 ? 1 : 0);
};
const figures = articles
  .slice(0, 8)
  .flatMap((a) => {
    const best = [...a.data.keyFacts].map((f) => ({ ...f, article: a, score: figureScore(f.value) })).filter((f) => f.score >= 0 && (f.label ?? "").length <= 48).sort((x, y) => y.score - x.score)[0];
    return best ? [best] : [];
  })
  .slice(0, 4);

// Section rows: up to four stories, the ones not yet on the page first (with their pictures),
// then stories already placed above, as text. Rows with fewer than three stories run as a list.
const rows = newsSections
  .map((s) => {
    const inSection = news.filter((a) => a.data.section === s.id);
    const fresh = inSection.filter((a) => !placed.has(a.id)).slice(0, 4);
    const repeats = inSection.filter((a) => placed.has(a.id)).slice(0, Math.max(0, 4 - fresh.length));
    const items = [...fresh.map((a) => ({ a, repeat: false })), ...repeats.map((a) => ({ a, repeat: true }))];
    place(fresh);
    return { section: s, items };
  })
  .filter((r) => r.items.length > 0);
const explainerRow = explainers.length > 1 ? explainers.slice(0, 4) : [];
const explainerSection = getSection("explainers");

// A picture is printed once per page even when two stories share it.
const photoIds = new Set<string>();
{
  const seenUrls = new Set<string>();
  const order = [lead, ...secondary, ...midBriefs, ...top, asideExplainer, ...rows.flatMap((r) => r.items.filter((i) => !i.repeat).map((i) => i.a)), ...explainerRow];
  for (const a of order) {
    const url = a?.data.image?.url;
    if (!a || !url || seenUrls.has(url)) continue;
    seenUrls.add(url);
    photoIds.add(a.id);
  }
}
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsMediaOrganization",
  name: site.name,
  alternateName: site.latinName,
  url: site.url,
  description: site.description,
  inLanguage: "ar",
  logo: new URL("/icon-512.png", site.url).toString(),
};
---

<Base jsonLd={jsonLd}>
  {lead ? (
    <Front lead={lead} secondary={secondary} midBriefs={midBriefs} top={top} picks={picks} figures={figures} explainer={asideExplainer} ticker={ticker} photoIds={photoIds} />
  ) : (
    <section class="wrap block">
      <h1 class="page-title">العدد الأول قيد الطباعة</h1>
      <p class="page-intro">تعمل غرفة الأخبار الآن على أولى المواد. عد بعد قليل.</p>
    </section>
  )}

  {rows.map((r) => {
    const [feature, ...briefs] = r.items;
    return (
      <section class="wrap row" data-section={r.section.id} aria-labelledby={`sec-${r.section.id}`}>
        <div class="section-head">
          <h2 id={`sec-${r.section.id}`}><a href={sectionHref(r.section.id)}>{r.section.name}</a></h2>
          <a class="more" href={sectionHref(r.section.id)}>المزيد من {r.section.name}</a>
        </div>
        <div class={`row__body${briefs.length ? "" : " row__body--solo"}`}>
          <div class="row__feature">
            <StoryCard article={feature.a} variant="card" showSection={false} showExcerpt showPhoto={!feature.repeat && photoIds.has(feature.a.id)} />
          </div>
          {briefs.length > 0 && (
            <div class="row__briefs">
              {briefs.map(({ a, repeat }) => (
                <StoryCard article={a} variant="list" showSection={false} showExcerpt={false} showPhoto={!repeat && photoIds.has(a.id)} />
              ))}
            </div>
          )}
        </div>
      </section>
    );
  })}

  {explainerRow.length > 0 && (
    <section class="wrap row" data-section="explainers" aria-labelledby="sec-explainers">
      <div class="section-head">
        <h2 id="sec-explainers"><a href={sectionHref("explainers")}>{explainerSection.name}</a></h2>
        <a class="more" href={sectionHref("explainers")}>كل الشروح</a>
      </div>
      <div class={`row__body${explainerRow.length > 1 ? "" : " row__body--solo"}`}>
        <div class="row__feature">
          <StoryCard article={explainerRow[0]} variant="card" showSection={false} showExcerpt showPhoto={photoIds.has(explainerRow[0].id)} />
        </div>
        {explainerRow.length > 1 && (
          <div class="row__briefs">
            {explainerRow.slice(1).map((a) => (
              <StoryCard article={a} variant="list" showSection={false} showExcerpt={false} showPhoto={photoIds.has(a.id)} />
            ))}
          </div>
        )}
      </div>
    </section>
  )}
</Base>

<style>
  /* Rhythm. Before, the gap between sections (2.25rem) barely exceeded the gap inside one
     (1.25rem), so the page read as a single even field. Air between, tight within. */
  .row { padding-top: clamp(2.25rem, 4.5vw, 3.75rem); }

  /* One story leads each section, the rest sit beside it as briefs. Four equal cards per section
     produced six identical bands down the page with nothing to tell the reader where to look. */
  .row__body { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: 0; align-items: start; }
  .row__body--solo { grid-template-columns: 1fr; }
  .row__feature { padding-inline-end: var(--col-gap); }
  .row__body--solo .row__feature { padding-inline-end: 0; max-width: 56rem; }
  .row__briefs { border-inline-start: 1px solid var(--rule); padding-inline-start: var(--col-gap); display: grid; align-content: start; }
  .row__briefs > :global(.card) { padding-block: 0.7rem; border-top: 1px solid var(--rule); }
  .row__briefs > :global(.card:first-child) { border-top: 0; padding-top: 0; }

  /* The section's own lead sits a clear step above the briefs beside it, and runs horizontally like
     the cover story: stacked, its photograph was 394px tall and six of them made the page 5900px. */
  .row__feature :global(.card__title) { font-size: clamp(1.28rem, 1.05rem + 0.8vw, 1.7rem); line-height: 1.36; }
  .row__feature :global(.card__summary) { font-size: 1.02rem; margin-top: 0.35rem; }
  .row__feature :global(.card--photo) { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: var(--col-gap); align-items: start; gap: 0 var(--col-gap); }
  .row__feature :global(.card--photo .card__photo) { order: 2; }
  .row__feature :global(.card--photo .card__body) { order: 1; }

  @media (max-width: 1023px) {
    .row__body { grid-template-columns: 1fr; row-gap: 1.1rem; }
    .row__feature { padding-inline-end: 0; }
    .row__briefs { border-inline-start: 0; padding-inline-start: 0; border-top: 1px solid var(--rule); padding-top: 0.4rem; }
  }
  @media (max-width: 719px) {
    .row__feature :global(.card--photo) { grid-template-columns: 1fr; }
    .row__feature :global(.card--photo .card__photo) { order: 1; }
    .row__feature :global(.card--photo .card__body) { order: 2; }
  }
</style>
