---
import Base from "@layouts/Base.astro";
import sourcesConfig from "../../pipeline/sources.json";

const official = sourcesConfig.sources.filter((s) => s.kind === "official");
const press = sourcesConfig.sources.filter((s) => s.kind === "news");
const uniq = (list: typeof press) => [...new Map(list.map((s) => [s.nameEn, s])).values()];
---

<Base title="المصادر والمنهجية" description="قائمة المصادر التي يقرؤها خازندار، وقواعد الكتابة والتدقيق التي تحكم كل مقال." path="/methodology/">
  <article class="wrap block method" data-pagefind-ignore>
    <header class="method__head">
      <h1 class="page-title">المصادر والمنهجية</h1>
      <p class="page-intro">ما نقرأ، وكيف نكتب، وما الذي يمنع المقال من النشر.</p>
    </header>

    <div class="prose method__prose">
      <h2>القاعدة الأولى: لا خبر بلا مصدر</h2>
      <p>
        لا يُكتب مقال إلا عن قصة وردت في مصدر واحد على الأقل من المصادر المعلنة أدناه، ويُفضَّل أن تكون واردة في أكثر من مصدر. يُستخدم من كل مصدر عنوانه وملخصه، ونص الصفحة العامة حين تسمح بذلك قواعد الموقع الأصلي (ملف robots.txt) ولا يكون المحتوى خلف اشتراك. المصادر المدفوعة تسهم بالعنوان والملخص فقط.
      </p>
      <h2>القاعدة الثانية: كتابة أصلية منسوبة</h2>
      <p>
        النص العربي أصلي؛ لا يُترجم المصدر جملةً جملة ولا يُنقل حرفياً. تُنسب الوقائع والاقتباسات إلى مصادرها داخل النص، وتُترك الأرقام كما وردت دون تقريب أو استقراء. تُكتب الأسماء الأجنبية بالعربية، وتُستخدم الأرقام الغربية (0-9) وأسماء الشهور المتداولة في الإعلام الاقتصادي العربي.
      </p>
      <h2>القاعدة الثالثة: التدقيق قبل النشر</h2>
      <p>
        يمر كل مقال بفحصين: فحص برمجي يتحقق من أن كل رقم في المقال موجود في المصادر، ومن خلوّ النص من الروابط والكلمات الأجنبية غير المترجمة ومن النقل الحرفي عن المصادر العربية؛ ثم مراجعة بنموذج لغوي مستقل عن النموذج الكاتب، يقارن كل ادعاء بالمصادر ويعطي المقال درجة، ويرفضه أو يعيده للتصحيح إذا وجد خطأً. لا يُنشر مقال رُفض، ويُسجَّل سبب الرفض في تقرير الدورة.
      </p>
      <h2>الصور</h2>
      <p>
        الصور الفوتوغرافية تُختار من ويكيميديا كومنز بشرط أن تكون برخصة مفتوحة (المشاع الإبداعي أو الملك العام)، ويختارها نموذج رؤية يتحقق من صلتها بالموضوع وخلوّها من النصوص والعلامات المائية، وتُعرض مع اسم المصوّر والرخصة ورابط الصفحة الأصلية. حين لا توجد صورة مناسبة يُرسم للمقال غلاف أصلي مجرّد بلون قسمه.
      </p>
      <h2>ما لا نفعله</h2>
      <p>
        لا نتجاوز الجدران المدفوعة ولا أنظمة الحماية، ولا نجمع بيانات القرّاء، ولا نعرض إعلانات أو بيانات أسواق حيّة، ولا ننشر آراء أو توصيات استثمارية.
      </p>

      <h2>المصادر الرسمية</h2>
      <ul>
        {official.map((s) => (
          <li><bdi>{s.name}</bdi> <span class="method__en"><bdi dir="ltr">{s.nameEn}</bdi></span></li>
        ))}
      </ul>
      <h2>الصحافة الاقتصادية</h2>
      <ul>
        {uniq(press).map((s) => (
          <li><bdi>{s.name}</bdi> <span class="method__en"><bdi dir="ltr">{s.nameEn}</bdi></span>{s.paywalled ? " (عنوان وملخص فقط)" : ""}</li>
        ))}
      </ul>
      <p>تُراجع القائمة دورياً؛ ويُستبعد أي مصدر يرفض الوصول الآلي أو يتبيّن ضعف موثوقيته.</p>
    </div>
  </article>
</Base>

<style>
  .method__head { border-top: 3px solid var(--saffron); padding-top: 0.9rem; }
  .method__head .page-title { color: var(--ink); }
  .method__prose { margin-top: clamp(1.5rem, 3vw, 2.5rem); }
  .method__en { font-family: var(--font-ui); color: var(--ink-3); font-size: 0.9em; }
</style>
