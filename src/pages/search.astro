---
import Base from "@layouts/Base.astro";
import { RUN_PATTERN } from "@lib/bidi";
import { getArticles } from "@lib/articles";
import { TOPICS, topicArticles, topicHref } from "@lib/topics";
import { NAME_FIXES } from "../../pipeline/lib/spellings.mjs";
// The site's own pattern for figures and Latin runs, handed to the page's plain script (src/lib/bidi.ts).
const runSource = RUN_PATTERN.source;
// The house spelling table (pipeline/lib/spellings.mjs, the copy desk's own), handed to the script, which respells a
// query before searching it (2026-11-20): «ترمب», as Asharq Al-Awsat writes it, found 11 stories where «ترامب» finds 135,
// and «غوغل» 5 where «جوجل» finds 10.
const spellings = (NAME_FIXES as [RegExp, string][]).map(([re, to]) => [re.source, re.flags, to]);
// A way in when there is nothing to show yet or nothing was found: the standing subjects we write about most (the
// critique of 2026-11-09: an empty search offered nothing to try next).
const articles = await getArticles();
const browse = Object.entries(TOPICS)
  .flatMap(([section, list]) => list.map((t) => ({ name: t.name, href: topicHref(section, t.id), count: topicArticles(articles, section, t).length })))
  .filter((x) => x.count >= 3)
  .sort((a, b) => b.count - a.count)
  .slice(0, 10);
---

<Base title="بحث" description="ابحث في أرشيف خازندار" path="/search/" noindex>
  <section class="wrap block search" data-pagefind-ignore>
    <header class="page-head">
      <h1 class="page-title">بحث</h1>
      <p class="page-intro">ابحث في كل ما نشره خازندار: العناوين والنصوص والوسوم.</p>
    </header>
    <form class="search__form" role="search" action="/search/" method="get">
      <label class="visually-hidden" for="q">عبارة البحث</label>
      <div class="search__field">
        <input id="q" class="search__input" type="search" name="q" placeholder="مثال: التضخم في منطقة اليورو" autocomplete="off" autofocus />
        {/* The house's own clear control, a word in the furniture face: the browser's was a blue × (2026-10-19). */}
        <button type="button" class="search__clear" hidden>مسح</button>
      </div>
      {/* Results come as the reader types; the button is there for a reader who looks for one (2026-11-10). */}
      <button type="submit" class="search__go">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.6-3.6" /></svg>
        <span>ابحث</span>
      </button>
    </form>
    <div class="search__results">
      <div class="search__bar">
        <p class="search__status ui" role="status"></p>
        {/* A news search lists the newest first (2026-10-19: «النفط» listed 7 September to 1 October by relevance alone,
            and none of the day's oil stories); relevance stays one tap away. */}
        <p class="search__sort ui" role="group" aria-label="ترتيب النتائج" hidden>
          <span class="search__sort-label">الترتيب:</span>
          <button type="button" data-order="date" aria-pressed="true">الأحدث</button>
          <span class="search__sort-sep" aria-hidden="true">·</span>
          <button type="button" data-order="relevance" aria-pressed="false">الأكثر صلة</button>
        </p>
      </div>
      {/* The page the query names: its subject's, file's, region's or section's own page, where its stories are kept. */}
      <p class="search__page ui" hidden><span class="search__page-label"></span> <a href="/"></a></p>
      <ol class="search__list"></ol>
      {/* Twenty at a time, and the rest a tap away: «110 نتائج، تُعرض أول 20» had no way to the other ninety. */}
      <button type="button" class="search__more" hidden>المزيد من النتائج</button>
    </div>
    {browse.length > 0 && (
      <nav class="search__browse" aria-labelledby="browse-head">
        <h2 id="browse-head" class="module__head">أو تصفّح المواضيع</h2>
        <ul class="search__browse-list">
          {/* The ten subjects we write about most, by name: their counts were the archive's bookkeeping (2026-11-20). */}
          {browse.map((x) => <li><a href={x.href}>{x.name}</a></li>)}
        </ul>
      </nav>
    )}
  </section>
</Base>

<script is:inline define:vars={{ runSource, spellings }}>
  // Plain script on purpose: the Pagefind bundle is generated after the build and must not be touched by the bundler.
  (function () {
    var PAGE = 20;
    // Newest first, a story that names the search fewer than three times comes after the rest, under its own label:
    // by date alone «الذهب» opened on a French bond story that mentions gold once, and «النفط» on an IPO explainer.
    // Measured on 2026-10-19 (Pagefind's own count of matched words, `result.words`): passing mentions 0-2, stories
    // on the subject 4-51, among them the day's WTI story (5), whose headline does not say «النفط».
    var PASSING = 3;
    var input = document.getElementById("q");
    var form = input && input.form;
    var clear = document.querySelector(".search__clear");
    var status = document.querySelector(".search__status");
    var sort = document.querySelector(".search__sort");
    var list = document.querySelector(".search__list");
    var more = document.querySelector(".search__more");
    var browse = document.querySelector(".search__browse");
    var pageLine = document.querySelector(".search__page");
    // The subjects show while there is nothing to list: before a search, and when one finds nothing.
    function offer(show) {
      if (browse) browse.hidden = !show;
    }
    // respell:start
    // The query in the house spelling (pipeline/lib/spellings.mjs, handed in as `spellings`), so «ترمب» finds the stories
    // written «ترامب». A browser without the rules' lookbehind searches what was typed.
    var SPELL = [];
    try {
      if (typeof spellings !== "undefined" && spellings) SPELL = spellings.map(function (s) { return [new RegExp(s[0], s[1]), s[2]]; });
    } catch (error) { SPELL = []; }
    function respell(q) {
      return SPELL.reduce(function (out, s) { return out.replace(s[0], s[1]); }, q);
    }
    // The pages a query can name (/search-pages.json, built with the site), read on the first search, and matched with
    // the names as tag-map.mjs's normalizeArabic() reads them, with and without «ال».
    var PAGES = null;
    function pagesList() {
      if (PAGES) return Promise.resolve(PAGES);
      return fetch("/search-pages.json")
        .then(function (r) { return r.json(); })
        .then(function (list) { PAGES = new Map(list.map(function (p) { return [p[0], p]; })); return PAGES; })
        // A list that did not arrive is asked for again at the next search: kept as an empty one, a single failure left
        // «مصر» without its region's line until the page was loaded again (2026-11-23).
        .catch(function () { return new Map(); });
    }
    var KIND = { m: "صفحة الموضوع:", q: "صفحة القسم:", r: "صفحة المنطقة:", f: "صفحة الملف:" };
    function pageKey(s) {
      return String(s == null ? "" : s).replace(/[ً-ْٰـ]/g, "").replace(/[أإآ]/g, "ا").replace(/ة/g, "ه").replace(/ى/g, "ي").replace(/\s+/g, " ").trim().toLowerCase();
    }
    function namedPage(map, q) {
      var k = pageKey(q);
      if (!k) return null;
      return map.get(k) || map.get("ال" + k) || (k.indexOf("ال") === 0 ? map.get(k.slice(2)) : null) || null;
    }
    // The line waits for the list, and is drawn only if the query is still the one it was read for.
    function showPage(q, id) {
      if (!pageLine) return;
      if (!q) { pageLine.hidden = true; return; }
      pagesList().then(function (map) {
        if (id !== current) return;
        var p = namedPage(map, q);
        pageLine.hidden = !p;
        if (!p) return;
        pageLine.querySelector(".search__page-label").textContent = KIND[p[1]] || "";
        var a = pageLine.querySelector("a");
        a.textContent = p[2];
        a.setAttribute("href", p[3] || "/tags/" + encodeURIComponent(p[2]) + "/");
      });
    }
    // One whole word is searched as a whole word: Pagefind cuts the last word to its stem and matches it as the start of
    // longer words, so «أبل» listed «أبلغت» and «الإبلاغ» first, «تسلا» «تسلل» and «التسليمات», «مصر» «مصرف» (55, 103 and
    // 204 results against 9, 13 and 124 whole-word ones, 2026-11-20). A word still being typed has no whole-word match and
    // keeps the loose one; several words stay loose, since quoted they are one exact phrase («التضخم في مصر»: 51 to 4).
    // The whole-word search only decides which stories stay: its count of matches is one a page (277 of «النفط»'s 288),
    // which would have sent nearly every story under «ذكر عابر», so the loose search's counts and order are kept.
    function find(pf, q, options) {
      if (/\s|"/.test(q)) return pf.search(q, options);
      return Promise.all([pf.search(q, options), pf.search('"' + q + '"', options)]).then(function (both) {
        var loose = both[0];
        var exact = both[1];
        if (!exact || !exact.results || !exact.results.length) return loose;
        var whole = new Set(exact.results.map(function (r) { return r.id; }));
        return { results: loose.results.filter(function (r) { return whole.has(r.id); }) };
      });
    }
    // respell:end
    var pagefind = null;
    var timer;
    // Every search gets a number, and an answer that arrives after a newer search has started is dropped.
    var current = 0;
    // The results of the search on screen, in the order they are listed: { r: Pagefind's result, d: its data once read }.
    var entries = [];
    var shown = 0;
    var params = new URLSearchParams(location.search);
    // The order the reader chose (a tap, or the address's `order`), else the query's own: one word newest first, several
    // words most relevant first (2026-11-20). Newest first, «التضخم في مصر» (the kind of search the box's own example asks)
    // opened on gold, Waller and the euro area, stories that only carry both words; by relevance, on Egypt's three
    // inflation stories, and «ميزانية السعودية» on the Saudi budget deficit. One word keeps the order of 19 October.
    var chosen = params.get("order") === "relevance" || params.get("order") === "date" ? params.get("order") : "";
    var order = "date";
    function orderFor(q) {
      return chosen || (words(q).length > 1 ? "relevance" : "date");
    }
    function pressed() {
      sort.querySelectorAll("button").forEach(function (x) { x.setAttribute("aria-pressed", String(x.dataset.order === order)); });
    }
    function escape(text) {
      return String(text == null ? "" : text).replace(/[&<>"]/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c];
      });
    }
    // isolate:start
    // A result's headline and standfirst keep their figures and Latin names as every other page prints them
    // (isolateNumbers() in src/lib/bidi.ts, its pattern handed in as `runSource`): escaped bare, «البالغ 5-7%» drew
    // «%7-5», a range «3.5%-3.75%» «%3.75-%3.5» and «737-10» «10-737» (2026-11-09). A browser without the pattern's
    // lookbehind keeps the plain text.
    var RUN = null;
    try {
      if (typeof runSource === "string" && runSource) RUN = new RegExp(runSource, "gu");
    } catch (error) {}
    function latinParts(run) {
      var head = "";
      var core = run;
      var tail = "";
      function count(s, c) { return s.split(c).length - 1; }
      for (;;) {
        if (core.length > 1 && core.slice(-1) === ".") { tail = "." + tail; core = core.slice(0, -1); }
        else if (core.slice(-1) === ")" && count(core, ")") > count(core, "(")) { tail = ")" + tail; core = core.slice(0, -1); }
        else if (core.charAt(0) === "(" && count(core, "(") > count(core, ")")) { head = head + "("; core = core.slice(1); }
        else return [head, core, tail];
      }
    }
    function isolate(text) {
      if (!RUN) return escape(text);
      return String(text == null ? "" : text).split(RUN).map(function (piece, i) {
        if (piece === undefined || piece === "") return "";
        if (i % 3 === 0) return escape(piece);
        if (i % 3 === 2) return '<bdi dir="ltr">' + escape(piece).replace(/^-/, "−") + "</bdi>";
        var parts = latinParts(piece);
        var core = escape(parts[1]);
        var cls = core.trim().split(/\s+/).length <= 3 ? ' class="latin latin--short"' : ' class="latin"';
        var held = core.replace(/[^\s]*[\p{L}\p{N}]-[\p{L}\p{N}][^\s]*/gu, function (word) { return '<span class="nb">' + word + "</span>"; });
        return escape(parts[0]) + '<bdi dir="ltr"' + cls + ">" + held + "</bdi>" + escape(parts[2]);
      }).join("");
    }
    // isolate:end
    function load() {
      if (pagefind) return Promise.resolve(pagefind);
      return import("/pagefind/pagefind.js")
        .then(function (pf) {
          return pf.init().then(function () { pagefind = pf; return pf; });
        })
        .catch(function () {
          say("تعذّر تحميل البحث. تحقّق من اتصالك بالإنترنت ثم أعد تحميل الصفحة.");
          return null;
        });
    }
    function say(html) {
      status.innerHTML = html;
    }
    // The count agrees with its number, as Arabic counts do: نتيجة واحدة، نتيجتان، 3 نتائج، 11 نتيجة.
    function counted(n) {
      if (n === 1) return "نتيجة واحدة";
      if (n === 2) return "نتيجتان";
      var mod = n % 100;
      return "<bdi>" + n + "</bdi> " + (mod >= 3 && mod <= 10 ? "نتائج" : "نتيجة");
    }
    // By relevance, a story whose headline carries every word of the search comes first, in the index's own order after
    // that (2026-09-24: «التضخم في مصر» listed a US inflation story above «التضخم في مصر يتباطأ إلى 12.7%»). Words are
    // compared without marks, tatweel or the variant alef, yaa and taa marbuta, and the small words are left out.
    function norm(text) {
      return String(text == null ? "" : text)
        .replace(/[ً-ٰٟـ]/g, "")
        .replace(/[أإآ]/g, "ا")
        .replace(/ى/g, "ي")
        .replace(/ة/g, "ه")
        .toLowerCase();
    }
    var SMALL = ["في", "من", "على", "إلى", "عن", "مع", "و", "أو", "ما", "هل", "بين", "بعد", "قبل"].map(norm);
    function words(q) {
      return norm(q).split(/[^\p{L}\p{N}.%]+/u).filter(function (w) { return w && SMALL.indexOf(w) === -1; });
    }
    function headlinesFirst(items, q) {
      var ws = words(q);
      if (!ws.length) return items;
      return items
        .map(function (e, i) {
          var title = norm((e.d.meta || {}).title);
          return { e: e, i: i, all: ws.every(function (w) { return title.indexOf(w) !== -1; }) ? 1 : 0 };
        })
        .sort(function (a, b) { return b.all - a.all || a.i - b.i; })
        .map(function (s) { return s.e; });
    }
    function read(slice) {
      return Promise.all(slice.map(function (e) {
        return e.d ? e.d : e.r.data().then(function (d) { e.d = d; return d; });
      }));
    }
    function item(d) {
      var meta = d.meta || {};
      // The story's photograph as a thumbnail, as /latest/ lists them (the small copy the article names for the index).
      // Its own field, never Pagefind's `image`, which Pagefind fills with the page's first picture when the page names
      // none: 88 of the 96 stories without a photograph showed another story's (Binance's four hack stories, Nvidia's
      // chief executive) and the other 8 the site's logo (2026-11-10).
      var thumb = /^(https:\/\/|\/)/.test(meta.thumb || "") ? meta.thumb : "";
      return (
        '<li class="search__item' + (thumb ? " search__item--photo" : "") + '" data-section="' + escape(meta.section) + '">' +
        (thumb ? '<img class="search__thumb" src="' + escape(thumb) + '" alt="" width="88" height="88" loading="lazy" decoding="async" referrerpolicy="no-referrer" />' : "") +
        '<div class="search__body">' +
        '<a class="search__title" href="' + escape(d.url) + '">' + isolate(meta.title) + "</a>" +
        (meta.summary ? '<p class="search__excerpt">' + isolate(meta.summary) + "</p>" : "") +
        '<p class="meta">' + (meta.sectionName ? '<a href="/' + escape(meta.section) + '/">' + escape(meta.sectionName) + "</a>" : "") + (meta.date ? "<time>" + escape(meta.date) + "</time>" : "") + "</p>" +
        "</div></li>"
      );
    }
    // The query as searched, when the house spelling changed it («ترمب» → «ترامب»): the count says what it counts.
    var respelled = "";
    function about() {
      return respelled ? " عن «" + escape(respelled) + "»" : "";
    }
    function tally() {
      say(counted(entries.length) + about() + (shown < entries.length ? "، تُعرض <bdi>" + shown + "</bdi>" : ""));
      more.hidden = shown >= entries.length;
    }
    // The next twenty, read and listed; after a tap on «المزيد» focus moves to the first of them. They are listed only
    // while the list is still the one they were taken from: a tap while a new search loads read the old search's next
    // twenty and put them under the new one's count (a review of 2026-11-01: 22 results listed under «نتيجتان»).
    function page(id, focus) {
      var start = shown;
      var from = entries;
      var slice = entries.slice(start, start + PAGE);
      return read(slice).then(function () {
        if (id !== current || from !== entries) return;
        var before = list.children.length;
        list.insertAdjacentHTML("beforeend", slice.map(function (e, i) {
          var at = start + i;
          var label = e.passing && at > 0 && !entries[at - 1].passing ? '<li class="search__group ui">مواد ورد فيها ذكرٌ عابر</li>' : "";
          return label + item(e.d);
        }).join(""));
        shown += slice.length;
        tally();
        var first = [].slice.call(list.children, before).filter(function (li) { return li.classList.contains("search__item"); })[0];
        if (focus && first) first.querySelector("a").focus();
      });
    }
    function reset() {
      entries = [];
      shown = 0;
      list.innerHTML = "";
      more.hidden = true;
      sort.hidden = true;
    }
    function address(q) {
      // The search and its order live in the address, so a search can be shared or bookmarked.
      if (!history.replaceState) return;
      var query = q ? "?q=" + encodeURIComponent(q) + (chosen ? "&order=" + chosen : "") : "";
      history.replaceState(null, "", location.pathname + query);
    }
    function run() {
      var asked = input.value.trim();
      var q = respell(asked);
      var id = ++current;
      clear.hidden = !input.value;
      order = orderFor(q);
      pressed();
      address(asked);
      showPage(q, id);
      if (!q) {
        reset();
        say("");
        offer(true);
        return;
      }
      load().then(function (pf) {
        if (!pf || id !== current) return;
        return find(pf, q, order === "date" ? { sort: { date: "desc" } } : {}).then(function (search) {
          if (id !== current) return;
          reset();
          respelled = q !== asked ? q : "";
          if (!search.results.length) {
            say("لا نتائج" + about() + ". جرّب كلمة أخرى أو اسم مؤسسة.");
            offer(true);
            return;
          }
          offer(false);
          entries = search.results.map(function (r) { return { r: r, passing: order === "date" && r.words.length < PASSING }; });
          sort.hidden = entries.length < 2;
          if (order === "date") {
            entries = entries.filter(function (e) { return !e.passing; }).concat(entries.filter(function (e) { return e.passing; }));
            return page(id, false);
          }
          // Forty read before the first twenty are listed, so a headline match further down still reaches the top.
          var head = entries.slice(0, 40);
          return read(head).then(function () {
            if (id !== current) return;
            entries = headlinesFirst(head, q).concat(entries.slice(40));
            return page(id, false);
          });
        });
      }).catch(function () {
        // The results did not arrive: say so, over an empty list. The search before's count had stayed above no rows at
        // all (2026-11-23).
        if (id !== current) return;
        reset();
        say("تعذّر تحميل النتائج. تحقق من الاتصال وحاول مرة أخرى.");
      });
    }
    sort.querySelectorAll("button").forEach(function (b) {
      b.addEventListener("click", function () {
        if (b.dataset.order === order) return;
        chosen = b.dataset.order;
        run();
      });
    });
    var busy = false;
    more.addEventListener("click", function () {
      if (busy) return;
      busy = true;
      page(current, true).then(function () { busy = false; }, function () { busy = false; });
    });
    clear.addEventListener("click", function () {
      input.value = "";
      run();
      input.focus();
    });
    input.addEventListener("input", function () {
      clear.hidden = !input.value;
      clearTimeout(timer);
      timer = setTimeout(run, 180);
    });
    if (form) form.addEventListener("submit", function (e) { e.preventDefault(); clearTimeout(timer); run(); });
    pressed();
    var initial = params.get("q");
    if (initial) {
      input.value = initial;
      run();
    }
  })();
</script>

<style>
  .search__form { display: flex; align-items: stretch; max-width: 40rem; }
  .search__field { position: relative; flex: 1 1 auto; min-width: 0; }
  .search__input {
    width: 100%;
    font-family: var(--font-body);
    font-size: var(--n-search);
    padding: 0.6rem 0.2rem;
    padding-inline-end: 3.5rem;
    border: 0;
    border-bottom: 2px solid var(--ink);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
  }
  .search__input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; display: none; }
  /* Focus thickens the rule as well as turning it green, so it shows without relying on colour alone. */
  .search__input:focus { outline: none; border-bottom: 3px solid var(--green); padding-bottom: calc(0.6rem - 1px); }
  .search__clear {
    position: absolute;
    inset-inline-end: 0;
    inset-block: 0;
    display: flex;
    align-items: center;
    padding-inline: 0.6rem 0.2rem;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--ink-3);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .search__clear:hover { color: var(--green); }
  .search__clear[hidden] { display: none; }
  /* The button continues the input's rule, and turns green with it while the field has focus. */
  .search__go { flex: none; display: inline-flex; align-items: center; gap: 0.35rem; min-height: var(--tap); padding-inline: 0.8rem 0.3rem; font-family: var(--font-ui); font-weight: 700; font-size: var(--fs-sm); color: var(--ink); background: none; border: 0; border-bottom: 2px solid var(--ink); cursor: pointer; }
  .search__go:hover { color: var(--green); }
  .search__form:focus-within .search__go { border-bottom: 3px solid var(--green); }
  .search__browse { margin-top: 2.5rem; max-width: 46rem; }
  .search__browse[hidden] { display: none; }
  .search__browse-list { display: flex; flex-wrap: wrap; gap: 0.35rem 1.4rem; }
  .search__browse-list li { display: inline-flex; align-items: baseline; gap: 0.35rem; }
  .search__browse-list a { font-family: var(--font-body); font-weight: 700; font-size: var(--n-text); color: var(--ink-2); text-decoration: none; }
  .search__browse-list a:hover { color: var(--green); text-decoration: underline; }
