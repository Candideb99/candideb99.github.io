---
import Base from "@layouts/Base.astro";
---

<Base title="بحث" description="ابحث في أرشيف خازندار" path="/search/" noindex>
  <section class="wrap block search" data-pagefind-ignore>
    <header class="page-head">
      <h1 class="page-title">بحث</h1>
      <p class="page-intro">ابحث في كل ما نشره خازندار: العناوين والنصوص والوسوم.</p>
    </header>
    <form class="search__form" role="search" action="/search/" method="get">
      <label class="visually-hidden" for="q">عبارة البحث</label>
      <input id="q" class="search__input" type="search" name="q" placeholder="مثال: التضخم في منطقة اليورو" autocomplete="off" autofocus />
    </form>
    <div id="results" class="search__results" aria-live="polite"></div>
  </section>
</Base>

<script is:inline>
  // Plain script on purpose: the Pagefind bundle is generated after the build and must not be touched by the bundler.
  (function () {
    var input = document.getElementById("q");
    var form = input && input.form;
    var results = document.getElementById("results");
    var pagefind = null;
    var timer;
    function escape(text) {
      return String(text == null ? "" : text).replace(/[&<>"]/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c];
      });
    }
    function load() {
      if (pagefind) return Promise.resolve(pagefind);
      return import("/pagefind/pagefind.js")
        .then(function (pf) {
          return pf.options({ excerptLength: 30 }).then(function () { return pf.init(); }).then(function () { pagefind = pf; return pf; });
        })
        .catch(function () {
          results.innerHTML = '<p class="search__hint">تعذّر تحميل فهرس البحث. أعد تحميل الصفحة.</p>';
          return null;
        });
    }
    function render(search, items) {
      results.innerHTML =
        '<p class="search__count ui"><bdi>' + search.results.length + '</bdi> نتيجة</p><ol class="search__list">' +
        items
          .map(function (d) {
            var meta = d.meta || {};
            return (
              '<li class="search__item" data-section="' + escape(meta.section) + '">' +
              '<a class="search__title" href="' + escape(d.url) + '">' + escape(meta.title) + "</a>" +
              '<p class="search__excerpt">' + d.excerpt + "</p>" +
              '<p class="meta">' + (meta.sectionName ? '<a href="/' + escape(meta.section) + '/">' + escape(meta.sectionName) + "</a>" : "") + (meta.date ? "<time>" + escape(meta.date) + "</time>" : "") + "</p>" +
              "</li>"
            );
          })
          .join("") +
        "</ol>";
    }
    function run() {
      var q = input.value.trim();
      // The query lives in the address so a search can be shared or bookmarked.
      if (history.replaceState) history.replaceState(null, "", q ? "?q=" + encodeURIComponent(q) : location.pathname);
      if (!q) {
        results.innerHTML = "";
        return;
      }
      load().then(function (pf) {
        if (!pf) return;
        return pf.search(q).then(function (search) {
          if (!search.results.length) {
            results.innerHTML = '<p class="search__hint">لا نتائج. جرّب كلمة أخرى أو اسم مؤسسة.</p>';
            return;
          }
          return Promise.all(search.results.slice(0, 20).map(function (r) { return r.data(); })).then(function (items) {
            render(search, items);
          });
        });
      });
    }
    input.addEventListener("input", function () {
      clearTimeout(timer);
      timer = setTimeout(run, 180);
    });
    if (form) form.addEventListener("submit", function (e) { e.preventDefault(); clearTimeout(timer); run(); });
    var initial = new URLSearchParams(location.search).get("q");
    if (initial) {
      input.value = initial;
      run();
    }
  })();
</script>

<style>
  .search__form { max-width: 40rem; }
  .search__input {
    width: 100%;
    font-family: var(--font-body);
    font-size: 1.3rem;
    padding: 0.6rem 0.2rem;
    border: 0;
    border-bottom: 2px solid var(--ink);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
  }
  .search__input:focus { outline: none; border-bottom-color: var(--green); }
  .search__results { margin-top: 1.5rem; max-width: 46rem; }
  .search :global(.search__hint), .search :global(.search__count) { font-family: var(--font-ui); color: var(--ink-3); }
  .search :global(.search__list) { display: grid; gap: 1rem; margin-top: 0.75rem; }
  .search :global(.search__item) { border-top: 1px solid var(--rule); padding-top: 0.9rem; }
  .search :global(.search__title) { font-family: var(--font-title); font-weight: 700; font-size: 1.2rem; line-height: 1.4; text-decoration: none; }
  .search :global(.search__title:hover) { color: var(--green); }
  .search :global(.search__excerpt) { font-size: 1rem; line-height: 1.7; color: var(--ink-2); margin-top: 0.3rem; }
  .search :global(.search__excerpt mark) { background: none; color: var(--green); font-weight: 700; }
</style>
