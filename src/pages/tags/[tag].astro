---
import Base from "@layouts/Base.astro";
import StoryCard from "@components/StoryCard.astro";
import { getArticles, allTags } from "@lib/articles";

export async function getStaticPaths() {
  const articles = await getArticles();
  return [...allTags(articles).entries()].map(([tag, items]) => ({ params: { tag }, props: { tag, items } }));
}

const { tag, items } = Astro.props;
const n = items.length;
const countWord = n === 1 ? "مادة" : n === 2 ? "مادتان" : n <= 10 ? "مواد" : "مادة";
---

<Base title={`وسم: ${tag}`} description={`كل مواد خازندار الموسومة بـ ${tag}`} path={`/tags/${encodeURIComponent(tag)}/`}>
  <section class="wrap block">
    <header class="page-head">
      <h1 class="page-title">{tag}</h1>
      <p class="page-intro"><bdi>{n}</bdi> {countWord} في خازندار</p>
    </header>
    <div class="cols" style={`--n:${Math.max(2, Math.min(n, 3))}`}>
      {items.map((a, i) => (
        <StoryCard article={a} variant="card" eager={i < 3} />
      ))}
    </div>
  </section>
</Base>
