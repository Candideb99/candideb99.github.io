---
/**
 * The files index: the running stories, companies, institutions and people the newsroom is following now, the largest
 * of the other files, and the regions.
 *
 * Since 2026-09-27 (one page per subject) the files are the running stories, companies, institutions and people; a
 * standing subject («التضخم», «النفط») lives on its section's sub-topic page.
 *
 * No counts since 2026-11-21 (the owner, of a region page's «266 مادة»: "i do not think we really should mention how many
 * articles are there, no?"): a cell keeps «آخر تحديث», since its story is not always the file's newest.
 *
 * A bounded index since 2026-11-21 (the owner: "is this part redundant? is it useful? what would happen after one year
 * of running the website if this part still exists?"; lib/files-index.mjs has the measurements). It had named every
 * file, the nine largest as cells and 235 more «أبجدياً», growing with every story, and cut at 400 without a word; its
 * cells were ranked by size. Now the cells are the files most written about in the last two weeks, the list after them
 * the other files running in that window, then the largest of the rest. The standing subjects' row went: it repeated
 * the section menus and the sections' «المواضيع» rows.
 */
import Base from "@layouts/Base.astro";
import { getArticles, dossiers, articleHref } from "@lib/articles";
import { DESKS, desksOf } from "@lib/regions";
import { canonicalTag } from "@lib/tag-map.mjs";
import { FILE_MIN } from "@lib/files";
import { filesIndex } from "@lib/files-index.mjs";
import { formatShortDate, timeAgo } from "@lib/format";
import { headline } from "@lib/bidi";

const articles = await getArticles();
// Every file with a page (the regions and places aside: a file follows a story, never a country).
const files = dossiers(articles, { min: FILE_MIN, max: Infinity });
const byTag = new Map(files.map((f) => [f.tag, f]));
// "Now" is the newest story, so a pause in the newsroom leaves the index on what it was last following.
const now = Math.max(...articles.map((a) => Date.parse(a.data.publishedAt)));
const index = filesIndex(files.map((f) => ({ tag: f.tag, times: f.items.map((a) => Date.parse(a.data.publishedAt)) })), now);
// Each cell prints its file's newest story that no cell before it has printed: neighbouring files often share one.
const printed = new Set<string>();
const leading = index.lead.map(({ tag }) => {
  const file = byTag.get(tag)!;
  const story = file.items.find((a) => !printed.has(a.id));
  if (story) printed.add(story.id);
  return { ...file, story };
});
const named = (list: { tag: string }[]) => list.map(({ tag }) => byTag.get(tag)!);
const running = named(index.running);
const largest = named(index.largest);
// The four desks readers see (src/lib/regions.ts), in their order: three Arab desks, then the world; a desk is listed
// when its page holds a story ([tag].astro gathers its regions and the stories tagged with its name).
const regions = DESKS.map((d) => d.name).filter((name) => articles.some((a) => desksOf(a).some((x) => x.name === name) || a.data.tags.map(canonicalTag).includes(name)));
const href = (tag: string) => `/tags/${encodeURIComponent(tag)}/`;
---

<Base title="الملفات والمناطق" description="ملفات خازندار: القصص والشركات والمؤسسات التي نتابعها، والمناطق التي نغطيها" path="/tags/">
  <section class="wrap block">
    <header class="page-head">
      <h1 class="page-title">الملفات والمناطق</h1>
      <p class="page-intro">القصص والشركات والمؤسسات التي نتابعها هذه الأيام، والمناطق التي نغطيها.</p>
    </header>

    {leading.length > 0 && (
      <div class="files-index" style={`--n:${Math.min(3, leading.length)}`}>
        {leading.map((t) => (
          <article class="files-index__item">
            <h2 class="files-index__name"><a href={href(t.tag)}>{t.tag}</a></h2>
            <p class="files-index__count ui">
              آخر تحديث <time datetime={t.latest.data.publishedAt} data-relative>{timeAgo(t.latest.data.publishedAt)}</time>
            </p>
            {t.story && (
              <p class="files-index__latest">
                <a href={articleHref(t.story)} set:html={headline(t.story.data.title)} />
                <time class="ui" datetime={t.story.data.publishedAt}>{formatShortDate(t.story.data.publishedAt)}</time>
              </p>
            )}
          </article>
        ))}
      </div>
    )}
    {files.length === 0 && <p class="files-index__empty">لا ملفات بعد؛ يتكوّن الملف حين تتناول مادتان الموضوع نفسه.</p>}

    {running.length > 0 && (
      <section class="files-all" aria-labelledby="files-running-head">
        <h2 id="files-running-head" class="module__head">ملفات أخرى نتابعها</h2>
        <ul class="files-all__list">
          {running.map((t) => (
            <li>
              <a href={href(t.tag)}>{t.tag}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {largest.length > 0 && (
      <section class="files-all" aria-labelledby="files-largest-head">
        <h2 id="files-largest-head" class="module__head">ملفات كبرى</h2>
        <ul class="files-all__list">
          {largest.map((t) => (
            <li>
              <a href={href(t.tag)}>{t.tag}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {regions.length > 0 && (
      <section class="regions" aria-labelledby="regions-head">
        <h2 id="regions-head" class="module__head">بحسب المنطقة</h2>
        <ul class="regions__list">
          {regions.map((name) => (
            <li>
              <a href={href(name)}>{name}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </section>
</Base>

<style>
  .files-index { display: grid; grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr)); column-gap: var(--col-gap); }
  .files-index__item { padding-block: 0.9rem; border-top: 1px solid var(--rule); min-width: 0; }
  .files-index__name { font-family: var(--font-title); font-weight: 700; font-size: var(--t-section); line-height: 1.3; color: var(--green); }
  .files-index__name a { text-decoration: none; }
  .files-index__name a:hover { color: var(--green-deep); text-decoration: underline; }
  .files-index__count { font-size: var(--fs-xs); color: var(--ink-3); margin-top: 0.1rem; }
  .files-index__latest { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 0.75rem; align-items: baseline; margin-top: 0.5rem; font-family: var(--font-title); font-weight: 700; font-size: var(--t-list); line-height: 1.45; }
  .files-index__latest a { text-decoration: none; }
  .files-index__latest a:hover { color: var(--green); }
  .files-index__latest time { font-size: var(--fs-xs); color: var(--ink-3); white-space: nowrap; }
  .files-index__empty { font-family: var(--font-ui); color: var(--ink-3); }

  /* The lists: each file's name in the reading face's bold, as a section page lists its subjects, in ruled newspaper
     columns that balance themselves. */
  .files-all { margin-top: clamp(2.25rem, 4.5vw, 3.75rem); }
  .files-all__list { columns: 4 13rem; column-gap: var(--col-gap); column-rule: 1px solid var(--rule); }
  .files-all__list li { break-inside: avoid; padding-block: 0.28rem; }
  .files-all__list a { font-family: var(--font-body); font-weight: 700; font-size: var(--n-text); line-height: 1.5; color: var(--ink-2); text-decoration: none; }
  .files-all__list a:hover { color: var(--green); text-decoration: underline; }
  @media (pointer: coarse) {
    .files-all__list li { padding-block: 0; }
    .files-all__list a { display: inline-flex; align-items: center; min-height: var(--tap); }
  }

  /* Full width, so its head's rule runs as far as the files' rules above it (it stopped at 56rem). */
  .regions { margin-top: clamp(2.25rem, 4.5vw, 3.75rem); }
  .regions__list { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .regions__list li { font-family: var(--font-title); font-weight: 700; font-size: var(--t-list); }
  .regions__list a { text-decoration: none; }
  .regions__list a:hover { color: var(--green); }

  @media (max-width: 1023px) { .files-index { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 599px) { .files-index { grid-template-columns: 1fr; } }
  @media (pointer: coarse) {
    .regions__list { row-gap: 0; }
    .regions__list a { display: inline-flex; align-items: center; min-height: var(--tap); }
  }
</style>
